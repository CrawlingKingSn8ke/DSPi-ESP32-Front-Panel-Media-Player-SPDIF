void drawMenuDots(uint8_t count, uint8_t selected)
{
  if (count == 0) return;
  const int16_t spacing = 18;
  const int16_t y = 219;
  int16_t startX = (UI_W - (int16_t)(count - 1) * spacing) / 2;

  for (uint8_t i = 0; i < count; i++) {
    int16_t x = startX + i * spacing;
    if (i == selected) {
      canvas->fillCircle(x, y, 4, blend565(C_BLACK, uiAccent(), 72));
      canvas->fillCircle(x, y, 3, uiAccent());
    } else {
      canvas->fillCircle(x, y, 2, C_LINE);
    }
  }
}

void drawVerticalMenuDots(uint8_t count, uint8_t selected)
{
  if (count == 0) return;
  const int16_t spacing = 16;
  const int16_t x = 313;
  int16_t startY = (UI_H - (int16_t)(count - 1) * spacing) / 2;

  for (uint8_t i = 0; i < count; i++) {
    int16_t y = startY + i * spacing;
    if (i == selected) {
      canvas->fillCircle(x, y, 4, blend565(C_BLACK, uiAccent(), 72));
      canvas->fillCircle(x, y, 3, uiAccent());
