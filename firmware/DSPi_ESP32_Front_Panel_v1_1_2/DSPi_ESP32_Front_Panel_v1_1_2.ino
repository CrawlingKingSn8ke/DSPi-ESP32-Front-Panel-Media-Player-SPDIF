void serviceMediaUiAnimations()
{
  unsigned long now = millis();
  // The static Seeking... overlay is drawn before the decoder starts its exact
  // seek. Avoid all periodic LCD SPI transfers until the decoder has refilled
  // the PCM ring and released the shared SD/LCD bus again. Low-ring playback
  // also gets exclusive SD/decoder time until its safety reserve recovers.
  if (mediaPlayerPoc.seeking() || mediaTrackTransitionActive() ||
      mediaPlaybackBufferLow()) return;
  if (mediaVolumeOverlayVisible) {
    if ((long)(now - mediaVolumeOverlayUntil) >= 0) {
      dismissMediaVolumeOverlay(true);
    }
    return;
  }

  if (uiView == VIEW_MEDIA_NOW_PLAYING) {
    if (mediaPlayerPoc.active() &&
        (uint32_t)(now - mediaNowPlayingLastProgressAt) >= 750) {
      MediaFileInfo info = mediaPlayerPoc.playbackFile();
      MediaPlaybackStats stats = mediaPlayerPoc.playbackStats();
      canvas->fillRect(10, 179, UI_W - 20, 3, C_BLACK);
      canvas->drawFastHLine(10, 180, UI_W - 20, C_LINE);
      if (info.totalFrames > 0) {
        uint64_t played =
            std::min<uint64_t>(stats.outputFrames, info.totalFrames);
        int16_t progress = (int16_t)(
            (played * (UI_W - 20)) / info.totalFrames);
        canvas->drawFastHLine(10, 180, progress, uiAccent());
      }
      mediaNowPlayingLastProgressAt = now;
      flushCanvasRegionLocked(10, 179, UI_W - 20, 3);
    }
    return;
  }

  if (uiView != VIEW_MENU || menuPage != PAGE_MEDIA ||
      mediaMarqueeComplete) return;
  if ((uint32_t)(now - mediaMarqueeLastFrameAt) < MEDIA_MARQUEE_FRAME_MS) return;
  mediaMarqueeLastFrameAt = now;

  String title = mediaBrowserItemName(menuIndex);
  const int16_t tagWidth = fontTextWidth(FontSmall,
      mediaBrowserItemTag(menuIndex) == "FOLDER"
        ? String("DIR") : mediaBrowserItemTag(menuIndex));
  const int16_t textWidth = std::max<int16_t>(
      62, UI_W - tagWidth - 12 - 34 - 10);
  int16_t maximumOffset = std::max<int16_t>(
      0, fontTextWidth(FontMedium, title) - textWidth);
  if (maximumOffset == 0) {
    mediaMarqueeComplete = true;
    return;
  }

  uint32_t elapsed = now - mediaMarqueeStartedAt;
  uint32_t scrollDuration =
      (uint32_t)maximumOffset * 1000U / MEDIA_MARQUEE_PX_PER_SEC;
  int16_t nextOffset = 0;
  if (elapsed < MEDIA_MARQUEE_DELAY_MS) {
    return;
  } else if (elapsed < MEDIA_MARQUEE_DELAY_MS + scrollDuration) {
    nextOffset = (int16_t)(
        (uint32_t)(elapsed - MEDIA_MARQUEE_DELAY_MS) *
        MEDIA_MARQUEE_PX_PER_SEC / 1000U);
  } else if (elapsed < MEDIA_MARQUEE_DELAY_MS + scrollDuration +
                        MEDIA_MARQUEE_HOLD_MS) {
    nextOffset = maximumOffset;
  } else {
    nextOffset = 0;
    mediaMarqueeComplete = true;
  }

  nextOffset = std::min<int16_t>(nextOffset, maximumOffset);
  if (nextOffset == mediaMarqueeOffset && !mediaMarqueeComplete) return;
  mediaMarqueeOffset = nextOffset;
  if (menuIndex < mediaBrowserTopRow ||
      menuIndex >= mediaBrowserTopRow + MEDIA_UI_VISIBLE_ROWS) return;
  uint8_t visibleRow = menuIndex - mediaBrowserTopRow;
  drawMediaBrowserRow(menuIndex, visibleRow, true);
  flushCanvasRegionLocked(4, 59 + visibleRow * 32, UI_W - 5, 31);
}

void drawPresetList()
{
  static constexpr uint8_t VISIBLE_ROWS = 4;
  static constexpr int16_t ROW_Y = 48;
  static constexpr int16_t ROW_HEIGHT = 34;

  uiView = VIEW_MENU;
  drawBase();
  drawFontCentredGlow(FontMedium, 2, "Presets");
  drawTaperLine(UI_W / 2, 42, 286, 1, uiAccentDark());

  menuIndex = std::min<uint8_t>(menuIndex, 9);
  if (menuIndex < presetListTopRow) presetListTopRow = menuIndex;
  if (menuIndex >= presetListTopRow + VISIBLE_ROWS) {
    presetListTopRow = menuIndex - VISIBLE_ROWS + 1;
  }
  presetListTopRow = std::min<uint8_t>(presetListTopRow, 10 - VISIBLE_ROWS);

  for (uint8_t row = 0; row < VISIBLE_ROWS; row++) {
    const uint8_t slot = presetListTopRow + row;
    const int16_t y = ROW_Y + row * ROW_HEIGHT;
    const bool selected = slot == menuIndex;
    canvas->fillRect(4, y, UI_W - 8, ROW_HEIGHT - 1, C_BLACK);
    if (selected) canvas->fillRect(4, y, 3, ROW_HEIGHT - 1, uiMainText());

    String label = ellipsizeFontText(FontMedium, presetListLabel(slot), UI_W - 35);
    const uint16_t colour = isPresetOccupied(slot) ? uiMainText() : uiDimText();
    drawFontText(FontMedium, 13, y + 3, label, colour);
    if (slot == dspi.activePreset) {
      canvas->fillCircle(UI_W - 10, y + 16, 3, uiAccent());
    }
  }

  if (toastText.length() && (long)(toastUntil - millis()) > 0) {
    drawFontCentredGlowColour(FontSmall, 197, toastText, uiAccent());
  } else {
    drawFontCentredGlowColour(FontSmall, 188,
                              "Hold OK button to save", uiAccent());
    drawFontCentredGlowColour(FontSmall, 211,
                              "current preset", uiAccent());
  }
  flushCanvasLocked();
}

bool isSystemSettingsListPage(MenuPage page)
{
  return page == PAGE_SYSTEM || page == PAGE_SCREEN_SETTINGS ||
         page == PAGE_IDLE_SCREEN || page == PAGE_THEME;
}

uint8_t themePaletteIndexForRow(uint8_t row)
{
  if (row == 0) return mainTextPaletteIndex;
  if (row == 1) return accentPaletteIndex;
  return volumeMeterPaletteIndex;
}

void drawSystemSettingsList()
{
  static constexpr int16_t ROW_Y = 52;
  static constexpr int16_t ROW_HEIGHT = 36;

  uiView = VIEW_MENU;
  drawBase();
  drawFontCentredGlow(FontMedium, 2, pageTitle(menuPage));
  drawTaperLine(UI_W / 2, 44, 286, 1, uiAccentDark());

  const uint8_t count = menuItemCount(menuPage);
  menuIndex = count ? std::min<uint8_t>(menuIndex, count - 1) : 0;
  for (uint8_t row = 0; row < count; row++) {
    const int16_t y = ROW_Y + row * ROW_HEIGHT;
    const bool selected = row == menuIndex;
    canvas->fillRect(4, y, UI_W - 8, ROW_HEIGHT - 1, C_BLACK);
    if (selected) canvas->fillRect(4, y, 3, ROW_HEIGHT - 1, uiMainText());

    String value = menuItemValue(menuPage, row);
    const bool paletteSwatch = menuPage == PAGE_THEME && row < 3;
    const int16_t valueWidth = paletteSwatch ? 28 : (value.length()
        ? std::min<int16_t>(105, fontTextWidth(FontSmall, value)) : 0);
    const int16_t labelWidth = UI_W - 30 - valueWidth;
    String label = ellipsizeFontText(
        FontMedium, menuItemName(menuPage, row), labelWidth);
    drawFontText(FontMedium, 13, y + 4, label, uiMainText());
    if (value.length()) {
      value = ellipsizeFontText(FontSmall, value, 105);
      drawFontRight(FontSmall, UI_W - 13, y + 8, value, uiAccent());
    }
    if (paletteSwatch) {
      const uint16_t swatch = themePaletteColour(themePaletteIndexForRow(row));
      canvas->fillCircle(UI_W - 17, y + 17, 9, swatch);
      canvas->drawCircle(UI_W - 17, y + 17, 10, uiDimText());
    }

    if (menuPage == PAGE_IDLE_SCREEN && row < 4 &&
        row == (uint8_t)screenTimeoutAction) {
      canvas->fillCircle(UI_W - 10, y + 17, 3, uiAccent());
    }
  }

  if (toastText.length() && (long)(toastUntil - millis()) > 0) {
    canvas->fillRect(12, 213, UI_W - 24, 24, C_BLACK);
    drawFontCentredGlowColour(FontSmall, 214, toastText, uiAccent());
  }
  flushCanvasLocked();
}

void drawMenu()
{
  if (menuPage == PAGE_MEDIA && !editActive) {
    drawMediaBrowser();
    return;
  }
  if (menuPage == PAGE_PRESET && !editActive) {
    drawPresetList();
    return;
  }
  if (isSystemSettingsListPage(menuPage) && !editActive) {
    drawSystemSettingsList();
    return;
  }
  mediaBrowserRedrawPending = false;
  mediaBrowserFullRedrawPending = false;

  uiView = editActive ? VIEW_EDIT : VIEW_MENU;
  drawBase();

  // Menu and every submenu use the same clean page-heading size.
  drawFontCentredGlow(FontMedium, 8, pageTitle(menuPage));
  drawTaperLine(UI_W / 2, 44, 210, 1, uiAccentDark());

  if (menuPage == PAGE_MAIN) {
    // Top-level categories are a horizontal carousel. The selected category
    // retains the accepted native 62 px font; adjacent categories provide a
    // restrained visual cue that Left/Right or encoder rotation move across.
    String selected = menuItemName(menuPage, menuIndex);
    drawMenuTextNative(80, selected, uiMainText());
    uint8_t count = menuItemCount(PAGE_MAIN);
    uint8_t previous = (uint8_t)((menuIndex + count - 1) % count);
    uint8_t next = (uint8_t)((menuIndex + 1) % count);
    drawFontText(FontSmall, 18, 174, menuItemName(PAGE_MAIN, previous), uiDimText());
    drawFontRight(FontSmall, 302, 174, menuItemName(PAGE_MAIN, next), uiDimText());
  } else {
    drawMenuOptionCentredGlow(53, menuItemName(menuPage, menuIndex));

    if (menuPage == PAGE_SYSTEM && menuIndex == 0) {
      String summary = dspi.connected ? "DSPi ready" : "Communication fault";
      uint16_t colour = dspi.connected ? uiAccent() : uiFault();
      drawFontCentredGlowColour(FontMedium, 112, summary, colour);
    } else if (menuPage == PAGE_BLUETOOTH &&
               bleMenuActionForIndex(menuIndex) == BLE_MENU_DEVICE) {
      String name = bleProfileValid ? String(bleSavedName) : "None";
      uint16_t colour = bleConnected ? uiAccent() :
          (bleProfileValid ? uiMainText() : uiDimText());
      int16_t width = fontTextWidth(FontLarge, name);
      if (width <= UI_W - 24) drawFontCentredGlowColour(FontLarge, 88, name, colour);
      else drawFontCentredGlowColour(FontMedium, 115, name, colour);
    } else {
      drawMenuValue(88, menuItemValue(menuPage, menuIndex));
      if (menuPage == PAGE_SYSTEM && menuIndex == 2) {
        drawFontCentredGlowColour(FontSmall, 190, "Global ceiling", uiAccentSoft());
      }
    }
  }

  if (menuPage == PAGE_MAIN) drawMenuDots(menuItemCount(menuPage), menuIndex);
  else if (menuItemCount(menuPage) > 1) drawVerticalMenuDots(menuItemCount(menuPage), menuIndex);

  if (menuPage == PAGE_INPUT && toastText.length() &&
      (long)(toastUntil - millis()) > 0) {
    canvas->fillRect(20, 185, UI_W - 40, 23, C_BLACK);
    drawFontCentred(FontSmall, 186, toastText, uiAccentSoft());
  }
  flushCanvasLocked();
}

void drawStatusScreen()
{
  uiView = VIEW_STATUS;
  drawBase();
  drawFontCentredGlow(FontMedium, 8, "Status");
  drawTaperLine(UI_W / 2, 44, 220, 1, uiAccentDark());

  String primary = dspi.connected ? "DSPi ready" : "Communication fault";
  uint16_t primaryColour = dspi.connected ? uiAccent() : uiFault();

  drawFontCentredGlowColour(FontMedium, 55, primary, primaryColour);
  String firmwareLine = "DSPi FW unavailable";
  if (dspi.connected) {
    String pico = dspi.platform == 0 ? "RP2040" : "RP2350";
    String firmware = "DSPi FW " + String((int)dspi.firmwareMajor) + "." +
                      String((dspi.firmwareMinorPatchBcd >> 4) & 0x0F) + "." +
                      String(dspi.firmwareMinorPatchBcd & 0x0F);
    if (dspi.firmwareMajor == 1 && dspi.firmwareMinorPatchBcd == 0x16) {
      firmware += " beta";
    }
    firmwareLine = pico + "  " + firmware;
  }
  drawFontCentredGlowColour(FontSmall, 96, firmwareLine,
                            dspi.connected ? uiMainText() : uiDimText());
  drawFontCentredGlowColour(FontSmall, 128,
                            dspi.connected ? "UART linked at 115200" : "UART offline",
                            dspi.connected ? uiAccent() : uiFault());
  String remote = bleConnected ? "Remote connected" :
                  (bleProfileValid ? "Remote configured" : "No remote saved");
  drawFontCentredGlowColour(FontSmall, 158, remote,
                            bleConnected ? uiAccent() : uiDimText());
  drawFontCentredGlow(FontSmall, 184, "Panel v1.2.0");
  if (mediaPlayerPoc.mounted()) {
    drawFontCentredGlowColour(FontSmall, 210, "SD card mounted", uiAccent());
  }

  flushCanvasLocked();
}

void transitionToStatusScreen()
{
  fadeUiOut();
  drawStatusScreen();
  fadeUiIn();
}

void transitionToBleScreen()
{
  fadeUiOut();
  drawBleScreen();
  fadeUiIn();
}

void redrawCurrentView()
{
  if (mediaVolumeOverlayVisible) drawMediaVolumeOverlay(false);
  else if (uiView == VIEW_HOME) drawHome();
  else if (uiView == VIEW_STATUS) drawStatusScreen();
  else if (uiView == VIEW_BLE) drawBleScreen();
  else if (uiView == VIEW_MEDIA_NOW_PLAYING) drawMediaNowPlaying();
  else if (uiView == VIEW_VISUALIZER) drawVisualizer();
  else if (uiView == VIEW_FEATURE_CONFIRM) drawFeatureConfirmation();
  else if (uiView == VIEW_PRESET_SAVE_CONFIRM) drawPresetSaveConfirmation();
  else if (uiView == VIEW_CHANGE_OVERLAY) drawChangeOverlay();
  else if (uiView == VIEW_WIFI_TRANSFER_CONFIRM) {
    drawWifiTransferConfirmation();
  } else if (uiView == VIEW_WIFI_TRANSFER_ACTIVE) {
    drawWifiTransferScreen();
  } else if (uiView == VIEW_WIFI_TRANSFER_ERROR) {
    drawWifiTransferError();
  }
  else drawMenu();
}

void dismissFeatureConfirmation()
{
  if (uiView != VIEW_FEATURE_CONFIRM) return;
  UiView returnView = featureConfirmReturnView;
  featureConfirmUntil = 0;
  featureConfirmName = "";
  uiView = returnView;
  redrawCurrentView();
}

// -----------------------------------------------------------------------------
// Menu operation and user actions
// -----------------------------------------------------------------------------

int8_t mainIndexForPage(MenuPage page)
{
  switch (page) {
    case PAGE_INPUT: return 0;
    case PAGE_MEDIA: return 1;
    case PAGE_PRESET: return 2;
    case PAGE_LOUDNESS: return 3;
    case PAGE_CROSSFEED: return 4;
    case PAGE_LEVELLER: return 5;
    case PAGE_PSYBASS: return 6;
    case PAGE_BLUETOOTH: return 7;
    case PAGE_SYSTEM: return 8;
    default: return -1;
  }
}

MenuPage pageForMainIndex(uint8_t index)
{
  const MenuPage pages[] = {
    PAGE_INPUT, PAGE_MEDIA, PAGE_PRESET, PAGE_LOUDNESS, PAGE_CROSSFEED,
    PAGE_LEVELLER, PAGE_PSYBASS, PAGE_BLUETOOTH, PAGE_SYSTEM
  };
  return pages[std::min<uint8_t>(index, 8)];
}

void enterPage(MenuPage page)
{
  encoderMenuDetentRemainder = 0;
  fadeUiOut();
  // Preset names are Console-owned metadata. Refresh them on demand so a
  // rename made on the PC appears without requiring a front-panel reboot.
  if (dspi.connected && (page == PAGE_PRESET || page == PAGE_INPUT)) {
    syncCurrentState(page == PAGE_PRESET);
  }

  MenuPage previousPage = menuPage;
  if (previousPage == PAGE_MAIN) {
    lastMainMenuIndex = std::min<uint8_t>(menuIndex, menuItemCount(PAGE_MAIN) - 1);
  } else {
    rememberedMenuIndex[previousPage] =
      std::min<uint8_t>(menuIndex, menuItemCount(previousPage) - 1);
  }

  if (page == PAGE_MEDIA && !mediaBrowserScanned) {
    refreshMediaBrowser(true);
  }

  if (page == PAGE_MAIN) {
    int8_t previousCategory = mainIndexForPage(previousPage);
    if (previousCategory >= 0) lastMainMenuIndex = (uint8_t)previousCategory;
    menuIndex = std::min<uint8_t>(lastMainMenuIndex, menuItemCount(PAGE_MAIN) - 1);
  } else {
    menuIndex = std::min<uint8_t>(rememberedMenuIndex[page], menuItemCount(page) - 1);
  }
  menuPage = page;
  editActive = false;
  if (page == PAGE_MEDIA && mediaPlayerPoc.active()) {
    uiView = VIEW_MEDIA_NOW_PLAYING;
    drawMediaNowPlaying();
    fadeUiIn();
    return;
  }
  if (page == PAGE_BLUETOOTH && (bleRemovalInProgress || bleStackRestartPending)) {
    bleUiMode = BLE_UI_MESSAGE;
    bleMessage = bleRemovalInProgress ? "Removing remote" : "BLE restarting";
    bleMessageUntil = 0;
    bleAnimationStep = 0;
    bleLastAnimationAt = millis();
    drawBleScreen();
    fadeUiIn();
    return;
  }
  if (page == PAGE_PRESET) {
    menuIndex = std::min<uint8_t>(dspi.activePreset, 9);
    presetListTopRow = menuIndex > 1 ? menuIndex - 1 : 0;
    presetListTopRow = std::min<uint8_t>(presetListTopRow, 6);
    rememberedMenuIndex[PAGE_PRESET] = menuIndex;
  }
  if (page == PAGE_IDLE_SCREEN && previousPage != PAGE_IDLE_SCREEN) {
    menuIndex = (uint8_t)screenTimeoutAction;
    rememberedMenuIndex[PAGE_IDLE_SCREEN] = menuIndex;
  }
  drawMenu();
  fadeUiIn();
}

void cancelActiveEdit()
{
  if (!editActive) return;
  if (menuPage == PAGE_SCREEN_SETTINGS && menuIndex == 0) {
    brightnessPercent = (uint8_t)editOriginalInt;
    applyBrightness();
  }
  // Volume Limit is edited locally and applied once on Select. There is no
  // live DSP value to restore on Back.
  editActive = false;
}

void goBack()
{
  if (uiView == VIEW_MEDIA_NOW_PLAYING) {
    restoreMediaBrowserToQueueTrack();
    uiView = VIEW_MENU;
    menuPage = PAGE_MEDIA;
    drawMenu();
    return;
  }
  if (uiView == VIEW_VISUALIZER) {
    transitionToHome();
    return;
  }
  if (uiView == VIEW_BLE) {
    bleBack();
    return;
  }
  if (uiView == VIEW_STATUS) {
    enterPage(PAGE_SYSTEM);
    return;
  }
  if (uiView == VIEW_PRESET_SAVE_CONFIRM) {
    enterPage(PAGE_PRESET);
    return;
  }
  if (uiView == VIEW_CHANGE_OVERLAY) {
    dismissChangeOverlay();
    return;
  }
  if (editActive) {
    cancelActiveEdit();
    drawMenu();
    return;
  }
  if (menuPage == PAGE_MEDIA_SETTINGS) {
    rememberedMenuIndex[PAGE_MEDIA_SETTINGS] = menuIndex;
    menuPage = PAGE_MEDIA;
    menuIndex = std::min<uint8_t>(
        rememberedMenuIndex[PAGE_MEDIA], mediaBrowserItemCount() - 1);
    uiView = VIEW_MENU;
    drawMenu();
    return;
  }
  if (menuPage == PAGE_THEME || menuPage == PAGE_IDLE_SCREEN) {
    enterPage(PAGE_SCREEN_SETTINGS);
    return;
  }
  if (menuPage != PAGE_MAIN) {
    if (menuPage == PAGE_MEDIA && leaveMediaFolder()) {
      return;
    }
    if (menuPage == PAGE_SCREEN_SETTINGS) {
      enterPage(PAGE_SYSTEM);
      return;
    }
    enterPage(PAGE_MAIN);
    return;
  }
  transitionToHome();
}

void beginEdit()
{
  editActive = true;
  if (menuPage == PAGE_INPUT) {
    editInt = (int)displayedPhysicalInputSource();
  } else if (menuPage == PAGE_LOUDNESS) {
    if (menuIndex == 0) editBool = dspi.loudnessEnabled;
    else if (menuIndex == 1) editFloat = dspi.loudnessReferenceSpl;
    else editFloat = dspi.loudnessIntensity;
  } else if (menuPage == PAGE_CROSSFEED) {
    if (menuIndex == 0) editBool = dspi.crossfeedEnabled;
    else if (menuIndex == 1) editInt = dspi.crossfeedPreset;
    else if (menuIndex == 2) editFloat = dspi.crossfeedFrequencyHz;
    else editFloat = dspi.crossfeedFeedDb;
  } else if (menuPage == PAGE_LEVELLER) {
    if (menuIndex == 0) editBool = dspi.levellerEnabled;
    else if (menuIndex == 1) editFloat = dspi.levellerAmount;
    else if (menuIndex == 2) editInt = dspi.levellerSpeed;
    else if (menuIndex == 3) editFloat = dspi.levellerMaxGainDb;
    else if (menuIndex == 4) editFloat = dspi.levellerGateDb;
    else editBool = dspi.levellerLookahead;
  } else if (menuPage == PAGE_PSYBASS) {
    if (menuIndex == 0) editBool = dspi.psybassEnabled;
    else if (menuIndex == 1) editFloat = dspi.psybassCutoffHz;
    else if (menuIndex == 2) editFloat = dspi.psybassHarmonicsDb;
    else if (menuIndex == 3) editFloat = dspi.psybassDriveDb;
    else if (menuIndex == 4) editFloat = dspi.psybassCharacterPct;
    else editFloat = dspi.psybassOriginalDb;
  } else if (menuPage == PAGE_SYSTEM && menuIndex == 2) {
    editFloat = dspi.masterVolumeDb;
  } else if (menuPage == PAGE_MEDIA_SETTINGS) {
    editInt = mediaSeekStepIndex;
  } else if (menuPage == PAGE_SCREEN_SETTINGS) {
    if (menuIndex == 0) editInt = brightnessPercent;
    else editInt = screenTimeoutOption;
  } else if (menuPage == PAGE_IDLE_SCREEN) {
    editInt = screenDimPercent;
  } else if (menuPage == PAGE_THEME) {
    if (menuIndex == 0) editInt = mainTextPaletteIndex;
    else if (menuIndex == 1) editInt = accentPaletteIndex;
    else if (menuIndex == 2) editInt = volumeMeterPaletteIndex;
    else editInt = analogVuColourChoice;
  }
  encoderMenuDetentRemainder = 0;
  editOriginalFloat = editFloat;
  editOriginalInt = editInt;
  editOriginalBool = editBool;
  drawMenu();
}

uint8_t nextAvailablePreset(uint8_t current, int direction)
{
  if (firstOccupiedPreset() < 0) return current;

  for (uint8_t step = 0; step < 10; step++) {
    current = (uint8_t)((current + direction + 10) % 10);
    if (isPresetOccupied(current)) return current;
  }
  return current;
}

float wrapEditFloat(float current, int direction, float step, float minimum, float maximum)
{
  const float epsilon = step * 0.25f;
  if (direction > 0 && current >= maximum - epsilon) return minimum;
  if (direction < 0 && current <= minimum + epsilon) return maximum;
  return constrain(current + (direction > 0 ? step : -step), minimum, maximum);
}

int wrapEditInt(int current, int direction, int step, int minimum, int maximum)
{
  if (direction > 0 && current >= maximum) return minimum;
  if (direction < 0 && current <= minimum) return maximum;
  return constrain(current + (direction > 0 ? step : -step), minimum, maximum);
}

void adjustEdit(int direction)
{
  if (!editActive) return;
  if (menuPage == PAGE_INPUT) {
    editInt = (int)nextInputSourceChoice((InputSource)editInt, direction);
  } else if (menuPage == PAGE_LOUDNESS) {
    if (menuIndex == 0) editBool = !editBool;
    else if (menuIndex == 1) editFloat = wrapEditFloat(editFloat, direction, 1.0f, 40.0f, 100.0f);
    else editFloat = wrapEditFloat(editFloat, direction, 5.0f, 0.0f, 200.0f);
  } else if (menuPage == PAGE_CROSSFEED) {
    if (menuIndex == 0) editBool = !editBool;
    else if (menuIndex == 1) editInt = (editInt + direction + 4) % 4;
    else if (menuIndex == 2) editFloat = wrapEditFloat(editFloat, direction, 50.0f, 500.0f, 2000.0f);
    else editFloat = wrapEditFloat(editFloat, direction, 0.5f, 0.0f, 15.0f);
  } else if (menuPage == PAGE_LEVELLER) {
    if (menuIndex == 0 || menuIndex == 5) editBool = !editBool;
    else if (menuIndex == 1) editFloat = wrapEditFloat(editFloat, direction, 5.0f, 0.0f, 100.0f);
    else if (menuIndex == 2) editInt = (editInt + direction + 3) % 3;
    else if (menuIndex == 3) editFloat = wrapEditFloat(editFloat, direction, 0.5f, 0.0f, 35.0f);
    else editFloat = wrapEditFloat(editFloat, direction, 1.0f, -96.0f, 0.0f);
  } else if (menuPage == PAGE_PSYBASS) {
    if (menuIndex == 0) editBool = !editBool;
    else if (menuIndex == 1) editFloat = wrapEditFloat(editFloat, direction, 5.0f, 30.0f, 300.0f);
    else if (menuIndex == 2) editFloat = wrapEditFloat(editFloat, direction, 0.5f, -24.0f, 12.0f);
    else if (menuIndex == 3) editFloat = wrapEditFloat(editFloat, direction, 0.5f, 0.0f, 18.0f);
    else if (menuIndex == 4) editFloat = wrapEditFloat(editFloat, direction, 5.0f, 0.0f, 100.0f);
    else editFloat = wrapEditFloat(editFloat, direction, 1.0f, -60.0f, 0.0f);
  } else if (menuPage == PAGE_SYSTEM && menuIndex == 2) {
    // Keep editing local. Sending a DSP command on every encoder detent makes
    // the control plane compete with active I2S playback and provides no extra
    // safety. The value is committed once, inside a muted transaction.
    editFloat = constrain(
        roundf((editFloat + direction * 0.5f) * 2.0f) / 2.0f,
        -60.0f, 0.0f);
  } else if (menuPage == PAGE_MEDIA_SETTINGS) {
    editInt = (editInt + direction + 3) % 3;
  } else if (menuPage == PAGE_SCREEN_SETTINGS) {
    if (menuIndex == 0) {
      editInt = wrapEditInt(editInt, direction, 10, 10, 100);
      brightnessPercent = editInt;
      applyBrightness();
    } else if (menuIndex == 1) {
      editInt = wrapEditInt(editInt, direction, 1, 0, 4);
    }
  } else if (menuPage == PAGE_IDLE_SCREEN) {
    editInt = wrapEditInt(editInt, direction, 10, 10, 80);
  } else if (menuPage == PAGE_THEME) {
    if (menuIndex == 1) {
      editInt = wrapEditInt(editInt, direction, 1,
                            ACCENT_PALETTE_FIRST,
                            THEME_PALETTE_COUNT - 1);
    } else if (menuIndex < 3) {
      editInt = wrapEditInt(editInt, direction, 1, 0,
                            THEME_PALETTE_COUNT - 1);
    } else {
      editInt = wrapEditInt(editInt, direction, 1, 0,
                            VU_COLOUR_CHOICE_COUNT - 1);
    }
  }
  drawMenu();
}

void applyEdit()
{
  if (!editActive) return;

  if (menuPage == PAGE_INPUT &&
      !inputSourceAvailable((InputSource)editInt)) {
    showToast("Enable in Console");
    drawMenu();
    return;
  }

  bool ok = true;
  String successText = "Applied";
  String failureText = "DSPi error";
  if (menuPage == PAGE_INPUT) {
    InputSource selectedSource = (InputSource)editInt;
    // Any genuine input change takes ownership from the ESP S/PDIF player.
    // Clear even a parked/paused queue so a later Play cannot unexpectedly
    // reclaim S/PDIF after the listener deliberately selected another input.
    const bool mediaSessionPresent = mediaPlayerPoc.active() ||
        mediaPlaybackSuspended || mediaCurrentPath[0] ||
        mediaTrackTransitionActive();
    if (mediaSessionPresent && selectedSource != dspi.source) {
      stopMediaPlayback("input menu");
    }
    if (mediaRouteRestorePending && mediaRoute.captured &&
        selectedSource == mediaRoute.source) {
      // Applying the saved physical I2S source also means restoring its saved
      // rate and clock mode; source equality alone is not sufficient.
      ok = restoreDspiMediaRoute();
    } else {
      ok = selectedSource == dspi.source ||
           (dspi.connected && setInputSource(selectedSource, true));
      if (ok) discardPendingMediaRouteRestore("input menu");
    }
  } else if (menuPage == PAGE_LOUDNESS) {
    if (menuIndex == 0) ok = setLoudness(editBool);
    else if (menuIndex == 1) ok = setLoudnessReference(editFloat);
    else ok = setLoudnessIntensity(editFloat);
  } else if (menuPage == PAGE_CROSSFEED) {
    if (menuIndex == 0) ok = setCrossfeed(editBool);
    else if (menuIndex == 1) ok = setCrossfeedPreset((uint8_t)editInt);
    else if (menuIndex == 2) ok = setCrossfeedFrequency(editFloat);
    else ok = setCrossfeedFeed(editFloat);
  } else if (menuPage == PAGE_LEVELLER) {
    if (menuIndex == 0) ok = setLeveller(editBool);
    else if (menuIndex == 1) ok = setLevellerAmount(editFloat);
    else if (menuIndex == 2) ok = setLevellerSpeed((uint8_t)editInt);
    else if (menuIndex == 3) ok = setLevellerMaxGain(editFloat);
    else if (menuIndex == 4) ok = setLevellerGate(editFloat);
    else ok = setLevellerLookahead(editBool);
  } else if (menuPage == PAGE_PSYBASS) {
    if (menuIndex == 0) ok = setPsybassEnabled(editBool);
    else if (menuIndex == 1) ok = setPsybassCutoff(editFloat);
    else if (menuIndex == 2) ok = setPsybassHarmonics(editFloat);
    else if (menuIndex == 3) ok = setPsybassDrive(editFloat);
    else if (menuIndex == 4) ok = setPsybassCharacter(editFloat);
    else ok = setPsybassOriginal(editFloat);
  } else if (menuPage == PAGE_SYSTEM && menuIndex == 2) {
    const bool originalMute = dspi.muted;
    const float originalMaster = dspi.masterVolumeDb;
    const bool mediaSessionPresent = mediaPlayerPoc.active() ||
        mediaPlaybackSuspended || mediaCurrentPath[0] ||
        mediaTrackTransitionActive();
    bool limitPersisted = false;

    // DSPi persists the independent ceiling in flash. Use the same proven
    // boundary as preset saving: completely stop the transmitter, restore the
    // prior physical route, and verify cleanup before starting the flash
    // transaction. A quiescent-but-live S/PDIF task can otherwise outlive an
    // ambiguous DSPi blackout and remain held until a power cycle.
    if (mediaSessionPresent) {
      stopMediaPlayback("volume limit flash guard");
    }
    const bool mediaStopped = !mediaPlayerPoc.active() &&
        !mediaTrackTransitionActive() && !mediaRouteRestorePending;

    if (!mediaStopped) {
      ok = false;
      failureText = "Music stop failed";
      Serial.println(
          "VOLUME LIMIT TX: refused; Media stop/route cleanup incomplete");
    } else {
      const bool muted = setUserMuteVerified(true);
      const bool independent = muted && ensureIndependentMasterVolumeModeVerified();
      const bool limitSet = independent && setMasterVolumeVerified(editFloat);
      limitPersisted = limitSet && persistIndependentMasterVolumeVerified();
      ok = limitPersisted;

      if (ok) {
        const bool muteRestored = setUserMuteVerified(originalMute);
        if (!muteRestored) {
          // The new limit is durable, but the former mute state could not be
          // proven. Keep DSPi in an explicitly verified safe-muted state; the
          // Media task is already fully stopped and can be started normally.
          const bool safeMute = setUserMuteVerified(true);
          ok = false;
          failureText = safeMute ? "Limit saved - muted"
                                 : "Limit saved - mute error";
        }
      } else {
        // Do not leave a partially changed live limit. Restore the original
        // ceiling where possible and independently verify a safe mute. There
        // is no retained ESP hold, so a later playback attempt cannot inherit
        // a latched output-task state from this failure path.
        const bool masterRestored = setMasterVolumeVerified(originalMaster);
        const bool safeMute = setUserMuteVerified(true);
        Serial.printf("VOLUME LIMIT TX: recovery persisted=%s "
                      "master_restore=%s mute_guard=%s\n",
                      limitPersisted ? "yes" : "no",
                      masterRestored ? "OK" : "FAILED",
                      safeMute ? "OK" : "FAILED");
        failureText = masterRestored && safeMute
            ? "Limit failed - muted" : "Limit recovery error";
      }
    }
    successText = mediaSessionPresent ? "Limit saved - music stopped"
                                      : "Global limit saved";
  } else if (menuPage == PAGE_MEDIA_SETTINGS) {
    mediaSeekStepIndex = (uint8_t)constrain(editInt, 0, 2);
    markDeferredPreference(PREF_DIRTY_PANEL_SETTINGS);
    successText = "Applied";
  } else if (menuPage == PAGE_SCREEN_SETTINGS) {
    if (menuIndex == 0) {
      brightnessPercent = (uint8_t)editInt;
      applyBrightness();
    } else if (menuIndex == 1) {
      screenTimeoutOption = (uint8_t)editInt;
    }
    markDeferredPreference(PREF_DIRTY_PANEL_SETTINGS);
    recordUserActivity();
    successText = "Applied";
  } else if (menuPage == PAGE_IDLE_SCREEN) {
    screenDimPercent = (uint8_t)editInt;
    markDeferredPreference(PREF_DIRTY_PANEL_SETTINGS);
    recordUserActivity();
    successText = "Applied";
  } else if (menuPage == PAGE_THEME) {
    if (menuIndex == 0) {
      mainTextPaletteIndex = (uint8_t)constrain(
          editInt, 0, THEME_PALETTE_COUNT - 1);
    } else if (menuIndex == 1) {
      accentPaletteIndex = (uint8_t)constrain(
          editInt, ACCENT_PALETTE_FIRST, THEME_PALETTE_COUNT - 1);
    } else if (menuIndex == 2) {
      volumeMeterPaletteIndex = (uint8_t)constrain(
          editInt, 0, THEME_PALETTE_COUNT - 1);
    } else {
      analogVuColourChoice = (VuColourChoice)constrain(
          editInt, 0, VU_COLOUR_CHOICE_COUNT - 1);
      prepareAnalogVuFaceCache();
    }
    if (!persistThemePreferencesNow()) {
      markDeferredPreference(PREF_DIRTY_PANEL_SETTINGS);
    }
    recordUserActivity();
    successText = "Theme saved";
  }

  editActive = false;
  showToast(ok ? successText : failureText);
  drawMenu();
}

void moveMenu(int direction)
{
  if (direction == 0) return;

  if (menuPage == PAGE_PRESET && !editActive) {
    menuIndex = (uint8_t)constrain((int)menuIndex + direction, 0, 9);
    rememberedMenuIndex[PAGE_PRESET] = menuIndex;
    drawMenu();
    return;
  }

  if (isSystemSettingsListPage(menuPage) && !editActive) {
    const int count = menuItemCount(menuPage);
    menuIndex = (uint8_t)constrain((int)menuIndex + direction, 0, count - 1);
    rememberedMenuIndex[menuPage] = menuIndex;
    drawMenu();
    return;
  }

  if (menuPage == PAGE_MEDIA && !editActive) {
    const uint32_t previousPageFirst = mediaBrowserFirstEntryIndex;
    int step = direction > 0 ? 1 : -1;
    int remaining = abs(direction);
    while (remaining-- > 0) {
      uint8_t count = mediaBrowserItemCount();
      if (step > 0) {
        if ((uint8_t)(menuIndex + 1) < count) {
          menuIndex++;
        } else if (mediaPlayerPoc.active() &&
                   !mediaBrowserRedrawSafeForPlayback()) {
          // Do not begin a directory-page scan while the decoder is rebuilding
          // its reserve.  The next held-button repeat retries this boundary.
          break;
        } else if (!loadNextMediaBrowserPage()) {
          // Large media folders must stop at the final entry. Wrapping to the
          // beginning makes accelerated hold navigation frustrating and can
          // lose the user's place after traversing hundreds of folders.
          menuIndex = count ? count - 1 : 0;
          break;
        }
      } else {
        if (menuIndex > 0) {
          menuIndex--;
        } else if (mediaPlayerPoc.active() &&
                   !mediaBrowserRedrawSafeForPlayback()) {
          break;
        } else if (!loadPreviousMediaBrowserPage()) {
          menuIndex = 0;
          break;
        }
      }
    }
    rememberedMenuIndex[menuPage] = menuIndex;
    requestMediaBrowserNavigationRedraw(
        mediaBrowserFirstEntryIndex != previousPageFirst);
    return;
  }

  int count = menuItemCount(menuPage);
  int next = ((int)menuIndex + direction) % count;
  if (next < 0) next += count;
  menuIndex = (uint8_t)next;
  if (menuPage == PAGE_MAIN) lastMainMenuIndex = menuIndex;
  else rememberedMenuIndex[menuPage] = menuIndex;
  drawMenu();
}

void selectMenuItem()
{
  if (editActive) {
    applyEdit();
    return;
  }

  if (menuPage == PAGE_MAIN) {
    enterPage(pageForMainIndex(menuIndex));
    return;
  }

  if (menuPage == PAGE_SYSTEM && menuIndex == 0) {
    transitionToStatusScreen();
    return;
  }

  if (menuPage == PAGE_SYSTEM && menuIndex == 1) {
    enterPage(PAGE_SCREEN_SETTINGS);
    return;
  }

  if (menuPage == PAGE_SCREEN_SETTINGS) {
    if (menuIndex == 2) {
      enterPage(PAGE_IDLE_SCREEN);
      return;
    }
    if (menuIndex == 3) {
      enterPage(PAGE_THEME);
      return;
    }
  }

  if (menuPage == PAGE_IDLE_SCREEN && menuIndex < 4) {
    screenTimeoutAction = (ScreenTimeoutAction)menuIndex;
    markDeferredPreference(PREF_DIRTY_PANEL_SETTINGS);
    recordUserActivity();
    rememberedMenuIndex[PAGE_IDLE_SCREEN] = menuIndex;
    drawMenu();
    return;
  }

  if (menuPage == PAGE_MEDIA) {
    selectMediaMenuItem();
    return;
  }

  if (menuPage == PAGE_BLUETOOTH) {
    switch (bleMenuActionForIndex(menuIndex)) {
      case BLE_MENU_DEVICE:
        if (!bleProfileValid) {
          showToast("No remote saved");
          drawMenu();
        } else {
          bleUiMode = BLE_UI_MESSAGE;
          bleMessage = bleConnected ? "Connected" : "Reconnecting";
          bleMessageUntil = millis() + 1800;
          transitionToBleScreen();
        }
        break;
      case BLE_MENU_FIND_REMOTE:
        fadeUiOut();
        bleStartUserScan();
        fadeUiIn();
        break;
      case BLE_MENU_KEY_MAP:
        clearBleHeldState();
        bleUiMode = BLE_UI_MAPPING;
        bleMappingIndex = 0;
        transitionToBleScreen();
        break;
      case BLE_MENU_SHORTCUTS:
        bleUiMode = BLE_UI_SHORTCUTS;
        bleShortcutIndex = 0;
        transitionToBleScreen();
        break;
      case BLE_MENU_RESTORE_DEFAULTS:
        bleUiMode = BLE_UI_CONFIRM_DEFAULTS;
        bleDefaultsYes = false;
        transitionToBleScreen();
        break;
      case BLE_MENU_REMOVE_REMOTE:
        bleUiMode = BLE_UI_CONFIRM_REMOVE;
        bleRemoveYes = false;
        transitionToBleScreen();
        break;
      default:
        showToast("Unavailable");
        drawMenu();
        break;
    }
    return;
  }

  if (menuPage == PAGE_PRESET) {
    if (!isPresetOccupied(menuIndex)) {
      showToast("Empty preset");
      drawMenu();
      return;
    }
    if (!loadPreset(menuIndex, false)) {
      showToast("Preset load failed");
      drawMenu();
    }
    return;
  }

  if (menuPage == PAGE_PSYBASS && !psybassWritable()) {
    showToast("Unavailable");
    drawMenu();
    return;
  }

  beginEdit();
}

void changeVolume(float delta)
{
  if (!dspi.connected) {
    showToast("NO DSPi");
    redrawCurrentView();
    return;
  }
  float target = roundf((dspi.volumeDb + delta) * 2.0f) / 2.0f;
  if (!setUserVolume(target)) showToast("DSPi ERROR");
  // The large blackout volume card belongs only to Now Playing.  Home keeps
  // its normal layout and live meters even while local media is audible.
  if (uiView == VIEW_MEDIA_NOW_PLAYING) showMediaVolumeOverlay();
  else redrawCurrentView();
}

void changePreset(int direction)
{
  uint8_t slot = nextAvailablePreset(dspi.activePreset, direction);
  // With only one occupied slot the wrapped search returns the active preset.
  // Reloading that slot would unexpectedly restore its saved volume and DSP
  // state even though Preset Previous/Next did not select a different preset.
  if (slot == dspi.activePreset && isPresetOccupied(slot)) {
    showToast("Only one preset");
    redrawCurrentView();
    return;
  }
  bool ok = dspi.connected && loadPreset(slot, true);
  if (!ok) showToast("DSPi ERROR");
  if (uiView != VIEW_CHANGE_OVERLAY) redrawCurrentView();
}

void changeInput(int direction)
{
  InputSource baseSource = dspi.source;
  if (!dspi.connected) {
    showToast("NO DSPi");
    redrawCurrentView();
    return;
  }
  InputSource target = nextInputSourceChoice(baseSource, direction);
  const bool mediaSessionPresent = mediaPlayerPoc.active() ||
      mediaPlaybackSuspended || mediaCurrentPath[0] ||
      mediaTrackTransitionActive();
  if (mediaSessionPresent && target != baseSource) {
    stopMediaPlayback("input change");
  }
  if (target == baseSource || !setInputSource(target, true)) {
    showToast(target == baseSource ? "Only one input" : "DSPi error");
    redrawCurrentView();
    return;
  }
  discardPendingMediaRouteRestore("input shortcut");
  showSourceChangeOverlay(dspi.source);
}

UiAction contextualizeUiAction(UiAction action)
{
  if (uiView == VIEW_MEDIA_NOW_PLAYING) {
    if (action == ACT_NAV_UP) return ACT_VOL_UP;
    if (action == ACT_NAV_DOWN) return ACT_VOL_DOWN;
  }
  return action;
}

void returnToMediaBrowserAfterStop()
{
  restoreMediaBrowserToQueueTrack();
  menuPage = PAGE_MEDIA;
  uiView = VIEW_MENU;
  drawMenu();
}

bool dispatchDedicatedMediaAction(UiAction action)
{
  if (action == ACT_MEDIA_OPEN) {
    enterPage(PAGE_MEDIA);
    return true;
  }
  if (action == ACT_MEDIA_SETTINGS) {
    enterPage(PAGE_MEDIA_SETTINGS);
    return true;
  }
  if (action != ACT_MEDIA_PLAY_PAUSE &&
      action != ACT_MEDIA_PREVIOUS &&
      action != ACT_MEDIA_NEXT &&
      action != ACT_MEDIA_STOP) {
    return false;
  }

  if (action == ACT_MEDIA_PLAY_PAUSE) {
    if (mediaTrackTransitionActive()) {
      cancelMediaTrackTransition();
      mediaPlayerPoc.stop();
      restoreDspiMediaRoute();
      showToast("Loading cancelled", 900);
      redrawCurrentView();
      return true;
    }
    if (!mediaCurrentPath[0]) {
      showToast("Nothing queued");
      redrawCurrentView();
      return true;
    }
    if (!toggleMediaPause()) showToast("Playback error");
    else if (uiView != VIEW_MEDIA_NOW_PLAYING) {
      showToast(mediaPlayerPoc.playbackState() == MediaPlaybackState::Paused
                    ? "Paused" : "Playing", 900);
      redrawCurrentView();
    }
    return true;
  }

  if (action == ACT_MEDIA_PREVIOUS || action == ACT_MEDIA_NEXT) {
    if (mediaQueueCount == 0) {
      showToast("Nothing queued");
      redrawCurrentView();
      return true;
    }
    int direction = action == ACT_MEDIA_PREVIOUS ? -1 : 1;
    if (!skipMediaTrack(direction, true)) {
      showToast("No playable track");
    } else if (uiView != VIEW_MEDIA_NOW_PLAYING) {
      showToast(direction < 0 ? "Previous track" : "Next track", 900);
    }
    if (uiView != VIEW_MEDIA_NOW_PLAYING) redrawCurrentView();
    return true;
  }

  if (mediaTrackTransitionActive()) {
    cancelMediaTrackTransition();
    mediaPlayerPoc.requestStop();
    showToast("Loading cancelled", 900);
    redrawCurrentView();
    return true;
  }
  if (!mediaCurrentPath[0]) {
    showToast("Nothing queued");
    redrawCurrentView();
    return true;
  }

  bool wasNowPlaying = uiView == VIEW_MEDIA_NOW_PLAYING;
  parkMediaPlayback("remote");
  showToast("Stopped", 900);
  if (wasNowPlaying) drawMediaNowPlaying();
  else redrawCurrentView();
  return true;
}

void dispatchUiAction(UiAction action)
{
  if (action == ACT_NONE) return;
  if (recordUserActivity()) return;
  action = contextualizeUiAction(action);
  if (action == ACT_NONE) return;

  if (mediaVolumeOverlayVisible &&
      action != ACT_VOL_UP && action != ACT_VOL_DOWN) {
    dismissMediaVolumeOverlay(false);
  }

  // A confirmation never swallows input: restore the exact previous view and
  // then process the action against that view.
  if (uiView == VIEW_FEATURE_CONFIRM) dismissFeatureConfirmation();
  if (uiView == VIEW_CHANGE_OVERLAY) dismissChangeOverlay();

  if (uiView == VIEW_WIFI_TRANSFER_CONFIRM) {
    if (action == ACT_LEFT || action == ACT_NAV_UP) {
      wifiTransferConfirmStart = true;
      drawWifiTransferConfirmation();
    } else if (action == ACT_RIGHT || action == ACT_NAV_DOWN) {
      wifiTransferConfirmStart = false;
      drawWifiTransferConfirmation();
    } else if (action == ACT_SELECT) {
      if (wifiTransferConfirmStart) requestWifiTransferEntry();
      else enterPage(PAGE_MEDIA);
    } else if (action == ACT_HOME) {
      transitionToHome();
    } else if (action == ACT_BACK || action == ACT_MENU_TOGGLE) {
      enterPage(PAGE_MEDIA);
    }
    return;
  }
  if (uiView == VIEW_WIFI_TRANSFER_ACTIVE) {
    // BLE is deliberately unavailable and normal UI actions are frozen while
    // the transfer service owns the SD card. Finish Safely remains in-browser.
    return;
  }
  if (uiView == VIEW_WIFI_TRANSFER_ERROR) {
    if (action == ACT_HOME) transitionToHome();
    else if (action == ACT_SELECT || action == ACT_BACK ||
             action == ACT_MENU_TOGGLE) {
      enterPage(PAGE_MEDIA);
    }
    return;
  }

  // Transfer screens deliberately freeze normal DSP/UI controls. Everywhere
  // else the dedicated keys remain User Volume controls.
  if (action == ACT_VOL_UP) {
    changeVolume(1.0f);
    return;
  }
  if (action == ACT_VOL_DOWN) {
    changeVolume(-1.0f);
    return;
  }

  if (dispatchDedicatedMediaAction(action)) return;

  if (uiView == VIEW_PRESET_SAVE_CONFIRM) {
    if (action == ACT_LEFT || action == ACT_NAV_UP) {
      presetSaveConfirmYes = false;
      drawPresetSaveConfirmation();
    } else if (action == ACT_RIGHT || action == ACT_NAV_DOWN) {
      presetSaveConfirmYes = true;
      drawPresetSaveConfirmation();
    } else if (action == ACT_BACK || action == ACT_MENU_TOGGLE) {
      enterPage(PAGE_PRESET);
    } else if (action == ACT_HOME) {
      transitionToHome();
    } else if (action == ACT_SELECT) {
      if (!presetSaveConfirmYes) {
        enterPage(PAGE_PRESET);
      } else {
        bool accepted = saveCurrentPreset(presetSaveDestination);
        menuPage = PAGE_PRESET;
        menuIndex = presetSaveDestination;
        rememberedMenuIndex[PAGE_PRESET] = menuIndex;
        editActive = false;
        uiView = VIEW_MENU;
        showToast(accepted ? (presetSavePanelSettingsOk
                                  ? "Saving..." : "DSPi saved; panel error")
                           : "DSPi error");
        drawMenu();
      }
    }
    return;
  }


  if (uiView == VIEW_BLE) {
    if (action == ACT_HOME) transitionToHome();
    else if (action == ACT_MENU_TOGGLE) enterPage(PAGE_MAIN);
    else if (action == ACT_BACK) bleBack();
    else if (action == ACT_SELECT) bleSelect();
    else if (action == ACT_LEFT) bleNavigate(-1);
    else if (action == ACT_RIGHT) bleNavigate(1);
    return;
  }

  if (uiView == VIEW_MEDIA_NOW_PLAYING) {
    if (action == ACT_LEFT || action == ACT_RIGHT) {
      bool advanced = skipMediaTrack(action == ACT_LEFT ? -1 : 1, true);
      if (!advanced) {
        showToast("No playable track");
        if (!mediaPlayerPoc.active()) goBack();
      }
    } else if (action == ACT_SELECT) {
      if (mediaTrackTransitionActive()) {
        cancelMediaTrackTransition();
        mediaPlayerPoc.requestStop();
        showToast("Loading cancelled", 900);
        drawMediaNowPlaying();
      } else if (!toggleMediaPause()) {
        showToast("Playback stopped");
      }
    } else if (action == ACT_NAV_UP) {
      changeVolume(1.0f);
    } else if (action == ACT_NAV_DOWN) {
      changeVolume(-1.0f);
    } else if (action == ACT_BACK) {
      goBack();
    } else if (action == ACT_HOME) {
      transitionToHome();
    } else if (action == ACT_MENU_TOGGLE) {
      enterPage(PAGE_MAIN);
    } else if (action == ACT_MUTE) {
      if (dspi.connected) setUserMute(!dspi.muted);
      drawMediaNowPlaying();
    } else if (action == ACT_VISUALIZER_TOGGLE) {
      toggleVisualizer();
    }
    return;
  }

  if (uiView == VIEW_EDIT) {
    bool handled = true;
    if (action == ACT_NAV_UP) adjustEdit(1);
    else if (action == ACT_NAV_DOWN) adjustEdit(-1);
    else if (action == ACT_SELECT) applyEdit();
    else if (action == ACT_BACK) goBack();
    else if (action == ACT_HOME) { cancelActiveEdit(); transitionToHome(); }
    else if (action == ACT_MENU_TOGGLE) { cancelActiveEdit(); transitionToHome(); }
    else if (action == ACT_VISUALIZER_TOGGLE) { cancelActiveEdit(); toggleVisualizer(); }
    else handled = false;
    if (handled) return;
  }

  if (uiView == VIEW_MENU) {
    bool handled = false;
    if (menuPage == PAGE_MAIN) {
      if (action == ACT_LEFT) { moveMenu(-1); handled = true; }
      else if (action == ACT_RIGHT) { moveMenu(1); handled = true; }
    } else {
      if (action == ACT_NAV_UP) { moveMenu(-1); handled = true; }
      else if (action == ACT_NAV_DOWN) { moveMenu(1); handled = true; }
    }
    if (action == ACT_SELECT) { selectMenuItem(); handled = true; }
    else if (action == ACT_BACK) { goBack(); handled = true; }
    if (action == ACT_HOME) { transitionToHome(); handled = true; }
    else if (action == ACT_MENU_TOGGLE) { transitionToHome(); handled = true; }
    else if (action == ACT_VISUALIZER_TOGGLE) { toggleVisualizer(); handled = true; }
    if (handled) return;
  }

  switch (action) {
    case ACT_MUTE: {
      bool visualizerActive = uiView == VIEW_VISUALIZER;
      if (dspi.connected) setUserMute(!dspi.muted);
      if (visualizerActive) drawVisualizer();
      else if (mediaPlayerPoc.active()) redrawCurrentView();
      else drawHome();
      break;
    }
    case ACT_NAV_UP:
      if (uiView == VIEW_HOME) changeVolume(1.0f); // Serial/test fallback only.
      break;
    case ACT_NAV_DOWN:
      if (uiView == VIEW_HOME) changeVolume(-1.0f); // Serial/test fallback only.
      break;
    case ACT_SELECT:
      if (uiView == VIEW_VISUALIZER) transitionToHome();
      else if (uiView == VIEW_HOME) enterPage(PAGE_MAIN);
      else if (uiView == VIEW_STATUS) goBack();
      break;
    case ACT_BACK: goBack(); break;
    case ACT_HOME:
      cancelActiveEdit();
      transitionToHome();
      break;
    case ACT_MENU_TOGGLE:
      if (uiView == VIEW_HOME || uiView == VIEW_VISUALIZER) {
        enterPage(PAGE_MAIN);
      } else {
        cancelActiveEdit();
        transitionToHome();
      }
      break;
    case ACT_LOUDNESS_TOGGLE: {
      bool fullScreen = uiView == VIEW_HOME;
      bool target = !dspi.loudnessEnabled;
      bool ok = dspi.connected && setLoudness(target);
      if (ok && fullScreen) showFeatureStateNotification("Loudness", target);
      else {
        showToast(ok ? (String("Loudness ") + (target ? "On" : "Off"))
                     : (dspi.connected ? "DSPi error" : "NO DSPi"), 900);
        redrawCurrentView();
      }
      break;
    }
    case ACT_CROSSFEED_TOGGLE: {
      bool fullScreen = uiView == VIEW_HOME;
      bool target = !dspi.crossfeedEnabled;
      bool ok = dspi.connected && setCrossfeed(target);
      if (ok && fullScreen) showFeatureStateNotification("Crossfeed", target);
      else {
        showToast(ok ? (String("Crossfeed ") + (target ? "On" : "Off"))
                     : (dspi.connected ? "DSPi error" : "NO DSPi"), 900);
        redrawCurrentView();
      }
      break;
    }
    case ACT_LEVELLER_TOGGLE: {
      bool fullScreen = uiView == VIEW_HOME;
      bool target = !dspi.levellerEnabled;
      bool ok = dspi.connected && setLeveller(target);
      if (ok && fullScreen) showFeatureStateNotification("Leveller", target);
      else {
        showToast(ok ? (String("Leveller ") + (target ? "On" : "Off"))
                     : (dspi.connected ? "DSPi error" : "NO DSPi"), 900);
        redrawCurrentView();
      }
      break;
    }
    case ACT_PSYBASS_TOGGLE: {
      bool fullScreen = uiView == VIEW_HOME;
      bool target = !dspi.psybassEnabled;
      bool ok = dspi.connected && psybassWritable() && setPsybassEnabled(target);
      if (ok && fullScreen) showFeatureStateNotification("Psy Bass", target);
      else {
        String failure = dspi.connected && !psybassWritable() ? "Unavailable" :
                         (dspi.connected ? "DSPi error" : "NO DSPi");
        showToast(ok ? (String("Psy Bass ") + (target ? "On" : "Off")) : failure, 900);
        redrawCurrentView();
      }
      break;
    }
    case ACT_PRESET_PREV: changePreset(-1); break;
    case ACT_PRESET_NEXT: changePreset(1); break;
    case ACT_INPUT_PREV: changeInput(-1); break;
    case ACT_INPUT_NEXT: changeInput(1); break;
    case ACT_INPUT_TOGGLE: changeInput(1); break;
    case ACT_VISUALIZER_TOGGLE:
      cancelActiveEdit();
      toggleVisualizer();
      break;
    default: break;
  }
}

// -----------------------------------------------------------------------------
// Encoder and push button
// -----------------------------------------------------------------------------

bool buttonRaw = true;
bool buttonStable = true;
bool buttonLongSent = false;
bool buttonVisualizerSent = false;
bool buttonWakeConsumed = false;
unsigned long buttonChangedAt = 0;
unsigned long buttonPressedAt = 0;

void IRAM_ATTR encoderEdgeIsr()
{
  uint8_t current = ((uint8_t)gpio_get_level((gpio_num_t)ENCODER_A_PIN) << 1) |
                    (uint8_t)gpio_get_level((gpio_num_t)ENCODER_B_PIN);
  uint8_t lookup = (encoderIsrPrevious << 2) | current;
  encoderIsrPrevious = current;

  int8_t delta = 0;
  switch (lookup) {
    case 0x2: case 0x4: case 0xB: case 0xD: delta = 1; break;
    case 0x1: case 0x7: case 0x8: case 0xE: delta = -1; break;
    default: break;
  }

  if (delta) {
    portENTER_CRITICAL_ISR(&encoderMux);
    encoderQuarterSteps += delta;
    portEXIT_CRITICAL_ISR(&encoderMux);
  }
}

void beginEncoder()
{
  pinMode(ENCODER_A_PIN, INPUT_PULLUP);
  pinMode(ENCODER_B_PIN, INPUT_PULLUP);
  pinMode(ENCODER_SW_PIN, INPUT_PULLUP);
  encoderIsrPrevious = (digitalRead(ENCODER_A_PIN) << 1) | digitalRead(ENCODER_B_PIN);
  attachInterrupt(digitalPinToInterrupt(ENCODER_A_PIN), encoderEdgeIsr, CHANGE);
  attachInterrupt(digitalPinToInterrupt(ENCODER_B_PIN), encoderEdgeIsr, CHANGE);
}

void applyEncoderDetents(int16_t detents)
{
  if (detents == 0) return;

  if (recordUserActivity()) {
    encoderMenuDetentRemainder = 0;
    return;
  }

  if (uiView == VIEW_FEATURE_CONFIRM) dismissFeatureConfirmation();
  if (uiView == VIEW_CHANGE_OVERLAY) dismissChangeOverlay();

  if (uiView == VIEW_PRESET_SAVE_CONFIRM) {
    presetSaveConfirmYes = detents > 0;
    encoderMenuDetentRemainder = 0;
    drawPresetSaveConfirmation();
    return;
  }

  if (uiView == VIEW_WIFI_TRANSFER_CONFIRM) {
    // The encoder is the fallback control when BLE is intentionally absent.
    // Counter-clockwise selects START; clockwise selects CANCEL. START is
    // already selected when the confirmation opens, so press-only also works.
    wifiTransferConfirmStart = detents < 0;
    encoderMenuDetentRemainder = 0;
    drawWifiTransferConfirmation();
    return;
  }

  if (uiView == VIEW_HOME || uiView == VIEW_VISUALIZER ||
      uiView == VIEW_MEDIA_NOW_PLAYING) {
    changeVolume((float)detents * 1.0f);
    return;
  }
  if (uiView == VIEW_MENU) {
    if ((encoderMenuDetentRemainder > 0 && detents < 0) ||
        (encoderMenuDetentRemainder < 0 && detents > 0)) {
      encoderMenuDetentRemainder = 0;
    }
    encoderMenuDetentRemainder += detents;
    int16_t steps = encoderMenuDetentRemainder / ENCODER_MENU_DETENTS_PER_STEP;
    encoderMenuDetentRemainder -= steps * ENCODER_MENU_DETENTS_PER_STEP;
    if (steps) moveMenu(steps);
    return;
  }
  if (uiView == VIEW_BLE) {
    if ((encoderMenuDetentRemainder > 0 && detents < 0) ||
        (encoderMenuDetentRemainder < 0 && detents > 0)) {
      encoderMenuDetentRemainder = 0;
    }
    encoderMenuDetentRemainder += detents;
    int16_t steps = encoderMenuDetentRemainder / ENCODER_MENU_DETENTS_PER_STEP;
    encoderMenuDetentRemainder -= steps * ENCODER_MENU_DETENTS_PER_STEP;
    if (steps) bleNavigate(steps);
    return;
  }
  if (uiView == VIEW_EDIT) {
    // This encoder generates two decoded events for each physical click.
    // Menu navigation already combines those events; edit mode must do the
    // same or booleans toggle twice and 5% values jump by 10%.
    if ((encoderMenuDetentRemainder > 0 && detents < 0) ||
        (encoderMenuDetentRemainder < 0 && detents > 0)) {
      encoderMenuDetentRemainder = 0;
    }
    encoderMenuDetentRemainder += detents;
    int16_t steps = encoderMenuDetentRemainder / ENCODER_MENU_DETENTS_PER_STEP;
    encoderMenuDetentRemainder -= steps * ENCODER_MENU_DETENTS_PER_STEP;
    int direction = steps > 0 ? 1 : -1;
    uint16_t count = (uint16_t)abs(steps);
    while (count--) adjustEdit(direction);
    return;
  }
  encoderMenuDetentRemainder = 0;
}

void pollEncoder()
{
  int16_t quarterSteps = 0;
  portENTER_CRITICAL(&encoderMux);
  quarterSteps = encoderQuarterSteps;
  encoderQuarterSteps = 0;
  portEXIT_CRITICAL(&encoderMux);

  encoderDetentRemainder += quarterSteps;
  int16_t detents = 0;
  while (encoderDetentRemainder >= ENCODER_COUNTS_PER_DETENT) {
    encoderDetentRemainder -= ENCODER_COUNTS_PER_DETENT;
    detents++;
  }
  while (encoderDetentRemainder <= -ENCODER_COUNTS_PER_DETENT) {
    encoderDetentRemainder += ENCODER_COUNTS_PER_DETENT;
    detents--;
  }
  applyEncoderDetents(detents);

  bool raw = digitalRead(ENCODER_SW_PIN);
  if (raw != buttonRaw) {
    buttonRaw = raw;
    buttonChangedAt = millis();
  }
  if (millis() - buttonChangedAt < ENCODER_DEBOUNCE_MS || raw == buttonStable) return;

  buttonStable = raw;
  if (!buttonStable) {
    buttonWakeConsumed = recordUserActivity();
    buttonPressedAt = millis();
    buttonLongSent = false;
    buttonVisualizerSent = false;
  } else if (buttonWakeConsumed) {
    buttonWakeConsumed = false;
  } else if (!buttonLongSent && !buttonVisualizerSent) {
    unsigned long heldMs = millis() - buttonPressedAt;
    if (uiView == VIEW_VISUALIZER) {
      drawHome();
    } else if (uiView == VIEW_HOME && heldMs >= ENCODER_LONG_PRESS_MS) {
      dispatchUiAction(ACT_MUTE);
    } else {
      dispatchUiAction(ACT_SELECT);
    }
  }
}

void pollEncoderLongPress()
{
  if (buttonStable || buttonWakeConsumed) return;
  unsigned long heldMs = millis() - buttonPressedAt;

  if (uiView == VIEW_HOME) {
    if (!buttonVisualizerSent && heldMs >= ENCODER_VISUALIZER_HOLD_MS) {
      buttonVisualizerSent = true;
      buttonLongSent = true;
      enterVisualizer();
    }
    return;
  }

  if (uiView == VIEW_MENU && menuPage == PAGE_PRESET && !editActive &&
      !buttonLongSent && heldMs >= PRESET_SAVE_HOLD_MS) {
    buttonLongSent = true;
    beginHighlightedPresetSave();
    return;
  }

  // Preset Select owns its five-second hold gesture. Do not let the generic
  // 750 ms Back shortcut exit the list while the user is still holding it.
  if (uiView == VIEW_MENU && menuPage == PAGE_PRESET && !editActive) return;

  if (uiView != VIEW_VISUALIZER && !buttonLongSent && heldMs >= ENCODER_LONG_PRESS_MS) {
    buttonLongSent = true;
    dispatchUiAction(ACT_BACK);
  }
}

// -----------------------------------------------------------------------------
// BLE remote profile storage in ESP32 NVS
// -----------------------------------------------------------------------------

uint8_t countRemoteMappings()
{
  uint8_t count = 0;
  for (uint8_t i = 0; i < BLE_MAPPING_COUNT; i++) if (remoteMapEntrySet(remoteMap[i])) count++;
  return count;
}

int8_t mappingIndexForAction(UiAction action)
{
  for (uint8_t i = 0; i < BLE_MAPPING_COUNT; i++) {
    if (bleMappingActions[i] == action) return (int8_t)i;
  }
  return -1;
}

bool isValidHomeShortcut(UiAction action)
{
  for (uint8_t i = 0; i < HOME_SHORTCUT_OPTION_COUNT; i++) {
    if (homeShortcutOptions[i] == action) return true;
  }
  return false;
}

void resetHomeShortcutsToDefaults()
{
  memcpy(homeShortcuts, homeShortcutDefaults, sizeof(homeShortcuts));
}

void saveHomeShortcuts()
{
  markDeferredPreference(PREF_DIRTY_HOME_SHORTCUTS);
}

void loadHomeShortcuts()
{
  resetHomeShortcutsToDefaults();
  uint8_t version = preferences.getUChar("home_sc_ver", 0);
  if (version == HOME_SHORTCUT_VERSION &&
      preferences.getBytesLength("home_sc") == sizeof(homeShortcuts)) {
    preferences.getBytes("home_sc", homeShortcuts, sizeof(homeShortcuts));
    bool repaired = false;
    for (uint8_t i = 0; i < HOME_SHORTCUT_COUNT; i++) {
      if (!isValidHomeShortcut(homeShortcuts[i])) {
        homeShortcuts[i] = homeShortcutDefaults[i];
        repaired = true;
      }
    }
    if (repaired) saveHomeShortcuts();
  } else if (version == 1 &&
             preferences.getBytesLength("home_sc") == 4 * sizeof(UiAction)) {
    // Preserve the released Up/Down/Left/Right assignments and seed Centre
    // with the old home-screen behaviour (open the main menu).
    UiAction legacy[4] = {};
    preferences.getBytes("home_sc", legacy, sizeof(legacy));
    for (uint8_t i = 0; i < 4; i++) {
      homeShortcuts[i] = isValidHomeShortcut(legacy[i])
                       ? legacy[i] : homeShortcutDefaults[i];
    }
    homeShortcuts[4] = ACT_MENU_TOGGLE;
    saveHomeShortcuts();
  } else {
    Serial.println("NVS: home shortcuts absent; using RAM defaults");
  }
}

uint8_t homeShortcutOptionIndex(UiAction action)
{
  for (uint8_t i = 0; i < HOME_SHORTCUT_OPTION_COUNT; i++) {
    if (homeShortcutOptions[i] == action) return i;
  }
  return 0;
}

UiAction resolveHomeShortcut(UiAction role)
{
  switch (role) {
    case ACT_NAV_UP: return homeShortcuts[0];
    case ACT_NAV_DOWN: return homeShortcuts[1];
    case ACT_LEFT: return homeShortcuts[2];
    case ACT_RIGHT: return homeShortcuts[3];
    case ACT_SELECT: return homeShortcuts[4];
    default: return role;
  }
}

void saveRemoteMappings()
{
  // Learning can generate several edits in quick succession. Keep the live
  // mapping immediately, but batch the NVS write on the main loop after the
  // remote has gone quiet. No Preferences call is allowed in a BLE worker.
  markDeferredPreference(PREF_DIRTY_BLE_MAPPINGS);
}

void restoreRemoteDefaults()
{
  memset(remoteMap, 0, sizeof(remoteMap));
  saveRemoteMappings();
  resetHomeShortcutsToDefaults();
  saveHomeShortcuts();
}

void loadRemoteProfile()
{
  loadHomeShortcuts();
  memset(remoteMap, 0, sizeof(remoteMap));
  uint8_t version = preferences.getUChar("ble_map_ver", 0);
  bool loadedMappings = false;
  if (version == BLE_MAPPING_VERSION &&
      preferences.getBytesLength("ble_maps") == sizeof(remoteMap)) {
    preferences.getBytes("ble_maps", remoteMap, sizeof(remoteMap));
    loadedMappings = true;
  } else if (version == 4 &&
             preferences.getBytesLength("ble_maps") ==
                 BLE_LEGACY_MAPPING_COUNT * sizeof(RemoteMapEntry)) {
    // Preserve every released 15-role mapping and append the six new Media
    // roles unset. UiAction values were deliberately appended, not reordered.
    RemoteMapEntry legacy[BLE_LEGACY_MAPPING_COUNT] = {};
    preferences.getBytes("ble_maps", legacy, sizeof(legacy));
    memcpy(remoteMap, legacy, sizeof(legacy));
    loadedMappings = true;
  }

  if (loadedMappings) {
    for (uint8_t i = 0; i < BLE_MAPPING_COUNT; i++) {
      if (remoteMap[i].length > sizeof(remoteMap[i].bytes) ||
          remoteMap[i].action != bleMappingActions[i] ||
          remoteMap[i].matchKind > BLE_MAP_CONSUMER_USAGE ||
          (remoteMapEntrySet(remoteMap[i]) && remoteMap[i].sourceKey == 0) ||
          (remoteMap[i].matchKind == BLE_MAP_RAW && remoteMap[i].sourceKey && !remoteMap[i].length) ||
          (remoteMap[i].matchKind != BLE_MAP_RAW && remoteMap[i].sourceKey && !remoteMap[i].usage)) {
        memset(&remoteMap[i], 0, sizeof(remoteMap[i]));
      }
    }
    if (version != BLE_MAPPING_VERSION) saveRemoteMappings();
  } else {
    // Keep empty mappings in RAM on a freshly erased panel. Writing defaults
    // here caused the first boot and first pairing to contend for NVS.
    Serial.println("NVS: BLE mappings absent; using empty RAM table");
  }

  String address = preferences.getString("ble_addr", "");
  String name = preferences.getString("ble_name", "");
  if (address.length() == 17) {
    address.toCharArray(bleSavedAddress, sizeof(bleSavedAddress));
    if (name.length() == 0) name = "BLE remote";
    name.toCharArray(bleSavedName, sizeof(bleSavedName));
    bleSavedAddressType = preferences.getUChar("ble_type", 0);
    bleProfileValid = true;
  }
}

void saveRemoteDevice(const BleDeviceInfo &device)
{
  clearBleHeldState();
  bool newRemote = !bleProfileValid || !String(bleSavedAddress).equalsIgnoreCase(device.address);
  if (newRemote) {
    memset(remoteMap, 0, sizeof(remoteMap));
    saveRemoteMappings();
  }

  memset(bleSavedName, 0, sizeof(bleSavedName));
  memset(bleSavedAddress, 0, sizeof(bleSavedAddress));
  if (device.name[0]) {
    strncpy(bleSavedName, device.name, sizeof(bleSavedName) - 1);
  } else {
    strncpy(bleSavedName, "BLE remote", sizeof(bleSavedName) - 1);
  }
  strncpy(bleSavedAddress, device.address, sizeof(bleSavedAddress) - 1);
  bleSavedAddressType = device.addressType;
  bleProfileValid = true;
  markDeferredPreference(PREF_DIRTY_BLE_DEVICE);
  Serial.println("BLE PAIR: profile live; NVS save deferred to main loop");
}

void beginBleRemoteRemoval()
{
  clearBleHeldState();
  if (bleRemovalInProgress) return;

  memset(bleRemovedAddress, 0, sizeof(bleRemovedAddress));
  if (bleProfileValid && strlen(bleSavedAddress) == 17) {
    strncpy(bleRemovedAddress, bleSavedAddress, sizeof(bleRemovedAddress) - 1);
    bleRemovedAddressType = bleSavedAddressType;
  }

  bleRemovalInProgress = true;
  bleSecurityConfirmed = false;
  __atomic_add_fetch(&bleConnectionGeneration, 1U, __ATOMIC_ACQ_REL);
  bleRemovalNvsComplete = false;
  bleRemovalNvsSucceeded = false;
  bleRemovalNvsAttempts = 0;
  bleRemovalDisconnectRequested = false;
  bleRemovalDisconnectRetryAt = 0;
  bleProfileValid = false;
#if DSPI_HAVE_NIMBLE
  resetBleScanState(true);
  bleConnectRequested = false;
  blePendingSave = false;
  if (bleReportQueue) xQueueReset(bleReportQueue);
  memset(bleInputSources, 0, sizeof(bleInputSources));
  bleInputSourceCount = 0;
  if (bleStackReady && bleRemovedAddress[0]) {
    NimBLEAddress address(std::string(bleRemovedAddress), bleRemovedAddressType);
    NimBLEDevice::deleteBond(address);
  }
  if (bleClient && bleClient->isConnected()) {
    bleRemovalDisconnectRequested = true;
    bleRemovalDisconnectRetryAt = millis() + 500;
    bleClient->disconnect();
  }
  bleStackRestartPending = true;
  bleStackRestartRetryAt = millis() + 100;
#endif
  lastBleScanAt = millis();
  memset(bleSavedName, 0, sizeof(bleSavedName));
  memset(bleSavedAddress, 0, sizeof(bleSavedAddress));
  memset(remoteMap, 0, sizeof(remoteMap));
  portENTER_CRITICAL(&deferredPreferenceMux);
  deferredPreferenceFlags &= ~(PREF_DIRTY_BLE_DEVICE | PREF_DIRTY_BLE_MAPPINGS);
  portEXIT_CRITICAL(&deferredPreferenceMux);
  markDeferredPreference(PREF_DIRTY_BLE_REMOVE, 200);
  clampBleMenuIndex();

  bleUiMode = BLE_UI_MESSAGE;
  bleMessage = "Removing remote";
  bleMessageUntil = 0;
  bleAnimationStep = 0;
  bleLastAnimationAt = millis();
  drawBleScreen();
}

UiAction lookupRemoteMapping(const BleReportPacket &packet);

String remoteLabelForAction(uint8_t mappingIndex)
{
  if (mappingIndex >= BLE_MAPPING_COUNT || !remoteMapEntrySet(remoteMap[mappingIndex])) return "Not set";
  if (remoteMap[mappingIndex].label[0]) return String(remoteMap[mappingIndex].label);
  return "Mapped";
}

