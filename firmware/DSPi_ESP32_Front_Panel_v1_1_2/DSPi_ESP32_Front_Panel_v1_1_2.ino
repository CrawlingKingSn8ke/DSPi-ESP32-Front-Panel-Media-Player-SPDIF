bool ensureMediaUiBuffers()
{
  if (mediaBrowserEntries && mediaBrowserStack && mediaQueuePaths) return true;

  auto allocate = [](size_t bytes) -> void * {
    void *memory = heap_caps_calloc(1, bytes,
                                    MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
    if (!memory) memory = calloc(1, bytes);
    return memory;
  };

  if (!mediaBrowserEntries) {
    mediaBrowserEntries = static_cast<MediaBrowserEntry *>(
        allocate(sizeof(MediaBrowserEntry) * MEDIA_UI_PAGE_ENTRIES));
  }
  if (!mediaBrowserStack) {
    mediaBrowserStack = static_cast<MediaBrowserFrame *>(
        allocate(sizeof(MediaBrowserFrame) * MEDIA_UI_MAX_DEPTH));
  }
  if (!mediaQueuePaths) {
    mediaQueuePaths = static_cast<char (*)[MEDIA_FS_PATH_CAPACITY]>(
        allocate(MEDIA_QUEUE_MAX_ENTRIES * MEDIA_FS_PATH_CAPACITY));
  }

  if (mediaBrowserEntries && mediaBrowserStack && mediaQueuePaths) {
    Serial.printf(
        "MEDIA MEM: browser=%u stack=%u queue=%u path-capacity=%u bytes\n",
        (unsigned)(sizeof(MediaBrowserEntry) * MEDIA_UI_PAGE_ENTRIES),
        (unsigned)(sizeof(MediaBrowserFrame) * MEDIA_UI_MAX_DEPTH),
        (unsigned)(MEDIA_QUEUE_MAX_ENTRIES * MEDIA_FS_PATH_CAPACITY),
        (unsigned)MEDIA_FS_PATH_CAPACITY);
    return true;
  }

  if (mediaBrowserEntries) free(mediaBrowserEntries);
  if (mediaBrowserStack) free(mediaBrowserStack);
  if (mediaQueuePaths) free(mediaQueuePaths);
  mediaBrowserEntries = nullptr;
  mediaBrowserStack = nullptr;
  mediaQueuePaths = nullptr;
  return false;
}

