void printHelp()
{
  Serial.println();
  Serial.println("DSPi ESP32 Control Panel v1.2.0");
  Serial.println("Media build: native 44.1/48 kHz + Wi-Fi Music Transfer + verified 30 MHz shared SD path");
  Serial.println("u/d = navigate (volume on home), </> = left/right");
  Serial.println("+/- = User Volume");
  Serial.println("r = search for BLE remote");
  Serial.println("f = list SD root and probe WAV/FLAC/MP3 headers");
  Serial.println("p <SD path><Enter> = play WAV/FLAC/MP3 at native rate");
  Serial.println("z = pause/resume, x = stop, s = media/I2S status");
  Serial.println("o = select/OK, b = back, h = home, m = mute");
  Serial.println("i = force full DSPi state refresh");
  Serial.println();
}

void servicePresetSaveCompletion()
{
  if (!presetSaveCompletionPending ||
      (long)(millis() - presetSaveCompletionAt) < 0) return;

  presetSaveCompletionAttempts++;
  if (syncCurrentState(true)) {
    presetSaveCompletionPending = false;
    showToast(presetSavePanelSettingsOk
        ? "Saved to P" + String((int)presetSaveCompletionSlot + 1)
        : "DSPi saved; panel error");
    redrawCurrentView();
  } else if (presetSaveCompletionAttempts < 4) {
    presetSaveCompletionAt = millis() + 250;
  } else {
    // 0x90 was accepted, but the post-blackout verification link did not
    // recover in time. Do not incorrectly report a definite flash failure.
    presetSaveCompletionPending = false;
    showToast(presetSavePanelSettingsOk
        ? "Save accepted P" + String((int)presetSaveCompletionSlot + 1)
        : "DSPi saved; panel error");
    redrawCurrentView();
  }
}

void handleSerial()
{
  static bool collectingMediaPath = false;
  static char mediaPath[MEDIA_FS_PATH_CAPACITY] = {0};
  static size_t mediaPathLength = 0;

  while (Serial.available() > 0) {
    char c = Serial.read();

    if (collectingMediaPath) {
      if (c == '\r' || c == '\n') {
        collectingMediaPath = false;
        mediaPath[mediaPathLength] = '\0';
        if (mediaPathLength == 0) {
          Serial.println("MEDIA PLAY: usage p /path/file.wav");
        } else {
          startMediaPlayback(mediaPath);
        }
        mediaPathLength = 0;
        continue;
      }
      if ((c == '\b' || c == 0x7F) && mediaPathLength > 0) {
        mediaPathLength--;
        continue;
      }
      if (c == ' ' && mediaPathLength == 0) continue;
      if (c >= 0x20 && mediaPathLength + 1 < sizeof(mediaPath)) {
        mediaPath[mediaPathLength++] = c;
      }
      continue;
    }

    if (c == '\r' || c == '\n' || c == ' ') continue;
    if (c == 'u') dispatchUiAction(ACT_NAV_UP);
    else if (c == 'd') dispatchUiAction(ACT_NAV_DOWN);
    else if (c == '<') dispatchUiAction(ACT_LEFT);
    else if (c == '>') dispatchUiAction(ACT_RIGHT);
    else if (c == '+') dispatchUiAction(ACT_VOL_UP);
    else if (c == '-') dispatchUiAction(ACT_VOL_DOWN);
    else if (c == 'o') dispatchUiAction(ACT_SELECT);
    else if (c == 'b') dispatchUiAction(ACT_BACK);
    else if (c == 'h') dispatchUiAction(ACT_HOME);
    else if (c == 'm') dispatchUiAction(ACT_MUTE);
    else if (c == 'v') dispatchUiAction(ACT_VISUALIZER_TOGGLE);
    else if (c == 'i') { syncCurrentState(true); redrawCurrentView(); }
    else if (c == 'r') bleStartUserScan();
    else if (c == 'f') mediaPlayerPoc.printDirectory(Serial, "/", 48);
    else if (c == 'p') {
      collectingMediaPath = true;
      mediaPathLength = 0;
      Serial.println("MEDIA PLAY: enter absolute SD path");
    }
    else if (c == 'z') {
      if (!toggleMediaPause()) {
        Serial.println("MEDIA PLAY: pause ignored; no active track");
      }
    }
    else if (c == 'x') {
      parkMediaPlayback("user");
      redrawCurrentView();
    }
    else if (c == 's') printMediaPlaybackStatus();
    else if (c == '?') printHelp();
  }
}

void drawBootLogo(uint8_t alpha)
{
  canvas->fillScreen(C_BLACK);
  drawFontCentred(FontLarge, 68, "DSPi",
                  blend565(C_BLACK, uiMainText(), alpha));
  flushCanvasLocked();
}

void bootLogoFadeInAndHold()
{
  const uint8_t target =
      (uint8_t)map(brightnessPercent, 0, 100, 0, BL_MAX);
  for (uint8_t step = 0; step <= 26; step++) {
    const uint8_t alpha = (uint8_t)((step * BL_MAX) / 26UL);
    drawBootLogo(alpha);
    setBacklight((uint8_t)((step * target) / 26UL));
    delay(38);
  }
  drawBootLogo(BL_MAX);
  setBacklight(target);
}

void bootLogoFadeOut()
{
  const uint8_t target =
      (uint8_t)map(brightnessPercent, 0, 100, 0, BL_MAX);
  for (int step = 20; step >= 0; step--) {
    const uint8_t alpha = (uint8_t)((step * BL_MAX) / 20UL);
    drawBootLogo(alpha);
    setBacklight((uint8_t)((step * target) / 20UL));
    delay(28);
  }
  canvas->fillScreen(C_BLACK);
  flushCanvasLocked();
  setBacklight(0);
}

void bootUiFadeIn()
{
  drawHome();
  uint8_t target = (uint8_t)map(brightnessPercent, 0, 100, 0, BL_MAX);
  for (uint8_t step = 0; step <= 30; step++) {
    setBacklight((uint8_t)((step * target) / 30UL));
    delay(22);
  }
  screenDimmed = false;
  backlightFadeActive = false;
  lastUserActivityAt = millis();
}

void setup()
{
  // Assert both shared-SPI chip selects before any serial delay or library
  // construction. After a full-flash upload the ESP32 resets while the LCD and
  // SD card can remain powered; leaving either CS floating for hundreds of
  // milliseconds can clock the card into an undefined command state.
  pinMode(LCD_CS, OUTPUT);
  digitalWrite(LCD_CS, HIGH);
  pinMode(MEDIA_SD_CS, OUTPUT);
  digitalWrite(MEDIA_SD_CS, HIGH);
  pinMode(LCD_BL, OUTPUT);
  digitalWrite(LCD_BL, LOW);

  Serial.begin(115200);
  delay(350);

  // Keep boot diagnostics read-only. The stable main firmware does not write
  // NVS on every startup, so this media build also avoids repeated boot-stage
  // flash writes and logs the hardware reset reason directly instead.
  Serial.printf("BOOT: reset_reason=%d heap=%u psram=%u\n",
                (int)esp_reset_reason(), (unsigned)ESP.getFreeHeap(),
                (unsigned)ESP.getPsramSize());
  Serial.printf("BOOT: loop_stack_size=%lu free=%u bytes\n",
                (unsigned long)getArduinoLoopTaskStackSize(),
                (unsigned)(uxTaskGetStackHighWaterMark(nullptr)));
  auto markBootStage = [&](uint8_t stage, const char *label) {
    Serial.printf("BOOT: stage=%u %s\n", (unsigned)stage, label);
  };
  markBootStage(1, "start");

  delay(25);

  // Bring up the control link without writing User Volume. DSPi restores the
  // listening level from its own preset/runtime state.
  markBootStage(2, "DSPi UART begin");
  DspiSerial.begin(DSPI_UART_BAUD, SERIAL_8N1,
                   DSPI_UART_RX_PIN, DSPI_UART_TX_PIN);
  dspiDrainRx();
  dspi.volumeDb = 0.0f;

  markBootStage(3, "panel begin");
  if (!panel->begin()) {
    Serial.println("BOOT FATAL: panel->begin() failed");
    while (true) delay(1000);
  }
  markBootStage(4, "canvas begin");
  if (!canvas->begin()) {
    Serial.println("BOOT FATAL: canvas->begin() failed");
    while (true) delay(1000);
  }

  ledcAttach(LCD_BL, BL_PWM_FREQ, BL_PWM_RES);
  setBacklight(0);
  beginEncoder();

  preferences.begin("dspi-panel", false);

  // Version 3 adds two palette roles and separates digital/home meters from
  // the analogue face. Every older VU choice is copied to both new roles so
  // the first boot after upgrade is visually identical.
  bool themeMigrated = false;
  const size_t themeBlobBytes = preferences.getBytesLength("theme_cfg");
  if (themeBlobBytes == sizeof(ThemeSettingsRecord)) {
    ThemeSettingsRecord storedTheme = {};
    preferences.getBytes("theme_cfg", &storedTheme, sizeof(storedTheme));
    if (storedTheme.version == THEME_SETTINGS_VERSION &&
        storedTheme.mainTextPalette < THEME_PALETTE_COUNT &&
        storedTheme.accentPalette >= ACCENT_PALETTE_FIRST &&
        storedTheme.accentPalette < THEME_PALETTE_COUNT &&
        storedTheme.meterPalette < THEME_PALETTE_COUNT &&
        storedTheme.analogVu < VU_COLOUR_CHOICE_COUNT) {
      mainTextPaletteIndex = storedTheme.mainTextPalette;
      accentPaletteIndex = storedTheme.accentPalette;
      volumeMeterPaletteIndex = storedTheme.meterPalette;
      analogVuColourChoice = (VuColourChoice)storedTheme.analogVu;
    } else {
      themeMigrated = true;
    }
  } else if (themeBlobBytes == sizeof(LegacyThemeSettingsRecordV2)) {
    LegacyThemeSettingsRecordV2 legacy = {};
    preferences.getBytes("theme_cfg", &legacy, sizeof(legacy));
    if (legacy.version == 2 && legacy.mainText <= UI_COLOUR_YELLOW &&
        legacy.accent <= ACCENT_COLOUR_YELLOW &&
        legacy.vu < VU_COLOUR_CHOICE_COUNT) {
      mainTextPaletteIndex = legacyMainTextToPalette(legacy.mainText);
      accentPaletteIndex = legacyAccentToPalette(legacy.accent);
      volumeMeterPaletteIndex = legacyVuToPalette(legacy.vu);
      analogVuColourChoice = (VuColourChoice)legacy.vu;
    }
    themeMigrated = true;
  } else {
    const uint8_t storedThemeVersion = preferences.getUChar("theme_ver", 0);
    if (storedThemeVersion == 2) {
      const uint8_t storedMainText = preferences.getUChar(
          "theme_text", UI_COLOUR_WHITE);
      const uint8_t storedAccent = preferences.getUChar(
          "theme_acc", ACCENT_COLOUR_CYAN);
      const uint8_t storedVu = preferences.getUChar(
          "theme_vu", VU_COLOUR_CYAN);
      mainTextPaletteIndex = legacyMainTextToPalette(storedMainText);
      accentPaletteIndex = legacyAccentToPalette(storedAccent);
      volumeMeterPaletteIndex = legacyVuToPalette(storedVu);
      analogVuColourChoice = storedVu < VU_COLOUR_CHOICE_COUNT
          ? (VuColourChoice)storedVu : VU_COLOUR_CYAN;
    } else if (storedThemeVersion == 1) {
      const uint8_t oldMainText = preferences.getUChar(
          "theme_text", UI_COLOUR_WHITE);
      const uint8_t oldAccent = preferences.getUChar(
          "theme_acc", UI_COLOUR_CYAN);
      const uint8_t oldVu = preferences.getUChar("theme_vu", 0);
      mainTextPaletteIndex = legacyMainTextToPalette(
          oldMainText <= UI_COLOUR_MAGENTA ? oldMainText : UI_COLOUR_WHITE);
      const uint8_t compactAccent = oldAccent >= UI_COLOUR_CYAN &&
                                    oldAccent <= UI_COLOUR_MAGENTA
          ? oldAccent - UI_COLOUR_CYAN : ACCENT_COLOUR_CYAN;
      accentPaletteIndex = legacyAccentToPalette(compactAccent);
      switch (oldVu) {
        case 0: analogVuColourChoice = VU_COLOUR_WARM_WHITE; break;
        case 3: analogVuColourChoice = VU_COLOUR_GREEN; break;
        case 4: analogVuColourChoice = VU_COLOUR_AMBER; break;
        case 5: analogVuColourChoice = VU_COLOUR_MAGENTA; break;
        case 1:
        case 2:
        default: analogVuColourChoice = VU_COLOUR_CYAN; break;
      }
      volumeMeterPaletteIndex = legacyVuToPalette(analogVuColourChoice);
    }
    themeMigrated = true;
  }
  if (themeMigrated) persistThemePreferencesNow();
  // Build a saved custom face during the hidden boot phase. The first
  // automatic/manual analogue VU opening therefore has no tinting pause.
  prepareAnalogVuFaceCache();

  brightnessPercent = constrain(preferences.getUChar("brightness", 80),
                                (uint8_t)10, (uint8_t)100);
  screenTimeoutOption = std::min<uint8_t>(
      preferences.getUChar("screen_to", 0), 4);
  screenDimPercent = preferences.getUChar("screen_dim", 20);
  if (screenDimPercent > 80 || (screenDimPercent % 10) != 0) {
    screenDimPercent = 20;
  }

  // v1.1.2 represented Screen Off as a zero dim level. Preserve that setting
  // when introducing a separate timeout action, then keep Dim Level within its
  // new 10-80 percent range.
  if (preferences.isKey("screen_act")) {
    const uint8_t storedScreenAction = preferences.getUChar(
        "screen_act", SCREEN_TIMEOUT_DIM);
    screenTimeoutAction = storedScreenAction <= SCREEN_TIMEOUT_ANALOG_VU
        ? (ScreenTimeoutAction)storedScreenAction
        : SCREEN_TIMEOUT_DIM;
  } else if (screenDimPercent == 0) {
    screenTimeoutAction = SCREEN_TIMEOUT_OFF;
  } else {
    screenTimeoutAction = SCREEN_TIMEOUT_DIM;
  }
  if (screenDimPercent == 0) screenDimPercent = 20;

  mediaSeekStepIndex = std::min<uint8_t>(
      preferences.getUChar("media_seek", 1), 2);
  loadRemoteProfile();

  // Keep the logo phase deterministic. SD negotiation, PSRAM ring tests,
  // artwork worker creation and full DSPi state sweeps are all deferred until
  // the UI is running. This is especially important after an esptool erase,
  // which warm-resets the ESP32 while the SD card and Pico may remain powered.
  bootLogoFadeInAndHold();

  markBootStage(5, "media core init (SD deferred)");
  if (!mediaPlayerPoc.begin(SPI, MEDIA_SD_CS, MEDIA_SD_SCLK,
                            MEDIA_SD_MISO, MEDIA_SD_MOSI)) {
    Serial.println("BOOT FATAL: media control allocation failed");
    while (true) delay(1000);
  }
  if (!ensureMediaUiBuffers()) {
    Serial.println("BOOT FATAL: media UI buffer allocation failed");
    while (true) delay(1000);
  }
  Serial.printf("MEM: heap free=%u largest=%u PSRAM free=%u total=%u\n",
                (unsigned)ESP.getFreeHeap(),
                (unsigned)ESP.getMaxAllocHeap(),
                (unsigned)ESP.getFreePsram(),
                (unsigned)ESP.getPsramSize());

  dspi.platform = 1;
  dspi.firmwareMajor = 1;
  dspi.firmwareMinorPatchBcd = 0x16;
  dspi.outputChannels = 0;
  dspi.source = SRC_USB;
  dspi.volumeDb = 0.0f;
  dspi.masterVolumeDb = 0.0f;
  dspi.masterVolumeMode = 0;
  dspi.activePreset = 0;
  dspi.loudnessReferenceSpl = 83.0f;
  dspi.loudnessIntensity = 100.0f;
  dspi.crossfeedFrequencyHz = 700.0f;
  dspi.crossfeedFeedDb = 4.5f;
  dspi.levellerAmount = 50.0f;
  dspi.levellerMaxGainDb = 15.0f;
  dspi.levellerGateDb = -96.0f;
  dspi.levellerLookahead = true;
  dspi.psybassCutoffHz = 80.0f;
  dspi.psybassHarmonicsDb = 0.0f;
  dspi.psybassDriveDb = 6.0f;
  dspi.psybassCharacterPct = 50.0f;
  dspi.psybassOriginalDb = 0.0f;
  dspi.sampleRate = 48000;
  // Pre-sync placeholders; the first syncCurrentState() overwrites them with
  // whatever the attached firmware actually reports.
  dspi.spdifInputCount = PANEL_MAX_SPDIF_INPUTS;
  dspi.spdifOptionalEnableMask = 0;
  dspi.spdifPins[0] = 5;
  dspi.spdifPins[1] = 20;
  dspi.spdifPins[2] = 21;
  dspi.spdifPins[3] = 22;
  dspi.adatInputEnabled = false;
  dspi.adatInputPin = 0xFF;
  strncpy(dspi.presetNames[0], "Default",
          sizeof(dspi.presetNames[0]) - 1);

  markBootStage(6, "DSPi defaults ready");
  printHelp();

  // Home must become usable even when the Pico is still booting or the saved
  // BLE remote is asleep. The normal one-second reconnect service performs the
  // complete verified state sweep after the logo has gone.
  markBootStage(7, "UI ready; DSPi sync deferred");
  bootLogoFadeOut();
  bootUiFadeIn();
  beginBleRemote();
  lastConnectAttemptAt = millis() - 1000;
}

void serviceVisibleMeters(bool mediaActive)
{
  if (uiView != VIEW_HOME && uiView != VIEW_VISUALIZER) return;
  if (mediaActive && (mediaTrackTransitionActive() ||
                      mediaPlaybackBufferLow())) return;
  const uint32_t interval = screenTimeoutViewActive
      ? SCREEN_TIMEOUT_VU_POLL_MS
      : (mediaActive && uiView == VIEW_VISUALIZER ? 120 : METER_POLL_MS);
  if ((uint32_t)(millis() - lastMeterAt) < interval) return;
  lastMeterAt = millis();

  float leftWidth = 0.0f;
  float rightWidth = 0.0f;
  if (pollMeters()) {
    meterPollFailureCount = 0;
    const bool transportFresh = meterTransportHasFreshAudio();
    if (!transportFresh) {
      clearMeterReadout(nullptr);
    } else {
      analogPeakSampleValid = true;
      const uint8_t meterLeft = meterLeftChannelIndex();
      const uint8_t meterRight = meterRightChannelIndex();
      if (!dspi.muted) {
        leftWidth = peakToMeterWidth(dspi.peaks[meterLeft], 266.0f);
        rightWidth = peakToMeterWidth(dspi.peaks[meterRight], 266.0f);
      }
      updateMeterBallistics(leftWidth, rightWidth);
    }
    updateAnalogNeedle();
  } else {
    analogPeakSampleValid = false;
    resetAnalogPeakHold(-20.0f);
    if (meterPollFailureCount < 255) meterPollFailureCount++;
    if (meterPollFailureCount >= METER_FAILURE_CLEAR_COUNT) {
      clearMeterReadout("meter status unavailable");
    } else {
      updateMeterBallistics(0.0f, 0.0f);
    }
    updateAnalogNeedle();
  }

  if (uiView == VIEW_VISUALIZER) {
    drawVisualizer();
  } else if (mediaActive) {
    // The SD decoder and LCD share SPI. Refresh only the 22-pixel meter strip
    // during Media playback instead of sending a full 320x240 frame at 18 Hz.
    canvas->fillRect(0, 210, UI_W, 22, C_BLACK);
    drawLevelBars();
    flushCanvasRegionLocked(0, 210, UI_W, 22);
  } else {
    drawHome();
  }
}

void loop()
{
  serviceWifiTransfer();
  if (wifiTransferExclusive()) {
    // The transfer lifecycle owns SD, Wi-Fi, BLE and normal UI activity.  Do
    // not service serial commands, media browsing, DSPi polling, or remote
    // input until read-only mount and normal services have been restored.
    serviceScreenPower();
    delay(2);
    return;
  }

  handleSerial();
  serviceDeferredPreferences();
  mediaPlayerPoc.serviceStopCleanup();
  serviceMediaTrackTransition();
  serviceMediaSeek();
  serviceMediaPlayback();
  serviceMediaArtwork();
  serviceMediaRouteRestore();
  serviceMediaPresetRefresh();
  serviceMediaDeferredRedraw();
  serviceMediaBrowserRedraw();

  if (mediaPlayerPoc.active()) {
    // The decoder owns the time-critical prefill/seek windows, but once its
    // reserve is healthy the same lightweight runtime watcher used by USB must
    // remain alive.  This keeps Console volume, preset and feature state in
    // sync without running the much heavier full-state sweep during playback.
    if (notificationRefreshAt &&
        (long)(millis() - notificationRefreshAt) >= 0) {
      notificationRefreshAt = 0;
      externalRuntimeRefreshRequested = true;
      if (notificationFullRefreshRequested) {
        stateRefreshRequested = true;
        notificationFullRefreshRequested = false;
      }
    }

    const bool mediaRuntimePollSafe = !mediaPlayerPoc.seeking() &&
        !mediaTrackTransitionActive() && !mediaPlaybackBufferLow() &&
        uiView != VIEW_BLE;
    if (mediaRuntimePollSafe && dspi.connected &&
        (externalRuntimeRefreshRequested ||
         millis() - lastStateSyncAt >= 1200)) {
      lastStateSyncAt = millis();
      externalRuntimeRefreshRequested = false;
      const InputSource sourceBeforeRuntimePoll = dspi.source;
      const bool runtimeChanged = pollExternalRuntimeState();
      const bool externalSourceChanged =
          dspi.source != sourceBeforeRuntimePoll;

      // A Console source selection away from the media S/PDIF input takes
      // ownership immediately.
      // Point the pending restore at that already-selected source so stopping
      // music never overrides the Console's choice when playback stops.
      if (externalSourceChanged && dspi.source != SRC_OPTICAL &&
          mediaPlayerPoc.active()) {
        const InputSource externalSource = dspi.source;
        if (mediaRoute.captured) mediaRoute.source = externalSource;
        stopMediaPlayback("external input change");
      } else if (runtimeChanged && uiView != VIEW_EDIT &&
                 uiView != VIEW_VISUALIZER &&
                 uiView != VIEW_FEATURE_CONFIRM &&
                 uiView != VIEW_CHANGE_OVERLAY &&
                 uiView != VIEW_MEDIA_NOW_PLAYING) {
        redrawCurrentView();
      }
    }

    // The watcher above can stop playback after a Console input change.  Fall
    // through to the ordinary non-media loop immediately in that case.
    if (!mediaPlayerPoc.active()) {
      serviceMediaRouteRestore();
    } else {
      pollBleRemote();
      pollEncoder();
      pollEncoderLongPress();
      serviceScreenPower();
      serviceMediaUiAnimations();
      if (!mediaPlayerPoc.seeking()) serviceVisibleMeters(true);

      if (uiView == VIEW_FEATURE_CONFIRM && featureConfirmUntil &&
          (long)(millis() - featureConfirmUntil) >= 0) {
        dismissFeatureConfirmation();
      }
      if (uiView == VIEW_CHANGE_OVERLAY && changeOverlayUntil &&
          (long)(millis() - changeOverlayUntil) >= 0) {
        dismissChangeOverlay();
      }
      if (toastText.length() && (long)(millis() - toastUntil) >= 0) {
        toastText = "";
        if (!mediaVolumeOverlayVisible) {
          if (mediaTrackTransitionActive() || mediaPlaybackBufferLow()) {
            mediaUiDeferredFullRedraw = true;
          } else {
            redrawCurrentView();
          }
        }
      }
      delay(2);
      return;
    }
  }

  pollBleRemote();
  pollEncoder();
  pollEncoderLongPress();
  serviceScreenPower();
  serviceMediaUiAnimations();
  servicePresetSaveCompletion();

  if (uiView == VIEW_FEATURE_CONFIRM && featureConfirmUntil &&
      (long)(millis() - featureConfirmUntil) >= 0) {
    dismissFeatureConfirmation();
  }

  if (uiView == VIEW_CHANGE_OVERLAY && changeOverlayUntil &&
      (long)(millis() - changeOverlayUntil) >= 0) {
    dismissChangeOverlay();
  }

  // Keep BLE search/pair/learn animation cadence independent of the blocking
  // UART state sweep. The overdue sweep runs immediately after leaving BLE.
  bool deferDspiSync = uiView == VIEW_BLE;

  if (notificationRefreshAt && (long)(millis() - notificationRefreshAt) >= 0) {
    notificationRefreshAt = 0;
    externalRuntimeRefreshRequested = true;
    if (notificationFullRefreshRequested) {
      stateRefreshRequested = true;
      notificationFullRefreshRequested = false;
    }
  }

  if (!deferDspiSync && delayedRefreshAt && (long)(millis() - delayedRefreshAt) >= 0) {
    delayedRefreshAt = 0;
    lastStateSyncAt = millis();
    syncCurrentState(false);
    redrawCurrentView();
  }

  if (!dspi.connected) {
    if (!deferDspiSync && millis() - lastConnectAttemptAt >= 1000) {
      lastConnectAttemptAt = millis();
      if (syncCurrentState(true)) redrawCurrentView();
    }
  } else {
    bool refreshDebouncing = delayedRefreshAt != 0 || notificationRefreshAt != 0;
    if (!deferDspiSync && !refreshDebouncing && stateRefreshRequested &&
        millis() - lastStateSyncAt >= 120) {
      lastStateSyncAt = millis();
      syncCurrentState(false);
      redrawCurrentView();
    } else if (!deferDspiSync && !refreshDebouncing &&
               (externalRuntimeRefreshRequested ||
                millis() - lastStateSyncAt >= 1200)) {
      lastStateSyncAt = millis();
      externalRuntimeRefreshRequested = false;
      const bool runtimeChanged = pollExternalRuntimeState();
      if (runtimeChanged && uiView != VIEW_EDIT && uiView != VIEW_BLE &&
          uiView != VIEW_VISUALIZER && uiView != VIEW_FEATURE_CONFIRM &&
          uiView != VIEW_CHANGE_OVERLAY) {
        redrawCurrentView();
      }
    }

    serviceVisibleMeters(false);
  }

  if (toastText.length() && (long)(millis() - toastUntil) >= 0) {
    toastText = "";
    if (uiView == VIEW_HOME) drawHome();
    else if (uiView == VIEW_VISUALIZER) drawVisualizer();
  }

  delay(2);
}

// Keep this override after every sketch function and custom type declaration.
// SET_LOOP_TASK_STACK_SIZE expands to a function definition; placing it near
// the includes makes Arduino's automatic prototype generator emit prototypes
// before the sketch's types and library headers, producing a cascade of
// "does not name a type" errors. Function order is irrelevant at link time.
SET_LOOP_TASK_STACK_SIZE(16 * 1024);
