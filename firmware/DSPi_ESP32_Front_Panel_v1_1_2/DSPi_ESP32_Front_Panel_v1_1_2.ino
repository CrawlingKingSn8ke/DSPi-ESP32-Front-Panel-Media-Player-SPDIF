bool setLevellerMaxGain(float value)
{
  value = constrain(value, 0.0f, 35.0f);
  if (!dspiSetFloat(REQ_SET_LEVELLER_MAX_GAIN, value)) return false;
  dspi.levellerMaxGainDb = value;
  return true;
}

bool setLevellerGate(float value)
{
  value = constrain(value, -96.0f, 0.0f);
  if (!dspiSetFloat(REQ_SET_LEVELLER_GATE, value)) return false;
  dspi.levellerGateDb = value;
  return true;
}

bool setLevellerLookahead(bool enabled)
{
  if (!dspiSetByte(REQ_SET_LEVELLER_LOOKAHEAD, enabled ? 1 : 0)) return false;
  dspi.levellerLookahead = enabled;
  return true;
}

bool psybassWritable()
{
  return dspi.psybassCapabilityKnown && dspi.psybassSupported;
}

bool setPsybassEnabled(bool enabled)
{
  if (!psybassWritable() || !dspiSetByte(REQ_SET_PSYBASS, enabled ? 1 : 0)) return false;
  uint8_t readback = 0;
  if (!getExactByte(REQ_GET_PSYBASS, readback) || readback > 1) return false;
  dspi.psybassEnabled = readback != 0;
  return dspi.psybassEnabled == enabled;
}

bool setPsybassFloatVerified(uint8_t setRequest, uint8_t getRequest, float value,
                             float minimum, float maximum, float &stateField)
{
  if (!psybassWritable()) return false;
  value = constrain(value, minimum, maximum);
  if (!dspiSetFloat(setRequest, value)) return false;
  float readback = value;
  if (!getExactFloat(getRequest, readback) || readback < minimum || readback > maximum) return false;
  stateField = readback;
  return true;
}

bool setPsybassCutoff(float value)
{
  return setPsybassFloatVerified(REQ_SET_PSYBASS_CUTOFF, REQ_GET_PSYBASS_CUTOFF,
                                 value, 30.0f, 300.0f, dspi.psybassCutoffHz);
}

bool setPsybassHarmonics(float value)
{
  return setPsybassFloatVerified(REQ_SET_PSYBASS_HARMONICS, REQ_GET_PSYBASS_HARMONICS,
                                 value, -24.0f, 12.0f, dspi.psybassHarmonicsDb);
}

bool setPsybassDrive(float value)
{
  return setPsybassFloatVerified(REQ_SET_PSYBASS_DRIVE, REQ_GET_PSYBASS_DRIVE,
                                 value, 0.0f, 18.0f, dspi.psybassDriveDb);
}

bool setPsybassCharacter(float value)
{
  return setPsybassFloatVerified(REQ_SET_PSYBASS_CHARACTER, REQ_GET_PSYBASS_CHARACTER,
                                 value, 0.0f, 100.0f, dspi.psybassCharacterPct);
}

bool setPsybassOriginal(float value)
{
  return setPsybassFloatVerified(REQ_SET_PSYBASS_ORIGINAL, REQ_GET_PSYBASS_ORIGINAL,
                                 value, -60.0f, 0.0f, dspi.psybassOriginalDb);
}

