// DSPi state synchronisation
// -----------------------------------------------------------------------------

void showToast(const String &text, uint16_t durationMs = 1400)
{
  toastText = text;
  toastUntil = millis() + durationMs;
}

void showFeatureStateToast(const char *featureName, bool enabled)
{
  showToast(String(featureName) + (enabled ? " On" : " Off"), 900);
}

String cleanDisplayText(String value, uint8_t maxChars)
{
  value.trim();
  String out;

  auto appendAscii = [&](char c) {
    if (out.length() >= maxChars) return;
    bool ok = (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
              (c >= '0' && c <= '9') || c == ' ' || c == '-' ||
              c == '.' || c == '/' || c == '+' || c == '&' ||
              c == '(' || c == ')' || c == ':' || c == ',' ||
              c == '\'';
    out += ok ? c : ' ';
  };

  const uint8_t *bytes = reinterpret_cast<const uint8_t *>(value.c_str());
  const size_t length = value.length();
  for (size_t i = 0; i < length && out.length() < maxChars;) {
    uint32_t cp = 0;
    uint8_t lead = bytes[i];
    size_t width = 1;
    if (lead < 0x80) {
      cp = lead;
    } else if ((lead & 0xE0) == 0xC0 && i + 1 < length &&
               (bytes[i + 1] & 0xC0) == 0x80) {
      cp = ((uint32_t)(lead & 0x1F) << 6) | (bytes[i + 1] & 0x3F);
      width = 2;
    } else if ((lead & 0xF0) == 0xE0 && i + 2 < length &&
               (bytes[i + 1] & 0xC0) == 0x80 &&
               (bytes[i + 2] & 0xC0) == 0x80) {
      cp = ((uint32_t)(lead & 0x0F) << 12) |
           ((uint32_t)(bytes[i + 1] & 0x3F) << 6) |
           (bytes[i + 2] & 0x3F);
      width = 3;
    } else if ((lead & 0xF8) == 0xF0 && i + 3 < length &&
               (bytes[i + 1] & 0xC0) == 0x80 &&
               (bytes[i + 2] & 0xC0) == 0x80 &&
               (bytes[i + 3] & 0xC0) == 0x80) {
      cp = ((uint32_t)(lead & 0x07) << 18) |
           ((uint32_t)(bytes[i + 1] & 0x3F) << 12) |
           ((uint32_t)(bytes[i + 2] & 0x3F) << 6) |
           (bytes[i + 3] & 0x3F);
      width = 4;
    } else {
      cp = '?';
    }
    i += width;

    if (cp < 0x80) {
      appendAscii((char)cp);
      continue;
    }

    // The bundled font is ASCII-only. Transliterate common Latin and smart
    // punctuation rather than corrupting each UTF-8 byte independently.
    switch (cp) {
      case 0x00C0: case 0x00C1: case 0x00C2: case 0x00C3:
      case 0x00C4: case 0x00C5: appendAscii('A'); break;
      case 0x00E0: case 0x00E1: case 0x00E2: case 0x00E3:
      case 0x00E4: case 0x00E5: appendAscii('a'); break;
      case 0x00C7: appendAscii('C'); break;
      case 0x00E7: appendAscii('c'); break;
      case 0x00C8: case 0x00C9: case 0x00CA: case 0x00CB: appendAscii('E'); break;
      case 0x00E8: case 0x00E9: case 0x00EA: case 0x00EB: appendAscii('e'); break;
      case 0x00CC: case 0x00CD: case 0x00CE: case 0x00CF: appendAscii('I'); break;
      case 0x00EC: case 0x00ED: case 0x00EE: case 0x00EF: appendAscii('i'); break;
      case 0x00D1: appendAscii('N'); break;
      case 0x00F1: appendAscii('n'); break;
      case 0x00D2: case 0x00D3: case 0x00D4: case 0x00D5:
      case 0x00D6: case 0x00D8: appendAscii('O'); break;
      case 0x00F2: case 0x00F3: case 0x00F4: case 0x00F5:
      case 0x00F6: case 0x00F8: appendAscii('o'); break;
      case 0x00D9: case 0x00DA: case 0x00DB: case 0x00DC: appendAscii('U'); break;
      case 0x00F9: case 0x00FA: case 0x00FB: case 0x00FC: appendAscii('u'); break;
      case 0x00DD: appendAscii('Y'); break;
      case 0x00FD: case 0x00FF: appendAscii('y'); break;
      case 0x00C6: appendAscii('A'); appendAscii('E'); break;
      case 0x00E6: appendAscii('a'); appendAscii('e'); break;
      case 0x00DF: appendAscii('s'); appendAscii('s'); break;
      case 0x2018: case 0x2019: appendAscii('\''); break;
      case 0x201C: case 0x201D: appendAscii('\''); break;
      case 0x2013: case 0x2014: appendAscii('-'); break;
      case 0x2026: appendAscii('.'); appendAscii('.'); appendAscii('.'); break;
      case 0x00D7: appendAscii('x'); break;
      default: appendAscii('?'); break;
    }
  }
  while (out.indexOf("  ") >= 0) out.replace("  ", " ");
  out.trim();
  return out;
}

bool getExact(uint8_t request, uint16_t value, uint16_t expectedLength,
              uint8_t *payload, uint16_t capacity, bool affectLinkState = true)
{
  uint16_t length = 0;
  if (!dspiGet(request, value, expectedLength, payload, capacity, length,
               affectLinkState)) return false;
  if (length != expectedLength) {
    Serial.printf("DSPi length reject: req=0x%02X expected=%u actual=%u\n",
                  request, expectedLength, length);
    return false;
  }
  return true;
}

bool getExactByte(uint8_t request, uint8_t &value, uint16_t wValue = 0,
                  bool affectLinkState = true)
{
  uint8_t payload[1] = {0};
  if (!getExact(request, wValue, 1, payload, sizeof(payload), affectLinkState)) return false;
  value = payload[0];
  return true;
}

bool getExactFloat(uint8_t request, float &value, bool affectLinkState = true)
{
  uint8_t payload[4] = {0};
  if (!getExact(request, 0, 4, payload, sizeof(payload), affectLinkState)) return false;
  memcpy(&value, payload, sizeof(value));
  return isfinite(value);
}

bool syncPresetNameCandidate(DspiState &candidate, uint8_t slot)
{
  if (slot >= 10) return false;
  if ((candidate.occupiedPresets & (1u << slot)) == 0) {
    memset(candidate.presetNames[slot], 0, sizeof(candidate.presetNames[slot]));
    return true;
  }

  uint8_t namePayload[32] = {0};
  if (!getExact(REQ_PRESET_GET_NAME, slot, 32, namePayload, sizeof(namePayload))) {
    return false;
  }

  memset(candidate.presetNames[slot], 0, sizeof(candidate.presetNames[slot]));
  memcpy(candidate.presetNames[slot], namePayload, 31);
  candidate.presetNames[slot][31] = 0;
  return true;
}

bool syncPresetDirectoryCandidate(DspiState &candidate, bool names)
{
  uint8_t payload[7] = {0};
  if (!getExact(REQ_PRESET_GET_DIR, 0, 7, payload, sizeof(payload))) return false;
  uint16_t occupied = readLe16(payload);
  if ((occupied & ~0x03FFu) || payload[6] > 1) return false;
  candidate.occupiedPresets = occupied;
  candidate.masterVolumeMode = payload[6];

  for (uint8_t slot = 0; slot < 10; slot++) {
    if ((occupied & (1u << slot)) == 0) {
      memset(candidate.presetNames[slot], 0, sizeof(candidate.presetNames[slot]));
    } else if (names && !syncPresetNameCandidate(candidate, slot)) {
      return false;
    }
  }
  return true;
}

bool syncPsybassCandidate(DspiState &candidate)
{
  uint8_t enabledPayload[1] = {0};
  uint16_t enabledLength = 0;
  DspiTxnResult probeResult = dspiGetResult(REQ_GET_PSYBASS, 0, 1,
                                            enabledPayload, sizeof(enabledPayload),
                                            enabledLength, false);
  if (probeResult == DSPI_TXN_ERROR) {
    candidate.psybassCapabilityKnown = true;
    candidate.psybassSupported = false;
    candidate.psybassEnabled = false;
    return true;
  }
  if (probeResult != DSPI_TXN_OK || enabledLength != 1 || enabledPayload[0] > 1) return false;

  candidate.psybassCapabilityKnown = true;
  candidate.psybassSupported = true;
  candidate.psybassEnabled = enabledPayload[0] != 0;
  if (!getExactFloat(REQ_GET_PSYBASS_CUTOFF, candidate.psybassCutoffHz) ||
      !getExactFloat(REQ_GET_PSYBASS_HARMONICS, candidate.psybassHarmonicsDb) ||
      !getExactFloat(REQ_GET_PSYBASS_DRIVE, candidate.psybassDriveDb) ||
      !getExactFloat(REQ_GET_PSYBASS_CHARACTER, candidate.psybassCharacterPct) ||
      !getExactFloat(REQ_GET_PSYBASS_ORIGINAL, candidate.psybassOriginalDb)) return false;

  return candidate.psybassCutoffHz >= 30.0f && candidate.psybassCutoffHz <= 300.0f &&
         candidate.psybassHarmonicsDb >= -24.0f && candidate.psybassHarmonicsDb <= 12.0f &&
         candidate.psybassDriveDb >= 0.0f && candidate.psybassDriveDb <= 18.0f &&
         candidate.psybassCharacterPct >= 0.0f && candidate.psybassCharacterPct <= 100.0f &&
         candidate.psybassOriginalDb >= -60.0f && candidate.psybassOriginalDb <= 0.0f;
}

bool isSpdifSource(InputSource source)
{
  return source == SRC_OPTICAL || source == SRC_OPTICAL_2 ||
         source == SRC_OPTICAL_3 || source == SRC_OPTICAL_4;
}

bool picoInputPinSane(uint8_t pin, uint8_t platform, bool allowUnset)
{
  if (allowUnset && pin == 0xFF) return true;
  uint8_t maximum = platform == 1 ? 47 : 29;
  return pin <= maximum;
}

bool inputSourceAvailable(InputSource source)
{
  switch (source) {
    case SRC_USB:
    case SRC_OPTICAL:
    case SRC_I2S:
      return true;
    case SRC_ADAT:
      return dspi.platform == 1 && dspi.adatInputEnabled && dspi.adatInputPin != 0xFF;
    case SRC_OPTICAL_2:
      return (dspi.spdifOptionalEnableMask & 0x01u) != 0;
    case SRC_OPTICAL_3:
      return (dspi.spdifOptionalEnableMask & 0x02u) != 0;
    case SRC_OPTICAL_4:
      // Firmware older than v1.1.5 reports 3 inputs and never sets this bit,
      // so the source stays hidden there without a version check.
      return (dspi.spdifOptionalEnableMask & 0x04u) != 0;
  }
  return false;
}

InputSource nextInputSourceChoice(InputSource current, int direction)
{
  // Only sources present in the last verified Console inventory are exposed.
  // USB, first S/PDIF and I2S are always available, so this always terminates.
  for (uint8_t step = 0; step < SRC_COUNT; step++) {
    current = (InputSource)(((int)current +
                             (direction >= 0 ? 1 : -1) + SRC_COUNT) % SRC_COUNT);
    if (inputSourceAvailable(current)) return current;
  }
  return current;
}

String inputSourceDisplayText(InputSource source)
{
  switch (source) {
    case SRC_USB: return "USB";
    case SRC_OPTICAL: return "S/PDIF";
    case SRC_I2S: return "I2S";
    case SRC_ADAT: return "ADAT";
    case SRC_OPTICAL_2: return "S/PDIF 2";
    case SRC_OPTICAL_3: return "S/PDIF 3";
    case SRC_OPTICAL_4: return "S/PDIF 4";
  }
  return "Unknown";
}

bool syncCurrentState(bool includePresetNames)
{
  // Nothing visible changes until every required field has passed its exact
  // length and value checks. This prevents a stale response from producing a
  // half-old/half-new UI snapshot after a Console flash blackout.
  DspiState candidate = dspi;
  uint8_t platformPayload[4] = {0};
  if (!getExact(REQ_GET_PLATFORM, 0, 4, platformPayload, sizeof(platformPayload))) return false;
  if (platformPayload[0] > 1 || platformPayload[3] == 0) return false;
  candidate.platform = platformPayload[0];
  candidate.firmwareMajor = platformPayload[1];
  candidate.firmwareMinorPatchBcd = platformPayload[2];
  candidate.outputChannels = platformPayload[3];

  // Response is 2 + input-count bytes, and the count is firmware-dependent
  // (3 before v1.1.5, 4 from v1.1.5), so size everything off byte 0 instead
  // of pinning a length. wLength caps the reply device-side, so a firmware
  // with more inputs than this panel knows arrives truncated, not rejected.
  uint8_t spdifConfig[2 + PANEL_MAX_SPDIF_INPUTS] = {0};
  uint16_t spdifLength = 0;
  if (!dspiGet(REQ_GET_SPDIF_INPUT_CONFIG, 0, sizeof(spdifConfig), spdifConfig,
               sizeof(spdifConfig), spdifLength)) return false;
  uint8_t reportedInputs = spdifConfig[0];
  if (reportedInputs < 1 || reportedInputs > 8) return false;
  uint8_t usableInputs = reportedInputs < PANEL_MAX_SPDIF_INPUTS
                       ? reportedInputs : PANEL_MAX_SPDIF_INPUTS;
  // Only the inputs actually read back are validated; a truncated tail is
  // fine because those inputs are not exposed anyway.
  if (spdifLength < (uint16_t)(2 + usableInputs)) return false;
  // Byte 1 is an all-input mask covering every reported input: bit 0 is
  // S/PDIF 1 and is always set. Store only the optional part, shifted down,
  // so availability consistently uses bits 0..n.
  uint8_t liveMask = (uint8_t)((1u << reportedInputs) - 1u);
  if ((spdifConfig[1] & ~liveMask) != 0 || (spdifConfig[1] & 0x01u) == 0) return false;
  candidate.spdifInputCount = usableInputs;
  candidate.spdifOptionalEnableMask =
    (uint8_t)((spdifConfig[1] >> 1) & ((1u << (usableInputs - 1)) - 1u));
  memset(candidate.spdifPins, 0xFF, sizeof(candidate.spdifPins));
  for (uint8_t input = 0; input < usableInputs; input++) {
    bool allowUnset = input != 0 &&
      (candidate.spdifOptionalEnableMask & (1u << (input - 1))) == 0;
    if (!picoInputPinSane(spdifConfig[input + 2], candidate.platform, allowUnset)) return false;
    candidate.spdifPins[input] = spdifConfig[input + 2];
  }

  uint8_t adatEnablePayload[1] = {0};
  uint8_t adatPinPayload[1] = {0};
  if (!getExact(REQ_GET_ADAT_INPUT_ENABLE, 0, 1,
                adatEnablePayload, sizeof(adatEnablePayload)) ||
      adatEnablePayload[0] > 1) return false;
  if (!getExact(REQ_GET_ADAT_INPUT_PIN, 0, 1,
                adatPinPayload, sizeof(adatPinPayload)) ||
      !picoInputPinSane(adatPinPayload[0], candidate.platform, true)) return false;
  candidate.adatInputEnabled = adatEnablePayload[0] != 0;
  candidate.adatInputPin = adatPinPayload[0];

  uint8_t byteValue = 0;
  if (!getExactByte(REQ_GET_INPUT_SOURCE, byteValue) || byteValue > SRC_MAX) return false;
  candidate.source = (InputSource)byteValue;

  if (!getExactFloat(REQ_GET_USER_VOLUME, candidate.volumeDb) ||
      !getExactFloat(REQ_GET_MASTER_VOLUME, candidate.masterVolumeDb)) return false;
  if (!getExactByte(REQ_GET_USER_MUTE, byteValue) || byteValue > 1) return false;
  candidate.muted = byteValue != 0;
  if (!getExactByte(REQ_PRESET_GET_ACTIVE, byteValue) || byteValue >= 10) return false;
  candidate.activePreset = byteValue;

  if (!getExactByte(REQ_GET_LOUDNESS, byteValue) || byteValue > 1) return false;
  candidate.loudnessEnabled = byteValue != 0;
  if (!getExactFloat(REQ_GET_LOUDNESS_REFERENCE, candidate.loudnessReferenceSpl) ||
      !getExactFloat(REQ_GET_LOUDNESS_INTENSITY, candidate.loudnessIntensity)) return false;

  if (!getExactByte(REQ_GET_CROSSFEED, byteValue) || byteValue > 1) return false;
  candidate.crossfeedEnabled = byteValue != 0;
  if (!getExactByte(REQ_GET_CROSSFEED_PRESET, byteValue) || byteValue > 3) return false;
  candidate.crossfeedPreset = byteValue;
  if (!getExactFloat(REQ_GET_CROSSFEED_FREQUENCY, candidate.crossfeedFrequencyHz) ||
      !getExactFloat(REQ_GET_CROSSFEED_FEED, candidate.crossfeedFeedDb)) return false;

  if (!getExactByte(REQ_GET_LEVELLER_ENABLE, byteValue) || byteValue > 1) return false;
  candidate.levellerEnabled = byteValue != 0;
  if (!getExactFloat(REQ_GET_LEVELLER_AMOUNT, candidate.levellerAmount)) return false;
  if (!getExactByte(REQ_GET_LEVELLER_SPEED, byteValue) || byteValue > 2) return false;
  candidate.levellerSpeed = byteValue;
  if (!getExactFloat(REQ_GET_LEVELLER_MAX_GAIN, candidate.levellerMaxGainDb) ||
      !getExactFloat(REQ_GET_LEVELLER_GATE, candidate.levellerGateDb)) return false;
  if (!getExactByte(REQ_GET_LEVELLER_LOOKAHEAD, byteValue) || byteValue > 1) return false;
  candidate.levellerLookahead = byteValue != 0;

  if (!syncPsybassCandidate(candidate)) return false;
  if (!syncPresetDirectoryCandidate(candidate, includePresetNames)) return false;
  if (!includePresetNames &&
      (uiView == VIEW_VISUALIZER || pendingPresetOverlay ||
       candidate.activePreset != dspi.activePreset) &&
      !syncPresetNameCandidate(candidate, candidate.activePreset)) return false;

  uint8_t samplePayload[4] = {0};
  if (!getExact(REQ_GET_STATUS, 15, 4, samplePayload, sizeof(samplePayload))) return false;
  candidate.sampleRate = readLe32(samplePayload);
  candidate.spdifState = 0;
  candidate.spdifNonAudio = false;
  candidate.adatState = 0;
  candidate.adatClockMode = 0;
  candidate.adatRateOk = false;
  candidate.adatDetectedRate = 0;
  candidate.adatMeasuredHz = 0;
  if (isSpdifSource(candidate.source)) {
    uint8_t statusPayload[16] = {0};
    if (!getExact(REQ_GET_SPDIF_RX_STATUS, 0, 16, statusPayload, sizeof(statusPayload))) return false;
    if (statusPayload[0] > 3 || statusPayload[1] != (uint8_t)candidate.source) return false;
    candidate.spdifState = statusPayload[0];
    candidate.sampleRate = readLe32(statusPayload + 4);
    if (candidate.spdifState == 2) {
      uint8_t channelStatus[24] = {0};
      if (!getExact(REQ_GET_SPDIF_RX_CH_STATUS, 0, 24,
                    channelStatus, sizeof(channelStatus))) return false;
      candidate.spdifNonAudio = (channelStatus[0] & 0x02u) != 0;
    }
  } else if (candidate.source == SRC_ADAT) {
    uint8_t adatStatus[20] = {0};
    if (!getExact(REQ_GET_ADAT_INPUT_STATUS, 0, 20,
                  adatStatus, sizeof(adatStatus))) return false;
    if (adatStatus[0] > 4 || adatStatus[1] > 1 || adatStatus[2] > 1 ||
        adatStatus[4] > 1 ||
        !picoInputPinSane(adatStatus[3], candidate.platform, true) ||
        adatStatus[2] != (candidate.adatInputEnabled ? 1 : 0) ||
        adatStatus[3] != candidate.adatInputPin) return false;
    candidate.adatState = adatStatus[0];
    candidate.adatClockMode = adatStatus[1];
    candidate.adatRateOk = adatStatus[4] != 0;
    candidate.adatDetectedRate = readLe32(adatStatus + 12);
    candidate.adatMeasuredHz = readLe32(adatStatus + 16);
    if (candidate.adatState == 3 && candidate.adatDetectedRate != 0) {
      candidate.sampleRate = candidate.adatDetectedRate;
    }
  }

  const bool oldConnected = dspi.connected;
  InputSource oldSource = dspi.source;
  uint8_t oldActivePreset = dspi.activePreset;
  uint8_t oldSpdifState = dspi.spdifState;
  uint8_t oldAdatState = dspi.adatState;
  bool oldSpdifNonAudio = dspi.spdifNonAudio;
  candidate.connected = true;
  dspi = candidate;
  applyPresetPanelSettings(dspi.activePreset);

  const bool sourceChanged = oldSource != dspi.source;
  const bool presetChanged = oldActivePreset != dspi.activePreset;
  const bool spdifBecameInvalid = isSpdifSource(dspi.source) &&
      oldSource == dspi.source &&
      ((oldSpdifState == 2 && (dspi.spdifState != 2 || dspi.spdifNonAudio)) ||
       (oldSpdifNonAudio != dspi.spdifNonAudio && dspi.spdifNonAudio));
  const bool adatBecameInvalid = dspi.source == SRC_ADAT &&
      oldSource == dspi.source && oldAdatState == 3 && dspi.adatState != 3;
  if (!oldConnected || sourceChanged || presetChanged ||
      spdifBecameInvalid || adatBecameInvalid) {
    const char *reason = sourceChanged ? "input source changed" :
                         presetChanged ? "preset changed" :
                         spdifBecameInvalid ? "S/PDIF signal lost" :
                         adatBecameInvalid ? "ADAT signal lost" :
                         "DSPi link restored";
    resetMetersForStateChange(reason);
  }

  // Publish only verified DSPi state. A preset load can also restore its saved
  // source; in that case the preset identity is the more useful distance view.
  if (oldConnected && pendingPresetOverlay &&
      dspi.activePreset == pendingPresetOverlaySlot) {
    showPresetChangeOverlay(dspi.activePreset);
    if (sourceChanged) queueSourceChangeAfterPreset(dspi.source);
    pendingPresetOverlay = false;
  } else if (oldConnected && presetChanged) {
    if (uiView == VIEW_HOME || uiView == VIEW_CHANGE_OVERLAY) {
      showPresetChangeOverlay(dspi.activePreset);
      if (sourceChanged) queueSourceChangeAfterPreset(dspi.source);
    }
    pendingPresetOverlay = false;
  } else if (oldConnected && sourceChanged &&
             (uiView == VIEW_HOME || uiView == VIEW_CHANGE_OVERLAY)) {
    if (uiView == VIEW_CHANGE_OVERLAY &&
        changeOverlayKind == CHANGE_OVERLAY_PRESET) {
      queueSourceChangeAfterPreset(dspi.source);
    } else {
      showSourceChangeOverlay(dspi.source);
    }
  }
  if (menuPage == PAGE_PRESET && !editActive &&
      oldActivePreset != dspi.activePreset) {
    menuIndex = dspi.activePreset;
  }
  if (oldSource != dspi.source) {
    Serial.printf("DSPi source change: old=%u new=%u reason=%s\n",
                  (unsigned)oldSource, (unsigned)dspi.source, scheduledSourceReason);
  }
  // User Volume is owned by the DSPi preset/runtime state. The panel publishes
  // the verified readback but never imposes a boot, source-change or
  // preset-change value.
  scheduledSourceReason = "verified GET";
  stateRefreshRequested = false;
  externalRuntimeRefreshRequested = false;
  externalRuntimeStateReady = true;
  lastStateSyncAt = millis();
  return true;
}

bool pollExternalRuntimeState()
{
  if (!dspi.connected) return false;

  float observedVolume = dspi.volumeDb;
  uint8_t observedPreset = dspi.activePreset;
  uint8_t observedSource = (uint8_t)dspi.source;
  uint8_t observedLoudness = dspi.loudnessEnabled ? 1 : 0;
  uint8_t observedCrossfeed = dspi.crossfeedEnabled ? 1 : 0;
  uint8_t observedLeveller = dspi.levellerEnabled ? 1 : 0;
  uint8_t observedPsybass = dspi.psybassEnabled ? 1 : 0;
  uint8_t observedSpdifState = dspi.spdifState;
  uint32_t observedSampleRate = dspi.sampleRate;
  bool observedSpdifNonAudio = dspi.spdifNonAudio;

  // Publish every exact read independently. One unsupported or temporarily
  // busy GET must not freeze unrelated Console state such as volume, preset,
  // source, or the Home feature symbols.
  const bool volumeValid =
      getExactFloat(REQ_GET_USER_VOLUME, observedVolume, true);
  if (!volumeValid) return false;
  const bool presetValid =
      getExactByte(REQ_PRESET_GET_ACTIVE, observedPreset, 0, false) &&
      observedPreset < 10;
  const bool sourceValid =
      getExactByte(REQ_GET_INPUT_SOURCE, observedSource, 0, false) &&
      observedSource <= SRC_MAX;
  const bool loudnessValid =
      getExactByte(REQ_GET_LOUDNESS, observedLoudness, 0, false) &&
      observedLoudness <= 1;
  const bool crossfeedValid =
      getExactByte(REQ_GET_CROSSFEED, observedCrossfeed, 0, false) &&
      observedCrossfeed <= 1;
  const bool levellerValid =
      getExactByte(REQ_GET_LEVELLER_ENABLE, observedLeveller, 0, false) &&
      observedLeveller <= 1;
  const bool psybassValid = dspi.psybassSupported &&
      getExactByte(REQ_GET_PSYBASS, observedPsybass, 0, false) &&
      observedPsybass <= 1;

  // The normal runtime watcher is also used while the SD decoder is active.
  // Keep S/PDIF lock metadata in that lightweight path: activateMediaRoute()
  // publishes ACQUIRING before the first encoded silence reaches the Pico,
  // and without this exact read Home would retain PCM NO LOCK until a full
  // sweep (for example, entering the VU screen) happened by coincidence.
  const InputSource observedInput = sourceValid
      ? (InputSource)observedSource : dspi.source;
  bool spdifStatusValid = false;
  if (isSpdifSource(observedInput)) {
    uint8_t statusPayload[16] = {0};
    spdifStatusValid =
        getExact(REQ_GET_SPDIF_RX_STATUS, 0, 16, statusPayload,
                 sizeof(statusPayload), false) &&
        statusPayload[0] <= 3 && statusPayload[1] == (uint8_t)observedInput;
    if (spdifStatusValid) {
      observedSpdifState = statusPayload[0];
      observedSampleRate = readLe32(statusPayload + 4);
      if (observedSpdifState == 2) {
        uint8_t channelStatus[24] = {0};
        const bool channelStatusValid = getExact(
            REQ_GET_SPDIF_RX_CH_STATUS, 0, 24, channelStatus,
            sizeof(channelStatus), false);
        if (channelStatusValid) {
          observedSpdifNonAudio = (channelStatus[0] & 0x02u) != 0;
        }
      } else {
        observedSpdifNonAudio = false;
      }
    }
  } else if (sourceValid) {
    spdifStatusValid = true;
    observedSpdifState = 0;
    observedSpdifNonAudio = false;
  }

  const bool volumeChanged = volumeValid &&
      fabsf(observedVolume - dspi.volumeDb) > 0.01f;
  const bool presetChanged = presetValid &&
      observedPreset != dspi.activePreset;
  const bool sourceChanged = sourceValid &&
      observedSource != (uint8_t)dspi.source;
  const bool loudnessChanged = loudnessValid &&
      (observedLoudness != 0) != dspi.loudnessEnabled;
  const bool crossfeedChanged = crossfeedValid &&
      (observedCrossfeed != 0) != dspi.crossfeedEnabled;
  const bool levellerChanged = levellerValid &&
      (observedLeveller != 0) != dspi.levellerEnabled;
  const bool psybassChanged = psybassValid &&
      (observedPsybass != 0) != dspi.psybassEnabled;
  const bool spdifStatusChanged = spdifStatusValid &&
      (observedSpdifState != dspi.spdifState ||
       observedSpdifNonAudio != dspi.spdifNonAudio ||
       (isSpdifSource(observedInput) &&
        observedSampleRate != dspi.sampleRate));
  const bool anyChanged = volumeChanged || presetChanged || sourceChanged ||
      loudnessChanged || crossfeedChanged || levellerChanged ||
      psybassChanged || spdifStatusChanged;

  if (volumeValid) dspi.volumeDb = observedVolume;
  if (presetValid) dspi.activePreset = observedPreset;
  if (sourceValid) dspi.source = (InputSource)observedSource;
  if (loudnessValid) dspi.loudnessEnabled = observedLoudness != 0;
  if (crossfeedValid) dspi.crossfeedEnabled = observedCrossfeed != 0;
  if (levellerValid) dspi.levellerEnabled = observedLeveller != 0;
  if (psybassValid) dspi.psybassEnabled = observedPsybass != 0;
  if (spdifStatusValid) {
    dspi.spdifState = observedSpdifState;
    dspi.spdifNonAudio = observedSpdifNonAudio;
    if (isSpdifSource(observedInput)) dspi.sampleRate = observedSampleRate;
  }
  if (presetChanged) applyPresetPanelSettings(dspi.activePreset);

  if (spdifStatusChanged) {
    resetMetersForStateChange(observedSpdifState == 2 &&
                              !observedSpdifNonAudio
                                  ? "S/PDIF signal locked"
                                  : "S/PDIF signal state changed");
  }

  const bool notificationsAllowed = externalRuntimeStateReady;
  externalRuntimeStateReady = true;
  if (!notificationsAllowed) return anyChanged;

  // Preset and source identity remain the higher-priority distance views.
  // Feature values restored by a preset do not create extra announcements.
  if (presetChanged) {
    syncPresetNameCandidate(dspi, dspi.activePreset);
    resetMetersForStateChange("external preset changed");
    if (uiView == VIEW_HOME || uiView == VIEW_CHANGE_OVERLAY) {
      showPresetChangeOverlay(dspi.activePreset);
      if (sourceChanged) queueSourceChangeAfterPreset(dspi.source);
    }
  } else if (sourceChanged) {
    resetMetersForStateChange("external input source changed");
    if (uiView == VIEW_HOME || uiView == VIEW_CHANGE_OVERLAY) {
      showSourceChangeOverlay(dspi.source);
    }
  } else if (loudnessChanged) {
    showFeatureStateNotification("Loudness", dspi.loudnessEnabled);
  } else if (crossfeedChanged) {
    showFeatureStateNotification("Crossfeed", dspi.crossfeedEnabled);
  } else if (levellerChanged) {
    showFeatureStateNotification("Leveller", dspi.levellerEnabled);
  } else if (psybassChanged) {
    showFeatureStateNotification("Psy Bass", dspi.psybassEnabled);
  }

  if (presetChanged && menuPage == PAGE_PRESET && !editActive) {
    menuIndex = dspi.activePreset;
  }
  return anyChanged;
}

uint8_t meterLeftChannelIndex()
{
  // The unit's expanded beta4 status packet has eight inputs followed by
  // outputs at 8/9. The accepted compact Pico layouts use outputs at 2/3.
  return dspi.meterChannelCount >= 17 ? 8 : 2;
}

uint8_t meterRightChannelIndex()
{
  return meterLeftChannelIndex() + 1;
}

bool pollMeters()
{
  // Request the maximum combined-status packet and select its layout from the
  // actual response length. Deployed beta4 returns 17 peaks + two CPU bytes +
  // a 32-bit clip mask; accepted compact firmware returns 7 or 11 peaks + two
  // CPU bytes + a 16-bit clip mask (and may append one system-load byte).
  uint8_t payload[48] = {0};
  uint16_t length = 0;
  if (!dspiGet(REQ_GET_STATUS, 9, sizeof(payload), payload, sizeof(payload), length, false)) return false;

  uint8_t channelCount = 0;
  uint8_t clipBytes = 0;
  if (length >= 40) {
    channelCount = 17;
    clipBytes = 4;
  } else if (length >= 26) {
    channelCount = 11;
    clipBytes = length >= 28 ? 4 : 2;
  } else if (length >= 18) {
    channelCount = 7;
    clipBytes = length >= 20 ? 4 : 2;
  } else {
    return false;
  }

  const uint16_t clipOffset = channelCount * 2 + 2;
  if (clipOffset + clipBytes > length) return false;

  memset(dspi.peaks, 0, sizeof(dspi.peaks));
  for (uint8_t i = 0; i < channelCount; i++) {
    dspi.peaks[i] = readLe16(payload + (i * 2));
  }
  dspi.meterChannelCount = channelCount;
  dspi.clipFlags = clipBytes == 4 ? readLe32(payload + clipOffset)
                                  : readLe16(payload + clipOffset);

  const uint32_t outputMask = channelCount >= 17 ? 0x0001FF00UL
                              : (channelCount == 11 ? 0x000007FCUL : 0x0000007CUL);
  if (dspi.clipFlags & outputMask) {
    // Pico clip bits are sticky. Clear-on-read and retain a two-second visual
    // hold so even a one-sample output over remains clearly visible.
    outputClipUntil = millis() + 2000;
    uint8_t clearedPayload[4] = {0};
    uint16_t clearedLength = 0;
    dspiGet(REQ_CLEAR_CLIPS, 0, sizeof(clearedPayload), clearedPayload,
            sizeof(clearedPayload), clearedLength, false);
  }
  return true;
}

bool readStatusU32ForMeter(uint16_t selector, uint32_t &value)
{
  uint8_t payload[4] = {0};
  uint16_t length = 0;
  if (!dspiGet(REQ_GET_STATUS, selector, 4, payload, sizeof(payload),
               length, false) || length != 4) return false;
  value = readLe32(payload);
  return true;
}

bool pollUsbMeterStreamActive()
{
  if (dspi.source != SRC_USB) return true;
  if (!dspi.connected) return false;

  const unsigned long now = millis();
  if (usbMeterActivityCheckedAt != 0 &&
      (uint32_t)(now - usbMeterActivityCheckedAt) < USB_METER_ACTIVITY_POLL_MS) {
    return usbMeterStreamActive;
  }
  usbMeterActivityCheckedAt = now;

  uint32_t packetCount = 0;
  uint32_t altSetting = 0;
  const bool packetReadOk = readStatusU32ForMeter(10, packetCount);
  const bool altReadOk = readStatusU32ForMeter(11, altSetting);

  // Alternate setting zero means the host closed the audio stream. Clear it
  // immediately rather than allowing the last processed block to remain drawn.
  if (altReadOk && altSetting == 0) {
    if (usbMeterStreamActive || analogPeakSampleValid ||
        meterLeftActive > 0.01f || meterRightActive > 0.01f) {
      clearMeterReadout("USB stream closed");
    }
    usbMeterStreamActive = false;
    if (packetReadOk) {
      usbMeterPacketCount = packetCount;
      usbMeterPacketCounterValid = true;
    }
    usbMeterLastProgressAt = now;
    return false;
  }

  if (packetReadOk) {
    if (!usbMeterPacketCounterValid) {
      // First observation is a baseline only. A later counter change proves
      // that fresh USB audio packets are reaching the Pico.
      usbMeterPacketCount = packetCount;
      usbMeterPacketCounterValid = true;
      usbMeterLastProgressAt = now;
      usbMeterStreamActive = false;
    } else if (packetCount != usbMeterPacketCount) {
      usbMeterPacketCount = packetCount;
      usbMeterLastProgressAt = now;
      usbMeterStreamActive = true;
    }
  }

  if (usbMeterPacketCounterValid &&
      (uint32_t)(now - usbMeterLastProgressAt) >= USB_METER_STALE_MS) {
    if (usbMeterStreamActive || analogPeakSampleValid ||
        meterLeftActive > 0.01f || meterRightActive > 0.01f) {
      clearMeterReadout("USB audio packets stopped");
    }
    usbMeterStreamActive = false;
  }

  return usbMeterStreamActive;
}

bool meterTransportHasFreshAudio()
{
  if (!dspi.connected) return false;
  if (dspi.source == SRC_USB) return pollUsbMeterStreamActive();
  if (isSpdifSource(dspi.source)) {
    return dspi.spdifState == 2 && !dspi.spdifNonAudio;
  }
  if (dspi.source == SRC_ADAT) return dspi.adatState == 3;

  // I2S master input has no host packet counter. Source/preset changes clear
  // the local snapshot, and fresh DSPi peak packets repopulate it.
  return true;
}

void scheduleStateRefresh(uint16_t delayMs, const char *sourceReason = "verified GET")
{
  scheduledSourceReason = sourceReason;
  delayedRefreshAt = millis() + delayMs;
}

bool setUserVolume(float value)
{
  value = constrain(value, -60.0f, 0.0f);
  if (!dspiSetFloat(REQ_SET_USER_VOLUME, value)) return false;
  dspi.volumeDb = value;
  return true;
}

bool setMasterVolumeVerified(float value)
{
  value = constrain(roundf(value * 2.0f) / 2.0f, -60.0f, 0.0f);
  if (!dspiSetFloat(REQ_SET_MASTER_VOLUME, value)) return false;

  float readback = dspi.masterVolumeDb;
  if (!dspiGetFloat(REQ_GET_MASTER_VOLUME, readback)) return false;
  if (fabsf(readback - value) > 0.26f) return false;

  dspi.masterVolumeDb = readback;
  return true;
}

bool ensureIndependentMasterVolumeModeVerified()
{
  // The panel intentionally presents Volume Limit as one device-wide safety
  // ceiling. Existing Console mode is left alone until the user applies a
  // limit here; at that point switch DSPi to its native independent mode.
  if (dspi.masterVolumeMode == 0) return true;
  if (!dspiSetByte(REQ_SET_MASTER_VOLUME_MODE, 0)) return false;

  // Mode changes are persisted by DSPi's deferred main-loop flash handler.
  // Wait through that blackout and accept only an exact verified readback.
  for (uint8_t attempt = 0; attempt < 6; attempt++) {
    delay(attempt == 0 ? 110 : 65);
    uint8_t mode = 0xFF;
    if (getExactByte(REQ_GET_MASTER_VOLUME_MODE, mode) && mode == 0) {
      dspi.masterVolumeMode = 0;
      return true;
    }
  }
  return false;
}

bool ensurePresetMasterVolumeModeVerified()
{
  // A held-OK preset save is explicitly a complete per-preset snapshot. DSPi
  // only includes Master Volume in native preset data while Mode 1 is active.
  if (dspi.masterVolumeMode == 1) return true;
  if (!dspiSetByte(REQ_SET_MASTER_VOLUME_MODE, 1)) return false;

  for (uint8_t attempt = 0; attempt < 6; attempt++) {
    delay(attempt == 0 ? 110 : 65);
    uint8_t mode = 0xFF;
    if (getExactByte(REQ_GET_MASTER_VOLUME_MODE, mode) && mode == 1) {
      dspi.masterVolumeMode = 1;
      return true;
    }
  }
  return false;
}

bool persistIndependentMasterVolumeVerified()
{
  // In mode 0 the live 0xD2 value is not a preset property. 0xD6 copies it
  // into the DSPi directory so the same safety ceiling returns after boot.
  if (dspi.masterVolumeMode != 0) return true;

  uint8_t payload[1] = {0xFF};
  uint16_t length = 0;
  if (!dspiGet(REQ_SAVE_MASTER_VOLUME, 0, 1,
               payload, sizeof(payload), length) ||
      length != 1 || payload[0] != 0) return false;

  // The action acknowledgement means accepted; the flash write is deferred.
  // Verify the directory value after the UART blackout has completed.
  for (uint8_t attempt = 0; attempt < 6; attempt++) {
    delay(attempt == 0 ? 110 : 65);
    float saved = NAN;
    if (dspiGetFloat(REQ_GET_SAVED_MASTER_VOLUME, saved) &&
        fabsf(saved - dspi.masterVolumeDb) <= 0.26f) return true;
  }
  return false;
}

bool setUserMute(bool enabled)
{
  if (!dspiSetByte(REQ_SET_USER_MUTE, enabled ? 1 : 0)) return false;
  dspi.muted = enabled;
  return true;
}

bool setUserMuteVerified(bool enabled, uint8_t attempts = 4)
{
  for (uint8_t attempt = 0; attempt < attempts; attempt++) {
    if (dspiSetByte(REQ_SET_USER_MUTE, enabled ? 1 : 0)) {
      delay(attempt == 0 ? 35 : 60);
      uint8_t readback = 0xFF;
      if (getExactByte(REQ_GET_USER_MUTE, readback) &&
          readback == (enabled ? 1 : 0)) {
        dspi.muted = enabled;
        return true;
      }
    }
    delay(35);
  }
  return false;
}

bool setInputSource(InputSource source, bool userInitiated)
{
  if ((uint8_t)source > SRC_MAX || !inputSourceAvailable(source)) return false;
  // User Volume is not changed here. The boolean is retained only to label
  // a deliberate user source selection in the deferred state-refresh log.
  if (!dspiSetByte(REQ_SET_INPUT_SOURCE, (uint8_t)source)) return false;

  // Source changes are deferred in beta5. Poll through the hardened transport
  // for about one second and publish only an exact matching one-byte readback.
  const unsigned long deadline = millis() + 1000;
  uint8_t readback = 0xFF;
  bool confirmed = false;
  do {
    if (getExactByte(REQ_GET_INPUT_SOURCE, readback) &&
        readback <= SRC_MAX && readback == (uint8_t)source) {
      confirmed = true;
      break;
    }
    if ((long)(millis() - deadline) >= 0) break;
    delay(55);
  } while ((long)(millis() - deadline) < 0);
  if (!confirmed) return false;

  InputSource oldSource = dspi.source;
  dspi.source = (InputSource)readback;
  if (oldSource != dspi.source) {
    Serial.printf("DSPi source change: old=%u new=%u reason=local SET\n",
                  (unsigned)oldSource, (unsigned)dspi.source);
  }
  dspi.spdifState = 0;
  dspi.spdifNonAudio = false;
  dspi.adatState = 0;
  resetMetersForStateChange("local input source change");
  scheduleStateRefresh(300, userInitiated ? "user source SET"
                                                 : "internal media route");
  return true;
}

void writeLe32(uint8_t *destination, uint32_t value)
{
  destination[0] = (uint8_t)value;
  destination[1] = (uint8_t)(value >> 8);
  destination[2] = (uint8_t)(value >> 16);
  destination[3] = (uint8_t)(value >> 24);
}

bool getDspiInputRates(uint32_t &currentRate, uint32_t &selectedRate)
{
  uint8_t payload[8] = {0};
  uint16_t length = 0;
  if (!dspiGet(REQ_GET_INPUT_RATE, 0, sizeof(payload), payload,
               sizeof(payload), length) ||
      length != sizeof(payload)) return false;
  currentRate = readLe32(payload);
  selectedRate = readLe32(payload + 4);
  return true;
}

bool setDspiInputRate(uint32_t sampleRate)
{
  uint8_t payload[4];
  writeLe32(payload, sampleRate);
  return dspiSet(REQ_SET_INPUT_RATE, 0, payload, sizeof(payload));
}

bool restoreDspiMediaRoute()
{
  if (!mediaRoute.captured) return true;

  mediaRouteRestorePending = true;
  bool ok = false;
  for (uint8_t attempt = 0; attempt < 4 && dspi.connected; attempt++) {
    if (attempt) delay(80);
    uint8_t liveSource = 0xFF;
    bool sourceRead = getExactByte(REQ_GET_INPUT_SOURCE, liveSource) &&
                      liveSource <= SRC_MAX;
    bool commandsOk = true;
    if (!sourceRead || liveSource != mediaRoute.source) {
      commandsOk = setInputSource(mediaRoute.source, false);
    } else {
      dspi.source = (InputSource)liveSource;
    }

    uint8_t verifiedSource = 0xFF;
    ok = commandsOk &&
         getExactByte(REQ_GET_INPUT_SOURCE, verifiedSource) &&
         verifiedSource == mediaRoute.source;
    if (ok) break;
  }

  Serial.printf("MEDIA ROUTE: restore source=%u result=%s\n",
                (unsigned)mediaRoute.source, ok ? "OK" : "FAILED");
  if (ok) {
    mediaRoute = MediaDspiRouteSnapshot{};
    mediaRouteRestorePending = false;
    mediaRouteRestoreRetryAt = 0;
  } else {
    mediaRouteRestoreRetryAt = millis() + 900;
  }
  return ok;
}

void serviceMediaRouteRestore()
{
  MediaPlaybackState playback = mediaPlayerPoc.playbackState();
  bool routeMustStayOnMedia = playback == MediaPlaybackState::Starting ||
                              playback == MediaPlaybackState::Playing ||
                              playback == MediaPlaybackState::Seeking;
  if (!mediaRouteRestorePending || routeMustStayOnMedia ||
      !mediaRoute.captured ||
      (long)(millis() - mediaRouteRestoreRetryAt) < 0) return;
  restoreDspiMediaRoute();
}

void discardPendingMediaRouteRestore(const char *reason)
{
  if (!mediaRouteRestorePending) return;
  Serial.printf("MEDIA ROUTE: pending restore discarded reason=%s\n",
                reason ? reason : "new user route");
  mediaRoute = MediaDspiRouteSnapshot{};
  mediaRouteRestorePending = false;
  mediaRouteRestoreRetryAt = 0;
}

void serviceMediaPresetRefresh()
{
  if (!mediaPresetRefreshPending ||
      (long)(millis() - mediaPresetRefreshAt) < 0) return;

  // Preset-name refresh is nonessential during transition/prefill or a low
  // audio reserve. Move it back slightly instead of competing with SD decode.
  if (mediaTrackTransitionActive() || mediaPlaybackBufferLow()) {
    mediaPresetRefreshAt = millis() + 250;
    return;
  }

  if (syncCurrentState(false)) {
    mediaPresetRefreshPending = false;
    mediaPresetRefreshAt = 0;
    mediaPresetRefreshAttempts = 0;
    if (!mediaVolumeOverlayVisible) {
      if (mediaTrackTransitionActive() || mediaPlaybackBufferLow()) {
        mediaUiDeferredFullRedraw = true;
      } else {
        redrawCurrentView();
      }
    }
    return;
  }

  if (mediaPresetRefreshAttempts < 255) mediaPresetRefreshAttempts++;
  mediaPresetRefreshAt = millis() +
      (mediaPresetRefreshAttempts < 12 ? 250 : 1000);
}

bool activateDspiMediaRoute(uint32_t sampleRate, bool userInitiated)
{
  if (!dspi.connected || (sampleRate != 44100 && sampleRate != 48000)) {
    Serial.println("MEDIA ROUTE: DSPi disconnected or rate rejected");
    return false;
  }

  uint8_t spdifConfig[2 + PANEL_MAX_SPDIF_INPUTS] = {0};
  uint16_t spdifLength = 0;
  if (!dspiGet(REQ_GET_SPDIF_INPUT_CONFIG, 0, sizeof(spdifConfig),
               spdifConfig, sizeof(spdifConfig), spdifLength) ||
      spdifLength < 3 || spdifConfig[0] < 1 ||
      (spdifConfig[1] & 0x01u) == 0) {
    Serial.println("MEDIA ROUTE: failed to read DSPi S/PDIF input 1");
    return false;
  }

  const uint8_t rxPin = spdifConfig[2];
  if (rxPin != MEDIA_PICO_SPDIF_RX_PIN) {
    Serial.printf(
        "MEDIA ROUTE: DSPi S/PDIF input 1 is GPIO%u; test wire expects GPIO%u\n",
        rxPin, MEDIA_PICO_SPDIF_RX_PIN);
    return false;
  }

  if (mediaRoute.active && mediaRoute.activeRate == sampleRate &&
      dspi.source == SRC_OPTICAL) {
    Serial.printf("MEDIA ROUTE: reused active S/PDIF %lu Hz route\n",
                  (unsigned long)sampleRate);
    return true;
  }

  mediaRoute.active = false;
  uint8_t liveSource = 0xFF;
  bool sourceKnown = getExactByte(REQ_GET_INPUT_SOURCE, liveSource) &&
                     liveSource <= SRC_MAX;
  if ((!sourceKnown || liveSource != SRC_OPTICAL) &&
      !setInputSource(SRC_OPTICAL, userInitiated)) {
    Serial.println("MEDIA ROUTE: failed to select DSPi S/PDIF input 1");
    return false;
  }

  // The transmitter starts immediately after this callback. DSPi remains in
  // ACQUIRING until the output task's valid quarter-second silence lead-in is
  // present, then its ordinary S/PDIF status polling publishes confirmed lock.
  dspi.source = SRC_OPTICAL;
  dspi.spdifState = 1;
  dspi.spdifNonAudio = false;
  dspi.sampleRate = sampleRate;
  mediaRoute.active = true;
  mediaRoute.activeRate = sampleRate;
  Serial.printf(
      "MEDIA ROUTE: selected source=S/PDIF1 expected-rate=%lu rx=GPIO%u "
      "tx=GPIO%u awaiting wire lock\n",
      (unsigned long)sampleRate, rxPin, MEDIA_SPDIF_DATA_OUT_PIN);
  return true;
}

bool prepareDspiMediaRoute(uint32_t sampleRate, bool userInitiated)
{
  if (!mediaRoute.captured) {
    if (!dspi.connected) return false;

    uint32_t currentRate = 0;
    uint32_t selectedRate = 0;
    uint8_t clockMode = 0xFF;
    uint8_t source = 0xFF;
    if (!getDspiInputRates(currentRate, selectedRate) ||
        !getExactByte(REQ_GET_I2S_CLOCK_MODE, clockMode) ||
        !getExactByte(REQ_GET_INPUT_SOURCE, source) ||
        source > SRC_MAX) {
      Serial.println("MEDIA ROUTE: failed to capture DSPi configuration");
      return false;
    }

    mediaRoute.captured = true;
    mediaRoute.active = false;
    mediaRoute.source = (InputSource)source;
    mediaRoute.selectedRate = selectedRate;
    mediaRoute.clockMode = clockMode;
    mediaRoute.rxPin = MEDIA_PICO_SPDIF_RX_PIN;
  }

  if (activateDspiMediaRoute(sampleRate, userInitiated)) return true;
  restoreDspiMediaRoute();
  return false;
}

bool mediaRouteCallback(uint32_t sampleRate, void *)
{
  return prepareDspiMediaRoute(sampleRate, true);
}

void stopMediaPlayback(const char *reason);

void clearMediaArtwork()
{
  if (mediaArtworkPixels) {
    free(mediaArtworkPixels);
    mediaArtworkPixels = nullptr;
  }
  mediaArtworkWidth = 0;
  mediaArtworkHeight = 0;
}

bool mediaArtworkWorkerCancelled(void *opaque)
{
  MediaArtworkWorkerContext *context =
      static_cast<MediaArtworkWorkerContext *>(opaque);
  if (!context || context->generation != mediaArtworkGeneration) return true;
  MediaPlaybackState playback = mediaPlayerPoc.playbackState();
  return playback == MediaPlaybackState::Stopped ||
         playback == MediaPlaybackState::Finished ||
         playback == MediaPlaybackState::Error ||
         mediaTrackTransitionActive();
}

bool mediaArtworkWorkerWaitForPermit(void *opaque)
{
  MediaArtworkWorkerContext *context =
      static_cast<MediaArtworkWorkerContext *>(opaque);
  uint32_t waitStarted = millis();

  while (!mediaArtworkWorkerCancelled(opaque)) {
    MediaPlaybackState playback = mediaPlayerPoc.playbackState();
    if (playback == MediaPlaybackState::Paused) {
      context->waitMs += millis() - waitStarted;
      return true;
    }

    const size_t capacity = mediaPlayerPoc.ringCapacityFrames();
    const size_t buffered = mediaPlayerPoc.bufferedFrames();
    const bool stateReady = playback == MediaPlaybackState::Playing ||
                            playback == MediaPlaybackState::Draining;
    const bool controlsQuiet = !mediaPlayerPoc.seeking() &&
                               !mediaPlayerPoc.externalHoldActive();
    const bool bufferReady = capacity > 0 &&
        buffered * 100ULL >=
            capacity * MEDIA_ARTWORK_IO_RESUME_PERCENT;
    if (stateReady && controlsQuiet && bufferReady) {
      context->waitMs += millis() - waitStarted;
      return true;
    }
    vTaskDelay(pdMS_TO_TICKS(8));
  }

  context->waitMs += millis() - waitStarted;
  return false;
}

bool mediaArtworkCancelled(const MediaArtworkControl &control)
{
  return control.cancelRequested &&
         control.cancelRequested(control.context);
}

bool decodeMediaArtworkAttempt(uint8_t *jpeg, size_t jpegLength,
                               MediaArtworkSource source,
                               MediaArtworkResult &result,
                               MediaArtworkControl &control)
{
  if (!jpeg || jpegLength == 0 || jpegLength > MEDIA_ARTWORK_MAX_JPEG) {
    if (jpeg) MediaPlayerPoC::freeArtworkJpeg(jpeg);
    return false;
  }

  result.jpegBytes = jpegLength;
  result.source = source;
  if (control.waitForPermit &&
      !control.waitForPermit(control.context)) {
    MediaPlayerPoC::freeArtworkJpeg(jpeg);
    return false;
  }

  if (source == MediaArtworkSource::Mp3Apic) {
    const Mp3ArtworkPolicy::JpegCoding coding =
        Mp3ArtworkPolicy::classifyApicJpeg(jpeg, jpegLength);
    if (coding != Mp3ArtworkPolicy::JpegCoding::Baseline) {
      Serial.printf("MEDIA ART: source=mp3-apic coding=%s decode=skipped\n",
                    Mp3ArtworkPolicy::jpegCodingName(coding));
      MediaPlayerPoC::freeArtworkJpeg(jpeg);
      return false;
    }
  }

  esp_jpeg_image_scale_t chosenScale = JPEG_IMAGE_SCALE_0;
  esp_jpeg_image_output_t info = {};
  bool haveInfo = false;
  const esp_jpeg_image_scale_t scales[] = {
    JPEG_IMAGE_SCALE_1_8,
    JPEG_IMAGE_SCALE_1_4,
    JPEG_IMAGE_SCALE_1_2,
    JPEG_IMAGE_SCALE_0
  };

  esp_jpeg_image_cfg_t config = {};
  config.indata = jpeg;
  config.indata_size = jpegLength;
  config.out_format = JPEG_IMAGE_FORMAT_RGB565;
  config.flags.swap_color_bytes = 0;

  for (esp_jpeg_image_scale_t scale : scales) {
    config.out_scale = scale;
    esp_jpeg_image_output_t candidate = {};
    if (esp_jpeg_get_image_info(&config, &candidate) != ESP_OK) continue;
    info = candidate;
    chosenScale = scale;
    haveInfo = true;
    if (candidate.width >= MEDIA_ARTWORK_EDGE &&
        candidate.height >= MEDIA_ARTWORK_EDGE) break;
  }

  if (!haveInfo || info.output_len == 0 ||
      info.output_len > 4U * 1024U * 1024U) {
    MediaPlayerPoC::freeArtworkJpeg(jpeg);
    return false;
  }

  uint8_t *decoded = static_cast<uint8_t *>(
      heap_caps_malloc(info.output_len, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
  if (!decoded) decoded = static_cast<uint8_t *>(malloc(info.output_len));
  if (!decoded) {
    MediaPlayerPoC::freeArtworkJpeg(jpeg);
    return false;
  }

  if (mediaArtworkCancelled(control)) {
    free(decoded);
    MediaPlayerPoC::freeArtworkJpeg(jpeg);
    return false;
  }

  config.out_scale = chosenScale;
  config.outbuf = decoded;
  config.outbuf_size = info.output_len;
  esp_jpeg_image_output_t decodedInfo = {};
  bool ok = esp_jpeg_decode(&config, &decodedInfo) == ESP_OK &&
            decodedInfo.width > 0 && decodedInfo.height > 0;
  MediaPlayerPoC::freeArtworkJpeg(jpeg);
  if (!ok) {
    free(decoded);
    return false;
  }

  result.pixels = reinterpret_cast<uint16_t *>(decoded);
  result.width = decodedInfo.width;
  result.height = decodedInfo.height;
  result.loaded = true;
  return true;
}

bool decodeMediaArtwork(const char *path, MediaArtworkResult &result,
                        MediaArtworkControl &control)
{
  result.pixels = nullptr;
  result.width = 0;
  result.height = 0;
  result.elapsedMs = 0;
  result.waitMs = 0;
  result.jpegBytes = 0;
  result.source = MediaArtworkSource::None;
  result.loaded = false;

  uint8_t *jpeg = nullptr;
  size_t jpegLength = 0;
  MediaArtworkSource source = MediaArtworkSource::None;
  if (!mediaPlayerPoc.loadArtworkJpeg(path, &jpeg, &jpegLength, &control,
                                      &source)) {
    return false;
  }

  if (decodeMediaArtworkAttempt(jpeg, jpegLength, source, result, control)) {
    return true;
  }

  if (source != MediaArtworkSource::Mp3Apic ||
      mediaArtworkCancelled(control)) {
    return false;
  }

  // One bounded fallback only. A failed APIC decode must never trigger a
  // retry loop or disturb playback; reuse the existing ring-aware folder I/O.
  Serial.println(
      "MEDIA ART: source=mp3-apic decode=failed fallback=folder-jpeg");
  jpeg = nullptr;
  jpegLength = 0;
  if (!mediaPlayerPoc.loadFolderArtworkJpeg(path, &jpeg, &jpegLength,
                                             &control)) {
    Serial.println("MEDIA ART: fallback=folder-jpeg result=unavailable");
    return false;
  }
  result.jpegBytes = 0;
  result.source = MediaArtworkSource::FolderJpeg;
  const bool loaded = decodeMediaArtworkAttempt(
      jpeg, jpegLength, MediaArtworkSource::FolderJpeg, result, control);
  Serial.printf("MEDIA ART: fallback=folder-jpeg result=%s\n",
                loaded ? "ready" : "decode-failed");
  return loaded;
}

void mediaArtworkWorker(void *)
{
  for (;;) {
    MediaArtworkJob job;
    if (!mediaArtworkJobQueue ||
        xQueueReceive(mediaArtworkJobQueue, &job, portMAX_DELAY) != pdTRUE) {
      vTaskDelay(pdMS_TO_TICKS(20));
      continue;
    }
    __atomic_store_n(&mediaArtworkWorkerBusy, true, __ATOMIC_RELEASE);

    MediaArtworkResult result;
    result.generation = job.generation;
    MediaArtworkWorkerContext context;
    context.generation = job.generation;
    MediaArtworkControl control;
    control.waitForPermit = mediaArtworkWorkerWaitForPermit;
    control.cancelRequested = mediaArtworkWorkerCancelled;
    control.context = &context;
    uint32_t startedAt = millis();
    decodeMediaArtwork(job.path, result, control);
    result.elapsedMs = millis() - startedAt;
    result.waitMs = context.waitMs;

    // A length-one result queue is latest-wins. Free an unconsumed older
    // buffer before replacing it so rapid track changes cannot leak PSRAM.
    MediaArtworkResult stale;
    if (mediaArtworkResultQueue &&
        xQueueReceive(mediaArtworkResultQueue, &stale, 0) == pdTRUE &&
        stale.pixels) {
      free(stale.pixels);
    }
    if (!mediaArtworkResultQueue ||
        xQueueOverwrite(mediaArtworkResultQueue, &result) != pdPASS) {
      if (result.pixels) free(result.pixels);
    }
    __atomic_store_n(&mediaArtworkWorkerBusy, false, __ATOMIC_RELEASE);
  }
}

bool ensureMediaArtworkWorker()
{
  if (!mediaArtworkJobQueue) {
    mediaArtworkJobQueue = xQueueCreate(1, sizeof(MediaArtworkJob));
  }
  if (!mediaArtworkResultQueue) {
    mediaArtworkResultQueue = xQueueCreate(1, sizeof(MediaArtworkResult));
  }
  if (!mediaArtworkJobQueue || !mediaArtworkResultQueue) return false;
  if (mediaArtworkTaskHandle) return true;

  BaseType_t created = xTaskCreatePinnedToCore(
      mediaArtworkWorker, "media-art", MEDIA_ARTWORK_TASK_STACK,
      nullptr, 0, &mediaArtworkTaskHandle, 1);
  if (created != pdPASS) {
    mediaArtworkTaskHandle = nullptr;
    return false;
  }
  return true;
}

void cancelMediaArtworkRequest(bool clearCurrentArtwork)
{
  mediaArtworkGeneration++;
  mediaArtworkRequestPending = false;
  mediaArtworkJobSubmitted = false;
  mediaArtworkPendingPath[0] = '\0';
  mediaArtworkRedrawPending = false;
  if (mediaArtworkJobQueue) xQueueReset(mediaArtworkJobQueue);
  if (clearCurrentArtwork) clearMediaArtwork();
}

void scheduleMediaArtwork(const char *path)
{
  cancelMediaArtworkRequest(true);
  if (!path || !path[0] || !ensureMediaArtworkWorker()) return;

  mediaArtworkGeneration++;
  strlcpy(mediaArtworkPendingPath, path, sizeof(mediaArtworkPendingPath));
  mediaArtworkNotBefore = millis() + MEDIA_ARTWORK_DELAY_MS;
  mediaArtworkRequestPending = true;
  mediaArtworkJobSubmitted = false;
  Serial.printf("MEDIA ART: deferred generation=%lu path=%s\n",
                (unsigned long)mediaArtworkGeneration,
                mediaArtworkPendingPath);
}

bool mediaPlaybackBufferLow()
{
  MediaPlaybackState playback = mediaPlayerPoc.playbackState();
  if (playback != MediaPlaybackState::Playing &&
      playback != MediaPlaybackState::Draining) {
    return false;
  }
  const size_t capacity = mediaPlayerPoc.ringCapacityFrames();
  if (!capacity) return false;
  const size_t threshold = std::max<size_t>(
      2048, (capacity * MEDIA_LOW_RING_PERCENT) / 100);
  return mediaPlayerPoc.bufferedFrames() < threshold;
}

void serviceMediaArtwork()
{
  MediaArtworkResult result;
  while (mediaArtworkResultQueue &&
         xQueueReceive(mediaArtworkResultQueue, &result, 0) == pdTRUE) {
    if (result.generation != mediaArtworkGeneration ||
        strcmp(mediaArtworkPendingPath, mediaCurrentPath) != 0) {
      if (result.pixels) free(result.pixels);
      continue;
    }

    mediaArtworkRequestPending = false;
    mediaArtworkJobSubmitted = false;
    clearMediaArtwork();
    if (result.loaded && result.pixels) {
      mediaArtworkPixels = result.pixels;
      mediaArtworkWidth = result.width;
      mediaArtworkHeight = result.height;
      Serial.printf(
          "MEDIA ART: JPEG %ux%u ready generation=%lu source=%s bytes=%u "
          "elapsed=%lu ms wait=%lu ms\n",
          mediaArtworkWidth, mediaArtworkHeight,
          (unsigned long)result.generation,
          MediaPlayerPoC::artworkSourceName(result.source),
          (unsigned)result.jpegBytes,
          (unsigned long)result.elapsedMs,
          (unsigned long)result.waitMs);
    } else {
      Serial.printf(
          "MEDIA ART: unavailable generation=%lu source=%s elapsed=%lu ms "
          "wait=%lu ms\n",
          (unsigned long)result.generation,
          MediaPlayerPoC::artworkSourceName(result.source),
          (unsigned long)result.elapsedMs,
          (unsigned long)result.waitMs);
    }

    if (uiView == VIEW_MEDIA_NOW_PLAYING && !mediaVolumeOverlayVisible) {
      if (mediaPlaybackBufferLow()) {
        mediaArtworkRedrawPending = true;
      } else {
        drawMediaArtworkRegion();
      }
    }
  }

  if (mediaArtworkRequestPending && !mediaArtworkJobSubmitted &&
      (long)(millis() - mediaArtworkNotBefore) >= 0 &&
      !mediaTrackTransitionActive() &&
      uiView == VIEW_MEDIA_NOW_PLAYING) {
    const size_t capacity = mediaPlayerPoc.ringCapacityFrames();
    const size_t buffered = mediaPlayerPoc.bufferedFrames();
    MediaPlaybackState playback = mediaPlayerPoc.playbackState();
    const bool stateReady = playback == MediaPlaybackState::Playing ||
                            playback == MediaPlaybackState::Paused;
    const bool bufferReady = capacity > 0 &&
        buffered * 100ULL >= capacity * MEDIA_ARTWORK_MIN_RING_PERCENT;
    if (stateReady && bufferReady && mediaArtworkJobQueue) {
      MediaArtworkJob job;
      job.generation = mediaArtworkGeneration;
      strlcpy(job.path, mediaArtworkPendingPath, sizeof(job.path));
      if (xQueueOverwrite(mediaArtworkJobQueue, &job) == pdPASS) {
        mediaArtworkJobSubmitted = true;
        Serial.printf(
            "MEDIA ART: worker start generation=%lu ring=%u/%u\n",
            (unsigned long)job.generation, (unsigned)buffered,
            (unsigned)capacity);
      }
    }
  }

  if (mediaArtworkRedrawPending && !mediaPlaybackBufferLow() &&
      uiView == VIEW_MEDIA_NOW_PLAYING && !mediaVolumeOverlayVisible) {
    mediaArtworkRedrawPending = false;
    drawMediaArtworkRegion();
  }
}

void serviceMediaDeferredRedraw()
{
  if (!mediaUiDeferredFullRedraw || mediaPlaybackBufferLow() ||
      mediaPlayerPoc.seeking() || mediaTrackTransitionActive()) {
    return;
  }
  mediaUiDeferredFullRedraw = false;
  redrawCurrentView();
}

bool startMediaPlaybackPrepared(const char *path,
                                bool preserveRouteOnFailure)
{
  if (!path || !path[0] ||
      mediaPlayerPoc.playbackState() != MediaPlaybackState::Stopped) {
    return false;
  }
  mediaRouteRestorePending = false;
  mediaRouteRestoreRetryAt = 0;

  bool started = mediaPlayerPoc.play(
      path, MEDIA_SPDIF_DATA_OUT_PIN, mediaRouteCallback, nullptr, Serial);
  if (started) {
    strlcpy(mediaCurrentPath, path, sizeof(mediaCurrentPath));
    mediaPlaybackSuspended = false;
  } else if (!preserveRouteOnFailure) {
    restoreDspiMediaRoute();
  }
  return started;
}

bool startMediaPlaybackAttempt(const char *path, bool preserveRouteOnFailure,
                               bool reloadArtwork)
{
  if (!path || !path[0]) return false;
  mediaTrackTransition = MediaTrackTransitionState{};
  if (mediaPlayerPoc.playbackState() != MediaPlaybackState::Stopped) {
    mediaPlayerPoc.stop();
  }
  if (mediaPlayerPoc.playbackState() != MediaPlaybackState::Stopped) {
    return false;
  }

  clearMediaRejection();
  bool started = startMediaPlaybackPrepared(path, preserveRouteOnFailure);
  if (started && reloadArtwork) {
    scheduleMediaArtwork(path);
  } else if (!started) {
    if (reloadArtwork) cancelMediaArtworkRequest(true);
    recordMediaRejection(path, mediaPlaybackFailureToast());
  }
  return started;
}

bool startMediaPlayback(const char *path)
{
  return startMediaPlaybackAttempt(path, false, true);
}

String mediaPlaybackFailureToast()
{
  const char *reason = mediaPlayerPoc.playbackError();
  if (!reason || !reason[0]) return "Music error";
  if (strcmp(reason, "header probe failed") == 0) {
    return "Audio header rejected";
  }
  if (strcmp(reason, "decoder rejected the file") == 0) {
    return "Decoder rejected file";
  }
  if (strncmp(reason, "unsupported sample rate ", 24) == 0) {
    const uint32_t rate = strtoul(reason + 24, nullptr, 10);
    if (rate) return String("Unsupported: ") + sampleRateTextFor(rate);
    return "Maximum supported is 48 kHz";
  }
  if (strcmp(reason, "only native 44.1/48 kHz files are accepted") == 0) {
    return "Maximum supported is 48 kHz";
  }
  if (strcmp(reason,
             "requires mono/stereo 16/24-bit WAV/FLAC or MP3") == 0) {
    return "Unsupported depth/channels";
  }
  if (strcmp(reason, "decoder produced no PCM frames") == 0) {
    return "No audio frames";
  }
  return "Music error";
}

void clearMediaRejection()
{
  mediaLastRejectedPath[0] = '\0';
  mediaLastRejectedReason[0] = '\0';
  mediaLastRejectedActive = false;
}

void recordMediaRejection(const char *path, const String &reason)
{
  strlcpy(mediaLastRejectedPath, path && path[0] ? path : "(unknown file)",
          sizeof(mediaLastRejectedPath));
  reason.toCharArray(mediaLastRejectedReason, sizeof(mediaLastRejectedReason));
  mediaLastRejectedActive = true;
}

bool mediaTrackTransitionActive()
{
  return mediaTrackTransition.phase != MediaTrackTransitionPhase::Idle;
}

bool moveMediaTransitionCandidate()
{
  if (mediaQueueCount == 0 || mediaTrackTransition.direction == 0) return false;
  int next = mediaTrackTransition.candidateIndex +
             (mediaTrackTransition.direction > 0 ? 1 : -1);
  if (mediaTrackTransition.wrap) {
    if (next < 0) next = mediaQueueCount - 1;
    if (next >= mediaQueueCount) next = 0;
  } else if (next < 0 || next >= mediaQueueCount) {
    return false;
  }
  mediaTrackTransition.candidateIndex = next;
  strlcpy(mediaTrackTransition.displayPath, mediaQueuePaths[next],
          sizeof(mediaTrackTransition.displayPath));
  return true;
}

bool requestMediaTrackTransition(int candidateIndex, int direction, bool wrap,
                                 bool skipRejected, bool autoAdvance,
                                 bool preserveRouteOnFailure)
{
  if (candidateIndex < 0 || candidateIndex >= mediaQueueCount) return false;

  cancelMediaArtworkRequest(true);
  clearMediaRejection();
  mediaTrackTransition = MediaTrackTransitionState{};
  mediaTrackTransition.phase = MediaTrackTransitionPhase::WaitForStop;
  mediaTrackTransition.candidateIndex = candidateIndex;
  mediaTrackTransition.direction = direction < 0 ? -1 :
                                   (direction > 0 ? 1 : 0);
  mediaTrackTransition.wrap = wrap;
  mediaTrackTransition.skipRejected = skipRejected;
  mediaTrackTransition.autoAdvance = autoAdvance;
  mediaTrackTransition.preserveRouteOnFailure = preserveRouteOnFailure;
  mediaTrackTransition.attempts = 0;
  mediaTrackTransition.startedAt = millis();
  strlcpy(mediaTrackTransition.displayPath,
          mediaQueuePaths[candidateIndex],
          sizeof(mediaTrackTransition.displayPath));

  mediaPlayerPoc.requestStop();
  Serial.printf(
      "MEDIA TRANSITION: queued index=%d direction=%d auto=%s path=%s\n",
      candidateIndex, (int)mediaTrackTransition.direction,
      autoAdvance ? "yes" : "no", mediaTrackTransition.displayPath);
  if (uiView == VIEW_MEDIA_NOW_PLAYING && !mediaVolumeOverlayVisible) {
    drawMediaNowPlaying();
  }
  return true;
}

void cancelMediaTrackTransition()
{
  if (!mediaTrackTransitionActive()) return;
  Serial.printf("MEDIA TRANSITION: cancelled path=%s\n",
                mediaTrackTransition.displayPath[0]
                    ? mediaTrackTransition.displayPath : "(none)");
  mediaTrackTransition = MediaTrackTransitionState{};
}

void serviceMediaTrackTransition()
{
  if (!mediaTrackTransitionActive()) return;

  if ((uint32_t)(millis() - mediaTrackTransition.startedAt) >=
      MEDIA_TRANSITION_TIMEOUT_MS) {
    Serial.printf("MEDIA TRANSITION: timeout phase=%u path=%s\n",
                  (unsigned)mediaTrackTransition.phase,
                  mediaTrackTransition.displayPath[0]
                      ? mediaTrackTransition.displayPath : "(none)");
    recordMediaRejection(mediaTrackTransition.displayPath,
                         "Track change timed out");
    mediaPlayerPoc.requestStop();
    if (mediaTrackTransition.phase ==
        MediaTrackTransitionPhase::FailureCleanup) {
      mediaTerminalFinalizePending = true;
      mediaTerminalFinalizeState = MediaPlaybackState::Error;
      mediaTrackTransition = MediaTrackTransitionState{};
      showToast("Track change timed out", 2400);
      return;
    }
    mediaTrackTransition.phase = MediaTrackTransitionPhase::FailureCleanup;
    mediaTrackTransition.startedAt = millis();
  }

  auto finishStarted = [&](int candidate) {
    const uint32_t elapsed = millis() - mediaTrackTransition.startedAt;
    const bool autoAdvance = mediaTrackTransition.autoAdvance;
    mediaQueueIndex = (int8_t)candidate;
    clearMediaRejection();
    scheduleMediaArtwork(mediaQueuePaths[candidate]);
    mediaTrackTransition = MediaTrackTransitionState{};
    Serial.printf(
        "MEDIA TRANSITION: complete index=%d elapsed=%lu ms auto=%s\n",
        candidate, (unsigned long)elapsed,
        autoAdvance ? "yes" : "no");
    if (uiView == VIEW_MEDIA_NOW_PLAYING && !mediaVolumeOverlayVisible) {
      drawMediaNowPlaying();
    }
  };

  auto handleRejected = [&](int candidate) {
    mediaTrackTransition.attempts++;
    Serial.printf("MEDIA TRANSITION: rejected index=%d path=%s reason=%s\n",
                  candidate, mediaQueuePaths[candidate],
                  mediaPlayerPoc.playbackError());
    mediaPlayerPoc.requestStop();

    if (mediaTrackTransition.skipRejected &&
        mediaTrackTransition.attempts < mediaQueueCount &&
        moveMediaTransitionCandidate()) {
      mediaTrackTransition.phase = MediaTrackTransitionPhase::WaitForStop;
      if (uiView == VIEW_MEDIA_NOW_PLAYING && !mediaVolumeOverlayVisible) {
        drawMediaNowPlaying();
      }
      return;
    }
    mediaTrackTransition.phase = MediaTrackTransitionPhase::FailureCleanup;
  };

  if (mediaTrackTransition.phase == MediaTrackTransitionPhase::WaitForStop) {
    if (!mediaPlayerPoc.serviceStopCleanup()) return;
    mediaTrackTransition.phase = MediaTrackTransitionPhase::StartCandidate;
    return;
  }

  if (mediaTrackTransition.phase == MediaTrackTransitionPhase::StartCandidate) {
    const int candidate = mediaTrackTransition.candidateIndex;
    if (candidate < 0 || candidate >= mediaQueueCount) {
      mediaTrackTransition.phase = MediaTrackTransitionPhase::FailureCleanup;
      return;
    }

    mediaRouteRestorePending = false;
    mediaRouteRestoreRetryAt = 0;
    bool prepared = mediaPlayerPoc.beginPlay(
        mediaQueuePaths[candidate], MEDIA_SPDIF_DATA_OUT_PIN,
        mediaRouteCallback, nullptr, Serial);
    if (!prepared) {
      handleRejected(candidate);
      return;
    }

    mediaTrackTransition.phase = MediaTrackTransitionPhase::WaitForStart;
    Serial.printf("MEDIA TRANSITION: cooperative prefill index=%d path=%s\n",
                  candidate, mediaQueuePaths[candidate]);
    return;
  }

  if (mediaTrackTransition.phase == MediaTrackTransitionPhase::WaitForStart) {
    const int candidate = mediaTrackTransition.candidateIndex;
    if (candidate < 0 || candidate >= mediaQueueCount) {
      mediaPlayerPoc.requestStop();
      mediaTrackTransition.phase = MediaTrackTransitionPhase::FailureCleanup;
      return;
    }

    MediaStartStatus status = mediaPlayerPoc.servicePlayStart(Serial, 2);
    if (status == MediaStartStatus::Preparing) return;
    if (status == MediaStartStatus::Started) {
      strlcpy(mediaCurrentPath, mediaQueuePaths[candidate],
              sizeof(mediaCurrentPath));
      mediaPlaybackSuspended = false;
      finishStarted(candidate);
      return;
    }

    handleRejected(candidate);
    return;
  }

  if (mediaTrackTransition.phase == MediaTrackTransitionPhase::FailureCleanup) {
    if (!mediaPlayerPoc.serviceStopCleanup()) return;
    String toast = mediaLastRejectedActive
                       ? String(mediaLastRejectedReason)
                       : mediaPlaybackFailureToast();
    recordMediaRejection(mediaTrackTransition.displayPath, toast);
    MediaPlaybackState discardedTerminal = MediaPlaybackState::Stopped;
    while (mediaPlayerPoc.takeTerminalEvent(discardedTerminal)) {}
    restoreDspiMediaRoute();
    mediaTrackTransition = MediaTrackTransitionState{};
    showToast(toast, 6000);
    if (uiView == VIEW_MEDIA_NOW_PLAYING) drawMediaNowPlaying();
    else if (mediaPlaybackBufferLow()) mediaUiDeferredFullRedraw = true;
    else redrawCurrentView();
  }
}

void stopMediaPlayback(const char *reason)
{
  cancelMediaTrackTransition();
  cancelMediaArtworkRequest(true);
  if (mediaPlayerPoc.playbackState() != MediaPlaybackState::Stopped) {
    mediaPlayerPoc.printPlaybackStatus(Serial);
    mediaPlayerPoc.stop();
  }
  restoreDspiMediaRoute();
  mediaCurrentPath[0] = '\0';
  mediaPlaybackSuspended = false;
  mediaQueueIndex = -1;
  mediaQueueCount = 0;
  Serial.printf("MEDIA PLAY: stopped reason=%s\n",
                reason ? reason : "user");
}

void parkMediaPlayback(const char *reason)
{
  cancelMediaTrackTransition();
  cancelMediaArtworkRequest(false);
  if (mediaPlayerPoc.playbackState() != MediaPlaybackState::Stopped) {
    mediaPlayerPoc.printPlaybackStatus(Serial);
    mediaPlayerPoc.stop();
  }
  restoreDspiMediaRoute();
  mediaPlaybackSuspended = mediaCurrentPath[0] != '\0';
  Serial.printf("MEDIA PLAY: parked-at-start reason=%s path=%s\n",
                reason ? reason : "user",
                mediaCurrentPath[0] ? mediaCurrentPath : "(none)");
}

bool playMediaQueueIndex(int index)
{
  return requestMediaTrackTransition(index, 0, false, false, false, false);
}

bool skipMediaTrack(int direction, bool wrap)
{
  if (mediaQueueCount == 0 || direction == 0) return false;
  const int step = direction > 0 ? 1 : -1;
  int base = mediaTrackTransitionActive()
      ? mediaTrackTransition.candidateIndex : mediaQueueIndex;
  int next = base + step;
  if (wrap) {
    if (next < 0) next = mediaQueueCount - 1;
    if (next >= mediaQueueCount) next = 0;
  } else if (next < 0 || next >= mediaQueueCount) {
    return false;
  }
  return requestMediaTrackTransition(next, step, wrap, true, false, true);
}

bool toggleMediaPause()
{
  if (mediaTrackTransitionActive()) return false;
  MediaPlaybackState state = mediaPlayerPoc.playbackState();
  if (state == MediaPlaybackState::Playing) {
    if (!mediaPlayerPoc.togglePause()) return false;
    mediaPlaybackSuspended = true;
    // Restore the prior physical source while paused, but treat this as an
    // internal route transition so the listener's volume is preserved.
    restoreDspiMediaRoute();
    Serial.printf("MEDIA PLAY: paused in place frame=%llu path=%s\n",
                  (unsigned long long)mediaPlayerPoc.playbackStats().outputFrames,
                  mediaCurrentPath[0] ? mediaCurrentPath : "(none)");
    if (uiView == VIEW_MEDIA_NOW_PLAYING) drawMediaNowPlaying();
    else redrawCurrentView();
    return true;
  }

  if (state == MediaPlaybackState::Paused) {
    MediaFileInfo info = mediaPlayerPoc.playbackFile();
    // Resume the existing decoder and I2S channel. Re-entering the Media route
    // is internal and must not overwrite the listener's current User Volume.
    if (!prepareDspiMediaRoute(info.sampleRate, false)) return false;
    if (!mediaPlayerPoc.togglePause()) {
      restoreDspiMediaRoute();
      return false;
    }
    mediaPlaybackSuspended = false;
    Serial.printf("MEDIA PLAY: resumed in place frame=%llu path=%s\n",
                  (unsigned long long)mediaPlayerPoc.playbackStats().outputFrames,
                  mediaCurrentPath[0] ? mediaCurrentPath : "(none)");
    if (uiView == VIEW_MEDIA_NOW_PLAYING) drawMediaNowPlaying();
    else redrawCurrentView();
    return true;
  }

  if (state == MediaPlaybackState::Seeking) return false;
  if (!mediaCurrentPath[0]) return false;

  if (mediaQueueIndex >= 0 && mediaQueueIndex < mediaQueueCount) {
    return requestMediaTrackTransition(mediaQueueIndex, 0, false, false,
                                       false, false);
  }

  char path[sizeof(mediaCurrentPath)] = {0};
  strlcpy(path, mediaCurrentPath, sizeof(path));
  if (!startMediaPlaybackAttempt(path, false, false)) return false;
  Serial.printf("MEDIA PLAY: restarted from beginning path=%s\n", path);
  if (uiView == VIEW_MEDIA_NOW_PLAYING) drawMediaNowPlaying();
  else redrawCurrentView();
  return true;
}

uint16_t mediaSeekStepSeconds()
{
  static const uint16_t steps[] = {5, 10, 30};
  return steps[std::min<uint8_t>(mediaSeekStepIndex, 2)];
}

bool seekMediaRelative(int direction, uint16_t seconds)
{
  if (mediaTrackTransitionActive() || !mediaPlayerPoc.active() ||
      direction == 0 || seconds == 0) return false;

  MediaFileInfo info = mediaPlayerPoc.playbackFile();
  MediaPlaybackStats stats = mediaPlayerPoc.playbackStats();
  if (!info.sampleRate || !mediaCurrentPath[0]) return false;

  const uint64_t currentFrame = stats.outputFrames;
  const uint64_t deltaFrames = (uint64_t)seconds * info.sampleRate;
  uint64_t targetFrame = currentFrame;
  if (direction < 0) {
    targetFrame = currentFrame > deltaFrames
                    ? currentFrame - deltaFrames : 0;
  } else if (UINT64_MAX - currentFrame > deltaFrames) {
    targetFrame = currentFrame + deltaFrames;
  }
  if (info.totalFrames > 0) {
    targetFrame = std::min<uint64_t>(targetFrame, info.totalFrames - 1);
  }
  if (targetFrame == currentFrame) return true;

  Serial.printf("MEDIA SEEK: direction=%d seconds=%u from=%llu to=%llu\n",
                direction, (unsigned)seconds,
                (unsigned long long)currentFrame,
                (unsigned long long)targetFrame);

  mediaSeekPreviewVisible = false;
  mediaSeekPreviewDirection = 0;
  mediaSeekPreviewSeconds = 0;

  // Put the static status on screen before waking the decoder task. This is the
  // only display transfer made for the exact seek and avoids LCD/SD contention
  // while dr_flac is searching the stream.
  mediaSeekUiPending = true;
  if (uiView == VIEW_MEDIA_NOW_PLAYING) drawMediaNowPlaying();

  bool accepted = mediaPlayerPoc.requestSeek(targetFrame);
  mediaSeekUiPending = false;
  if (!accepted && uiView == VIEW_MEDIA_NOW_PLAYING) drawMediaNowPlaying();
  return accepted;
}

void serviceMediaSeek()
{
  MediaSeekEvent event;
  while (mediaPlayerPoc.takeSeekEvent(event)) {
    const char *result = event.result == MediaSeekResult::Completed
        ? "complete" : (event.result == MediaSeekResult::Failed
        ? "failed" : "cancelled");
    Serial.printf(
        "MEDIA SEEK EVENT: result=%s generation=%lu requested=%llu "
        "actual=%llu elapsed=%lu ms\n",
        result, (unsigned long)event.generation,
        (unsigned long long)event.requestedFrame,
        (unsigned long long)event.actualFrame,
        (unsigned long)event.elapsedMs);

    if (event.result == MediaSeekResult::Failed) {
      showToast("Seek unavailable", 1100);
    }
    if (uiView == VIEW_MEDIA_NOW_PLAYING && !mediaVolumeOverlayVisible) {
      drawMediaNowPlaying();
    } else if (event.result == MediaSeekResult::Failed) {
      redrawCurrentView();
    }
  }
}

void serviceMediaPlayback()
{
  // Terminal cleanup is intentionally cooperative. The decoder task is woken
  // once, then each main-loop pass checks whether both media tasks have left.
  // This keeps BLE, encoder and screen service alive during album transitions.
  if (mediaTerminalFinalizePending) {
    if (!mediaPlayerPoc.serviceStopCleanup()) return;

    MediaPlaybackState terminal = mediaTerminalFinalizeState;
    mediaTerminalFinalizePending = false;
    mediaTerminalFinalizeState = MediaPlaybackState::Stopped;
    restoreDspiMediaRoute();
    mediaPlaybackSuspended = mediaCurrentPath[0] != '\0';
    showToast(terminal == MediaPlaybackState::Error
                  ? "Media error" : "Album finished");
    if (uiView == VIEW_MEDIA_NOW_PLAYING) drawMediaNowPlaying();
    else redrawCurrentView();
    return;
  }

  // A transition owns any temporary Error/Draining state it creates while
  // skipping an unsupported queue entry. Do not consume that terminal event.
  if (mediaTrackTransitionActive()) return;

  MediaPlaybackState terminal = MediaPlaybackState::Stopped;
  if (!mediaPlayerPoc.takeTerminalEvent(terminal)) return;

  mediaPlayerPoc.printPlaybackStatus(Serial);
  Serial.printf("MEDIA PLAY: terminal=%s\n",
                MediaPlayerPoC::stateName(terminal));

  if (terminal == MediaPlaybackState::Finished &&
      mediaQueueIndex >= 0 && mediaQueueIndex + 1 < mediaQueueCount &&
      requestMediaTrackTransition(mediaQueueIndex + 1, 1, false, true,
                                  true, true)) {
    Serial.println("MEDIA PLAY: cooperative next-track transition queued");
    return;
  }

  mediaTerminalFinalizeState = terminal;
  mediaTerminalFinalizePending = true;
  mediaPlayerPoc.requestStop();
}

void printMediaPlaybackStatus()
{
  mediaPlayerPoc.printPlaybackStatus(Serial);
  Serial.printf("LOOP STACK: size=%lu free=%u bytes\n",
                (unsigned long)getArduinoLoopTaskStackSize(),
                (unsigned)(uxTaskGetStackHighWaterMark(nullptr)));
  if (!dspi.connected) {
    Serial.println("MEDIA ROUTE STATUS: DSPi disconnected");
    return;
  }
  uint32_t currentRate = 0;
  uint32_t selectedRate = 0;
  uint8_t clockMode = 0xFF;
  uint8_t rxPin = 0xFF;
  bool ok = getDspiInputRates(currentRate, selectedRate) &&
            getExactByte(REQ_GET_I2S_CLOCK_MODE, clockMode) &&
            getExactByte(REQ_GET_I2S_RX_PIN, rxPin, 0);
  if (ok) {
    Serial.printf(
        "MEDIA ROUTE STATUS: source=%u current=%lu selected=%lu mode=%u "
        "pico_rx=GPIO%u\n",
        (unsigned)dspi.source, (unsigned long)currentRate,
        (unsigned long)selectedRate, clockMode, rxPin);
  } else {
    Serial.println("MEDIA ROUTE STATUS: readback failed");
  }
}


void buildMediaQueue(uint8_t selectedEntry)
{
  mediaQueueCount = 0;
  mediaQueueIndex = -1;
  strlcpy(mediaQueueDirectory, mediaBrowserPath, sizeof(mediaQueueDirectory));
  mediaQueuePageAnchorValid = mediaBrowserPageAnchorValid;
  if (mediaQueuePageAnchorValid) {
    mediaQueuePageFirst = mediaBrowserPageFirst;
  } else {
    mediaQueuePageFirst = MediaBrowserEntry{};
  }

  for (uint8_t i = 0; i < mediaBrowserEntryCount &&
                      mediaQueueCount < MEDIA_QUEUE_MAX_ENTRIES; i++) {
    if (mediaBrowserEntries[i].directory) continue;
    strlcpy(mediaQueuePaths[mediaQueueCount],
            mediaBrowserEntries[i].path,
            sizeof(mediaQueuePaths[mediaQueueCount]));
    if (i == selectedEntry) mediaQueueIndex = (int8_t)mediaQueueCount;
    mediaQueueCount++;
  }
}

bool mediaBrowserShowsActions()
{
  // Now Playing and Playback Settings are navigation actions, not filesystem
  // entries. Show them only at the top of the first root page. Re-inserting
  // them on every 96-entry page made them appear halfway through large album
  // libraries (for example at entries 143-184).
  return mediaBrowserDepth == 0 && strcmp(mediaBrowserPath, "/") == 0 &&
         mediaBrowserFirstEntryIndex == 0 && !mediaBrowserHasPreviousPage;
}

uint8_t mediaBrowserActionOffset()
{
  if (!mediaBrowserShowsActions()) return 0;
  uint8_t count = mediaCurrentPath[0] ? 1 : 0;
  if (mediaPlayerPoc.mounted()) count++;
  return count + 1;  // Wi-Fi Transfer is always the final root action.
}

bool mediaBrowserItemIsNowPlaying(uint8_t itemIndex)
{
  return mediaBrowserShowsActions() && itemIndex == 0 && mediaCurrentPath[0];
}

bool mediaBrowserItemIsSettings(uint8_t itemIndex)
{
  return mediaPlayerPoc.mounted() && mediaBrowserShowsActions() &&
          itemIndex == (mediaCurrentPath[0] ? 1 : 0);
}

bool mediaBrowserItemIsWifiTransfer(uint8_t itemIndex)
{
  if (!mediaBrowserShowsActions()) return false;
  uint8_t wifiIndex = mediaCurrentPath[0] ? 1 : 0;
  if (mediaPlayerPoc.mounted()) wifiIndex++;
  return itemIndex == wifiIndex;
}


uint8_t mediaBrowserItemCount()
{
  uint8_t count = mediaBrowserEntryCount + mediaBrowserActionOffset();
  // Preserve the normal read-only SD probe action when the card has not yet
  // mounted; Wi-Fi Transfer is a separate item and must not replace it.
  if (!mediaPlayerPoc.mounted() && mediaBrowserShowsActions()) count++;
  return count ? count : 1;
}

int16_t mediaBrowserEntryIndex(uint8_t itemIndex)
{
  uint8_t offset = mediaBrowserActionOffset();
  if (itemIndex < offset) return -1;
  int16_t entryIndex = (int16_t)itemIndex - offset;
  return entryIndex >= 0 && entryIndex < mediaBrowserEntryCount
           ? entryIndex : -1;
}

void resetMediaMarquee()
{
  mediaMarqueeIdentity = "";
  mediaMarqueeStartedAt = millis();
  mediaMarqueeLastFrameAt = 0;
  mediaMarqueeOffset = 0;
  mediaMarqueeComplete = false;
}

bool makeMediaBrowserAnchor(const char *path, bool directory,
                            MediaBrowserEntry &anchor)
{
  anchor.path[0] = '\0';
  anchor.name[0] = '\0';
  anchor.directory = false;
  anchor.format = MediaFileFormat::Unknown;
  if (!path || !path[0] || strlen(path) >= sizeof(anchor.path)) return false;
  const char *slash = strrchr(path, '/');
  const char *name = slash ? slash + 1 : path;
  if (!name[0] || strlen(name) >= sizeof(anchor.name)) return false;
  strlcpy(anchor.path, path, sizeof(anchor.path));
  strlcpy(anchor.name, name, sizeof(anchor.name));
  anchor.directory = directory;
  return true;
}

bool loadMediaBrowserPage(MediaDirectoryPageMode mode,
                          const MediaBrowserEntry *anchor,
                          bool resetSelection)
{
  MediaDirectoryPageInfo pageInfo;
  mediaBrowserEntryCount = (uint8_t)std::min<size_t>(
      mediaPlayerPoc.listDirectoryPage(
          mediaBrowserPath, mediaBrowserEntries, MEDIA_UI_PAGE_ENTRIES,
          mode, anchor, pageInfo),
      MEDIA_UI_PAGE_ENTRIES);
  mediaBrowserScanned = true;
  mediaBrowserHasPreviousPage = pageInfo.hasPrevious;
  mediaBrowserHasNextPage = pageInfo.hasNext;
  mediaBrowserFirstEntryIndex = pageInfo.firstEntryIndex;
  mediaBrowserTotalEntries = pageInfo.totalEntries;
  mediaBrowserSkippedLongPaths = pageInfo.skippedLongPaths;
  mediaBrowserPageAnchorValid = mediaBrowserEntryCount > 0;
  if (mediaBrowserPageAnchorValid) {
    mediaBrowserPageFirst = mediaBrowserEntries[0];
    mediaBrowserPageLast = mediaBrowserEntries[mediaBrowserEntryCount - 1];
  } else {
    mediaBrowserPageFirst = MediaBrowserEntry{};
    mediaBrowserPageLast = MediaBrowserEntry{};
  }

  Serial.printf(
      "MEDIA BROWSER: path=%s mounted=%s window=%lu-%lu total=%lu "
      "entries=%u previous=%s next=%s scanned=%lu skipped-long=%lu "
      "skipped-unsupported=%lu skipped-hidden=%lu\n",
      mediaBrowserPath, mediaPlayerPoc.mounted() ? "yes" : "no",
      mediaBrowserEntryCount
        ? (unsigned long)(mediaBrowserFirstEntryIndex + 1) : 0UL,
      (unsigned long)(mediaBrowserFirstEntryIndex + mediaBrowserEntryCount),
      (unsigned long)mediaBrowserTotalEntries,
      (unsigned)mediaBrowserEntryCount,
      mediaBrowserHasPreviousPage ? "yes" : "no",
      mediaBrowserHasNextPage ? "yes" : "no",
      (unsigned long)pageInfo.rawEntriesScanned,
      (unsigned long)mediaBrowserSkippedLongPaths,
      (unsigned long)pageInfo.skippedUnsupportedFiles,
      (unsigned long)pageInfo.skippedHiddenEntries);

  if (resetSelection) {
    menuIndex = 0;
    mediaBrowserTopRow = 0;
  }
  menuIndex = std::min<uint8_t>(menuIndex, mediaBrowserItemCount() - 1);
  resetMediaMarquee();
  return mediaBrowserEntryCount > 0 || mediaBrowserTotalEntries == 0;
}

void refreshMediaBrowser(bool resetSelection)
{
  loadMediaBrowserPage(MediaDirectoryPageMode::First, nullptr,
                       resetSelection);
}

bool loadNextMediaBrowserPage()
{
  if (!mediaBrowserHasNextPage || !mediaBrowserPageAnchorValid) return false;
  mediaBrowserAnchorScratch = mediaBrowserPageLast;
  if (!loadMediaBrowserPage(MediaDirectoryPageMode::After,
                            &mediaBrowserAnchorScratch, true) ||
      mediaBrowserEntryCount == 0) {
    refreshMediaBrowser(true);
    return false;
  }
  menuIndex = mediaBrowserActionOffset();
  mediaBrowserTopRow = 0;
  resetMediaMarquee();
  return true;
}

bool loadPreviousMediaBrowserPage()
{
  if (!mediaBrowserHasPreviousPage || !mediaBrowserPageAnchorValid) return false;
  mediaBrowserAnchorScratch = mediaBrowserPageFirst;
  if (!loadMediaBrowserPage(MediaDirectoryPageMode::Before,
                            &mediaBrowserAnchorScratch, true) ||
      mediaBrowserEntryCount == 0) {
    refreshMediaBrowser(true);
    return false;
  }
  menuIndex = mediaBrowserActionOffset() + mediaBrowserEntryCount - 1;
  mediaBrowserTopRow = menuIndex >= MEDIA_UI_VISIBLE_ROWS
      ? menuIndex - MEDIA_UI_VISIBLE_ROWS + 1 : 0;
  resetMediaMarquee();
  return true;
}

bool restoreMediaBrowserPage(const MediaBrowserEntry *firstEntry,
                             bool anchorValid)
{
  if (!anchorValid || !firstEntry) {
    return loadMediaBrowserPage(MediaDirectoryPageMode::First, nullptr, true);
  }
  if (loadMediaBrowserPage(MediaDirectoryPageMode::AtOrAfter,
                           firstEntry, true) &&
      mediaBrowserEntryCount > 0) {
    return true;
  }
  return loadMediaBrowserPage(MediaDirectoryPageMode::First, nullptr, true);
}

bool loadMediaBrowserPageContaining(const char *path, bool directory)
{
  if (!makeMediaBrowserAnchor(path, directory,
                              mediaBrowserAnchorScratch)) return false;
  if (loadMediaBrowserPage(MediaDirectoryPageMode::AtOrBefore,
                           &mediaBrowserAnchorScratch, true) &&
      mediaBrowserEntryCount > 0) {
    return true;
  }
  return loadMediaBrowserPage(MediaDirectoryPageMode::First, nullptr, true);
}

void enterMediaFolder(const char *path)
{
  if (!path || !path[0] || mediaBrowserDepth >= MEDIA_UI_MAX_DEPTH) {
    showToast("Folder depth limit");
    drawMenu();
    return;
  }

  MediaBrowserFrame &frame = mediaBrowserStack[mediaBrowserDepth++];
  strlcpy(frame.path, mediaBrowserPath, sizeof(frame.path));
  strlcpy(frame.childPath, path, sizeof(frame.childPath));
  frame.selected = menuIndex;
  frame.topRow = mediaBrowserTopRow;
  frame.pageAnchorValid = mediaBrowserPageAnchorValid;
  if (frame.pageAnchorValid) frame.pageFirst = mediaBrowserPageFirst;
  else frame.pageFirst = MediaBrowserEntry{};
  strlcpy(mediaBrowserPath, path, sizeof(mediaBrowserPath));
  refreshMediaBrowser(true);
  drawMenu();
}

bool leaveMediaFolder()
{
  if (mediaBrowserDepth == 0) return false;
  MediaBrowserFrame &frame = mediaBrowserStack[--mediaBrowserDepth];
  strlcpy(mediaBrowserPath, frame.path, sizeof(mediaBrowserPath));
  restoreMediaBrowserPage(&frame.pageFirst, frame.pageAnchorValid);
  menuIndex = std::min<uint8_t>(frame.selected, mediaBrowserItemCount() - 1);
  uint8_t offset = mediaBrowserActionOffset();
  bool childFound = false;
  for (uint8_t i = 0; i < mediaBrowserEntryCount; i++) {
    if (strcmp(mediaBrowserEntries[i].path, frame.childPath) == 0) {
      menuIndex = offset + i;
      childFound = true;
      break;
    }
  }
  if (!childFound && loadMediaBrowserPageContaining(frame.childPath, true)) {
    offset = mediaBrowserActionOffset();
    for (uint8_t i = 0; i < mediaBrowserEntryCount; i++) {
      if (strcmp(mediaBrowserEntries[i].path, frame.childPath) == 0) {
        menuIndex = offset + i;
        break;
      }
    }
  }
  mediaBrowserTopRow = std::min<uint8_t>(frame.topRow, menuIndex);
  resetMediaMarquee();
  drawMenu();
  return true;
}

void rebuildMediaBrowserStackForPath(const char *targetPath)
{
  mediaBrowserDepth = 0;
  if (!targetPath || !targetPath[0] || strcmp(targetPath, "/") == 0) {
    strlcpy(mediaBrowserPath, "/", sizeof(mediaBrowserPath));
    return;
  }

  char current[MEDIA_FS_PATH_CAPACITY] = "/";
  const char *cursor = targetPath;
  while (*cursor == '/') cursor++;
  while (*cursor && mediaBrowserDepth < MEDIA_UI_MAX_DEPTH) {
    const char *slash = strchr(cursor, '/');
    size_t segmentLength = slash ? (size_t)(slash - cursor)
                                 : strlen(cursor);
    if (segmentLength == 0) break;

    char child[MEDIA_FS_PATH_CAPACITY] = {0};
    strlcpy(child, current, sizeof(child));
    if (strcmp(child, "/") != 0) strlcat(child, "/", sizeof(child));
    size_t used = strlen(child);
    size_t copyLength = std::min(segmentLength,
        sizeof(child) - used - 1);
    memcpy(child + used, cursor, copyLength);
    child[used + copyLength] = '\0';

    MediaBrowserFrame &frame = mediaBrowserStack[mediaBrowserDepth++];
    strlcpy(frame.path, current, sizeof(frame.path));
    strlcpy(frame.childPath, child, sizeof(frame.childPath));
    frame.selected = 0;
    frame.topRow = 0;
    frame.pageAnchorValid = false;
    frame.pageFirst = MediaBrowserEntry{};
    strlcpy(current, child, sizeof(current));

    if (!slash) break;
    cursor = slash + 1;
  }
  strlcpy(mediaBrowserPath, targetPath, sizeof(mediaBrowserPath));
}

void restoreMediaBrowserToQueueTrack()
{
  rebuildMediaBrowserStackForPath(mediaQueueDirectory);
  strlcpy(mediaBrowserPath, mediaQueueDirectory, sizeof(mediaBrowserPath));

  bool loaded = restoreMediaBrowserPage(&mediaQueuePageFirst,
                                        mediaQueuePageAnchorValid);
  uint8_t offset = mediaBrowserActionOffset();
  bool trackFound = false;
  if (loaded) {
    for (uint8_t i = 0; i < mediaBrowserEntryCount; i++) {
      if (!mediaBrowserEntries[i].directory &&
          strcmp(mediaBrowserEntries[i].path, mediaCurrentPath) == 0) {
        menuIndex = offset + i;
        trackFound = true;
        break;
      }
    }
  }

  if (!trackFound && mediaCurrentPath[0] &&
      loadMediaBrowserPageContaining(mediaCurrentPath, false)) {
    offset = mediaBrowserActionOffset();
    for (uint8_t i = 0; i < mediaBrowserEntryCount; i++) {
      if (!mediaBrowserEntries[i].directory &&
          strcmp(mediaBrowserEntries[i].path, mediaCurrentPath) == 0) {
        menuIndex = offset + i;
        trackFound = true;
        break;
      }
    }
  }

  if (!trackFound) menuIndex = 0;
  mediaBrowserTopRow = menuIndex > 2 ? menuIndex - 2 : 0;
  resetMediaMarquee();
}

void transitionToMediaNowPlaying()
{
  fadeUiOut();
  mediaVolumeOverlayVisible = false;
  uiView = VIEW_MEDIA_NOW_PLAYING;
  if (mediaPlayerPoc.active() && !mediaArtworkPixels &&
      !mediaArtworkRequestPending && mediaCurrentPath[0]) {
    scheduleMediaArtwork(mediaCurrentPath);
  }
  drawMediaNowPlaying();
  fadeUiIn();
}

void selectMediaMenuItem()
{
  if (mediaBrowserItemIsNowPlaying(menuIndex)) {
    transitionToMediaNowPlaying();
    return;
  }
  if (mediaBrowserItemIsSettings(menuIndex)) {
    enterPage(PAGE_MEDIA_SETTINGS);
    return;
  }
  if (mediaBrowserItemIsWifiTransfer(menuIndex)) {
    beginWifiTransferConfirmation();
    return;
  }

  if (!mediaPlayerPoc.mounted()) {
    showToast("Checking SD card...", 900);
    drawMenu();
    bool mounted = mediaPlayerPoc.mountCard();
    mediaPlayerPoc.printCardSummary(Serial);
    mediaBrowserScanned = false;
    if (mounted) {
      bool audioReady = mediaPlayerPoc.prepareAudioBuffer();
      if (!ensureMediaArtworkWorker()) {
        Serial.println("MEDIA ART: worker unavailable; fallback artwork only");
      }
      strlcpy(mediaBrowserPath, "/", sizeof(mediaBrowserPath));
      mediaBrowserDepth = 0;
      refreshMediaBrowser(true);
      showToast(audioReady ? "SD card ready" : "Audio buffer failed", 1200);
    } else {
      showToast("No SD card inserted", 1800);
    }
    drawMenu();
    return;
  }
  int16_t entryIndex = mediaBrowserEntryIndex(menuIndex);
  if (entryIndex < 0) {
    refreshMediaBrowser(true);
    if (mediaBrowserEntryCount) {
      showToast("SD refreshed");
    } else {
      showToast("Folder has no playable files", 1600);
    }
    drawMenu();
    return;
  }

  MediaBrowserEntry &entry = mediaBrowserEntries[entryIndex];
  if (entry.directory) {
    enterMediaFolder(entry.path);
    return;
  }

  buildMediaQueue((uint8_t)entryIndex);
  if (mediaQueueIndex >= 0 && playMediaQueueIndex(mediaQueueIndex)) {
    transitionToMediaNowPlaying();
  } else {
    showToast(mediaPlaybackFailureToast(), 2000);
    drawMenu();
  }
}

bool loadPreset(uint8_t slot, bool announce)
{
  if (!dspi.connected || slot >= 10 || mediaTrackTransitionActive() ||
      mediaPlayerPoc.seeking()) {
    return false;
  }

  const bool mediaWasActive = mediaPlayerPoc.active();
  const uint32_t mediaRate = mediaPlayerPoc.playbackFile().sampleRate;
  const bool originalMute = dspi.muted;
  const float originalMasterVolume = dspi.masterVolumeDb;
  const uint8_t originalSlot = dspi.activePreset;
  const bool holdAcquired = mediaPlayerPoc.beginExternalHold(800);
  if (!holdAcquired) {
    Serial.println("PRESET TX: refused; Media output could not become quiescent");
    return false;
  }

  showToast("Applying preset safely...", 1800);
  if (uiView == VIEW_MENU) drawMenu();
  Serial.printf(
      "PRESET TX: begin slot=%u media=%s original_master=%.1f mute=%s "
      "firmware=%u.%u.%u mode=%u\n",
      (unsigned)slot, mediaWasActive ? "yes" : "no",
      originalMasterVolume, originalMute ? "yes" : "no",
      (unsigned)dspi.firmwareMajor, (unsigned)(dspi.firmwareMinorPatchBcd >> 4),
      (unsigned)(dspi.firmwareMinorPatchBcd & 0x0F),
      (unsigned)dspi.masterVolumeMode);

  auto releaseHoldIfVerifiedSafe = [&](bool preferredStateRestored,
                                       const char *reason) -> bool {
    if (preferredStateRestored) {
      mediaPlayerPoc.endExternalHold();
      return true;
    }

    // A transaction whose result is unknown is allowed to release the I2S hold
    // only after both independent guards have exact readback. Otherwise the
    // hold remains latched until a physical reset; this is deliberately safer
    // than claiming the output is muted when UART verification failed.
    const bool masterGuard = setMasterVolumeVerified(-60.0f);
    const bool muteGuard = setUserMuteVerified(true);
    if (masterGuard && muteGuard) {
      mediaPlayerPoc.endExternalHold();
      Serial.printf("PRESET TX: safe muted fallback reason=%s\n",
                    reason ? reason : "unknown");
      showToast("Preset failed - muted", 2200);
      return true;
    }

    Serial.printf(
        "PRESET TX: SAFETY HOLD RETAINED slot=%u reason=%s master_guard=%s "
        "mute_guard=%s; power cycle required\n",
        (unsigned)slot, reason ? reason : "unknown",
        masterGuard ? "OK" : "FAILED", muteGuard ? "OK" : "FAILED");
    showToast("Preset failed - output held", 2600);
    return false;
  };

  auto restoreOriginalAndRelease = [&](const char *reason) -> bool {
    const bool masterRestored = setMasterVolumeVerified(originalMasterVolume);
    const bool muteRestored = setUserMuteVerified(originalMute);
    return releaseHoldIfVerifiedSafe(masterRestored && muteRestored, reason);
  };

  auto failAfterPossibleAcceptance = [&](const char *reason) {
    releaseHoldIfVerifiedSafe(false, reason);
    Serial.printf("PRESET TX: FAILED slot=%u reason=%s hold=%s\n",
                  (unsigned)slot, reason ? reason : "unknown",
                  mediaPlayerPoc.externalHoldActive() ? "retained" : "released-safe");
  };

  // Keep the output muted and the independent master ceiling clamped while
  // DSPi swaps the preset snapshot. User Volume is intentionally not written:
  // the value stored in the selected preset is the source of truth.
  const bool preMasterGuard = setMasterVolumeVerified(-60.0f);
  const bool preMuteGuard = setUserMuteVerified(true);
  if (!preMasterGuard || !preMuteGuard) {
    restoreOriginalAndRelease("pre-load guard verification");
    Serial.println("PRESET TX: unable to establish pre-load guards");
    return false;
  }

  uint8_t payload[2] = {0};
  uint16_t length = 0;
  DspiTxnResult loadResult = dspiGetResult(
      REQ_PRESET_LOAD, slot, 1, payload, sizeof(payload), length, true);
  bool requestAccepted = loadResult == DSPI_TXN_OK &&
                         length == 1 && payload[0] == 0;

  // A lost response does not prove the command was rejected. Query the active
  // slot under the already-established guards before deciding whether it is
  // safe to restore the old state.
  if (!requestAccepted) {
    uint8_t observedSlot = 0xFF;
    bool slotRead = false;
    for (uint8_t attempt = 0; attempt < 10; attempt++) {
      delay(attempt == 0 ? 120 : 60);
      if (getExactByte(REQ_PRESET_GET_ACTIVE, observedSlot)) {
        slotRead = true;
        if (observedSlot == slot || observedSlot == originalSlot) break;
      }
    }

    if (slotRead && observedSlot == slot) {
      requestAccepted = true;
      Serial.printf("PRESET TX: recovered ambiguous request result=%s; "
                    "target slot is active\n",
                    dspiTxnResultText(loadResult));
    } else if (slotRead && observedSlot == originalSlot) {
      restoreOriginalAndRelease("load request not applied");
      Serial.printf("PRESET TX: load not applied result=%s status=%u len=%u\n",
                    dspiTxnResultText(loadResult),
                    length ? payload[0] : 0xFF, length);
      return false;
    } else {
      failAfterPossibleAcceptance("ambiguous load request state");
      return false;
    }
  }

  bool activeConfirmed = false;
  uint8_t restoredSource = 0xFF;
  uint8_t restoredClockMode = 0xFF;
  uint32_t currentRate = 0;
  uint32_t selectedRate = 0;
  for (uint8_t attempt = 0; attempt < 18; attempt++) {
    delay(attempt == 0 ? 170 : 60);
    uint8_t activeSlot = 0xFF;
    if (!getExactByte(REQ_PRESET_GET_ACTIVE, activeSlot) ||
        activeSlot != slot) {
      continue;
    }
    activeConfirmed = true;
    if (!mediaWasActive || !mediaRoute.captured) break;
    if (getExactByte(REQ_GET_INPUT_SOURCE, restoredSource) &&
        restoredSource <= SRC_MAX &&
        getExactByte(REQ_GET_I2S_CLOCK_MODE, restoredClockMode) &&
        getDspiInputRates(currentRate, selectedRate)) {
      break;
    }
    activeConfirmed = false;
  }
  if (!activeConfirmed) {
    failAfterPossibleAcceptance("active preset/readback timeout");
    return false;
  }

  const bool postMasterGuard = setMasterVolumeVerified(-60.0f);
  const bool postMuteGuard = setUserMuteVerified(true);
  if (!postMasterGuard || !postMuteGuard) {
    failAfterPossibleAcceptance("post-load guard verification");
    return false;
  }

  if (mediaWasActive && mediaRoute.captured) {
    mediaRoute.source = (InputSource)restoredSource;
    mediaRoute.selectedRate = selectedRate;
    mediaRoute.clockMode = restoredClockMode;
    dspi.source = (InputSource)restoredSource;
    dspi.activePreset = slot;
    if (!activateDspiMediaRoute(mediaRate, false)) {
      failAfterPossibleAcceptance("media S/PDIF route reassert");
      mediaPlayerPoc.stop();
      mediaCurrentPath[0] = '\0';
      mediaPlaybackSuspended = false;
      return false;
    }
  } else {
    discardPendingMediaRouteRestore("preset load");
    dspi.activePreset = slot;
  }

  // Read the preset-owned User Volume twice around the late-restore window.
  float restoredUserVolume = NAN;
  if (!dspiGetFloat(REQ_GET_USER_VOLUME, restoredUserVolume) ||
      !isfinite(restoredUserVolume) || restoredUserVolume < -60.01f ||
      restoredUserVolume > 0.01f) {
    failAfterPossibleAcceptance("preset user-volume readback");
    return false;
  }
  delay(120);
  float lateUserVolume = NAN;
  if (!setUserMuteVerified(true) ||
      !dspiGetFloat(REQ_GET_USER_VOLUME, lateUserVolume) ||
      !isfinite(lateUserVolume) || lateUserVolume < -60.01f ||
      lateUserVolume > 0.01f) {
    failAfterPossibleAcceptance("late preset user-volume readback");
    return false;
  }
  dspi.volumeDb = lateUserVolume;

  const bool masterRestored = setMasterVolumeVerified(originalMasterVolume);
  const bool muteRestored = setUserMuteVerified(originalMute);
  if (!masterRestored || !muteRestored) {
    failAfterPossibleAcceptance("guard release verification");
    return false;
  }

  mediaPlayerPoc.endExternalHold();
  mediaPresetRefreshPending = false;
  pendingPresetOverlay = false;
  applyPresetPanelSettings(slot, true);
  resetMetersForStateChange("preset transaction complete");
  scheduleStateRefresh(180, "preset transaction refresh");
  if (announce) {
    showPresetChangeOverlay(slot);
  } else {
    // A load initiated from the Preset list is an in-place selection. Keep
    // the list visible and let its accent dot publish the verified active slot.
    menuPage = PAGE_PRESET;
    menuIndex = slot;
    rememberedMenuIndex[PAGE_PRESET] = slot;
    editActive = false;
    uiView = VIEW_MENU;
    drawMenu();
  }
  Serial.printf("PRESET TX: complete slot=%u preset_volume=%.1f restored_master=%.1f "
                "mute=%s\n",
                (unsigned)slot, dspi.volumeDb, dspi.masterVolumeDb,
                dspi.muted ? "yes" : "no");
  return true;
}

bool saveCurrentPreset(uint8_t destinationSlot)
{
  if (!dspi.connected || destinationSlot >= 10 ||
      mediaPlayerPoc.active() || presetSaveCompletionPending) return false;

  if (!ensurePresetMasterVolumeModeVerified()) {
    Serial.println("PRESET SAVE: unable to enable preset-scoped Master Volume");
    return false;
  }

  uint8_t payload[1] = {0xFF};
  uint16_t length = 0;
  const DspiTxnResult saveResult = dspiGetResult(
      REQ_PRESET_SAVE, destinationSlot, 1,
      payload, sizeof(payload), length, true);
  if (saveResult != DSPI_TXN_OK || length != 1 || payload[0] != 0) {
    Serial.printf("PRESET SAVE: rejected destination=P%u transport=%s "
                  "length=%u status=0x%02X\n",
                  (unsigned)destinationSlot + 1U,
                  dspiTxnResultText(saveResult), (unsigned)length,
                  length ? payload[0] : 0xFF);
    return false;
  }

  // The DSPi command captures feature parameters and User Volume (the volume
  // restored when this slot loads at startup), plus Master Volume in Mode 1.
  // The companion ESP32 record binds Theme and Screen Settings to that slot.
  presetSavePanelSettingsOk = savePresetPanelSettings(destinationSlot);

  // DSPi performs the flash write in its main loop. Reconnect and refresh the
  // directory after the blackout instead of issuing more traffic immediately.
  presetSaveCompletionPending = true;
  presetSaveCompletionAttempts = 0;
  presetSaveCompletionSlot = destinationSlot;
  presetSaveCompletionAt = millis() + PRESET_SAVE_REFRESH_MS;
  Serial.printf("PRESET SAVE: accepted destination=P%u panel=%s\n",
                (unsigned)destinationSlot + 1U,
                presetSavePanelSettingsOk ? "OK" : "FAILED");
  return true;
}

bool setLoudness(bool enabled)
{
  if (!dspiSetByte(REQ_SET_LOUDNESS, enabled ? 1 : 0)) return false;
  dspi.loudnessEnabled = enabled;
  return true;
}

bool setLoudnessReference(float value)
{
  value = constrain(value, 40.0f, 100.0f);
  if (!dspiSetFloat(REQ_SET_LOUDNESS_REFERENCE, value)) return false;
  dspi.loudnessReferenceSpl = value;
  return true;
}

