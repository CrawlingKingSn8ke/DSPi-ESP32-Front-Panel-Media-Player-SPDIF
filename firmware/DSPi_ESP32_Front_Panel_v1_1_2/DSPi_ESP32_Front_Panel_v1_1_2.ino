void serviceDeferredPreferences()
{
  uint32_t flags;
  unsigned long notBefore;
  portENTER_CRITICAL(&deferredPreferenceMux);
  flags = deferredPreferenceFlags;
  notBefore = deferredPreferenceNotBefore;
  portEXIT_CRITICAL(&deferredPreferenceMux);
  if (!flags || (long)(millis() - notBefore) < 0) return;

  // Never start a flash/NVS write during audio transitions, seek, low-buffer
  // recovery, or while NimBLE owns its connection worker. This turns several
  // first-boot writes into one bounded main-loop transaction.
  if (mediaPlayerPoc.active() || mediaTrackTransitionActive() ||
      mediaPlayerPoc.seeking() || mediaPlaybackBufferLow()) return;
  if ((uint32_t)(millis() - lastUserActivityAt) < 1200U) return;
#if DSPI_HAVE_NIMBLE
  const bool removalWritePending = (flags & PREF_DIRTY_BLE_REMOVE) != 0;
  if (bleConnectTaskRunning || (uiView == VIEW_BLE && !removalWritePending)) return;
  if (bleRemovalInProgress && !removalWritePending) return;
#endif

  // Pairing produces two records. Persist the peer identity first so a power
  // interruption cannot leave durable key mappings without a reconnectable
  // remote profile. Remaining categories are deliberately one transaction per
  // pass to keep each cache-disabled flash window bounded.
  uint32_t selected = (flags & PREF_DIRTY_BLE_REMOVE)
      ? PREF_DIRTY_BLE_REMOVE
      : (flags & PREF_DIRTY_BLE_DEVICE)
      ? PREF_DIRTY_BLE_DEVICE
      : (flags & PREF_DIRTY_BLE_MAPPINGS)
          ? PREF_DIRTY_BLE_MAPPINGS
          : (flags & PREF_DIRTY_HOME_SHORTCUTS)
              ? PREF_DIRTY_HOME_SHORTCUTS
              : PREF_DIRTY_PANEL_SETTINGS;
  uint32_t startedAt = millis();
  bool ok = false;
  bool terminalFailure = false;
  if (selected == PREF_DIRTY_BLE_REMOVE) {
#if DSPI_HAVE_NIMBLE
    preferences.remove("ble_name");
    preferences.remove("ble_addr");
    preferences.remove("ble_type");
    preferences.remove("ble_maps");
    preferences.remove("ble_map_ver");
    preferences.remove("ble_ver");
    ok = !preferences.isKey("ble_name") && !preferences.isKey("ble_addr") &&
         !preferences.isKey("ble_type") && !preferences.isKey("ble_maps") &&
         !preferences.isKey("ble_map_ver") && !preferences.isKey("ble_ver");
    if (bleRemovalNvsAttempts != UINT8_MAX) bleRemovalNvsAttempts++;
    terminalFailure = !ok && bleRemovalNvsAttempts >= 3;
    bleRemovalNvsSucceeded = ok;
    bleRemovalNvsComplete = ok || terminalFailure;
#else
    ok = true;
    bleRemovalNvsSucceeded = true;
    bleRemovalNvsComplete = true;
#endif
  } else if (selected == PREF_DIRTY_HOME_SHORTCUTS) {
    size_t bytes = preferences.putBytes("home_sc", homeShortcuts,
                                        sizeof(homeShortcuts));
    ok = bytes == sizeof(homeShortcuts) &&
         preferences.putUChar("home_sc_ver", HOME_SHORTCUT_VERSION) == 1;
  } else if (selected == PREF_DIRTY_BLE_MAPPINGS) {
    size_t bytes = preferences.putBytes("ble_maps", remoteMap,
                                        sizeof(remoteMap));
    ok = bytes == sizeof(remoteMap) &&
         preferences.putUChar("ble_map_ver", BLE_MAPPING_VERSION) == 1;
  } else if (selected == PREF_DIRTY_BLE_DEVICE) {
#if DSPI_HAVE_NIMBLE
    size_t nameBytes = preferences.putString("ble_name", bleSavedName);
    size_t addrBytes = preferences.putString("ble_addr", bleSavedAddress);
    ok = nameBytes == strlen(bleSavedName) &&
         addrBytes == strlen(bleSavedAddress) &&
         preferences.putUChar("ble_type", bleSavedAddressType) == 1 &&
         preferences.putUChar("ble_ver", BLE_PROFILE_VERSION) == 1;
#else
    ok = true;
#endif
  } else if (selected == PREF_DIRTY_PANEL_SETTINGS) {
    ok = preferences.putUChar("brightness", brightnessPercent) == 1 &&
         preferences.putUChar("screen_to", screenTimeoutOption) == 1 &&
         preferences.putUChar("screen_dim", screenDimPercent) == 1 &&
         preferences.putUChar("screen_act", screenTimeoutAction) == 1 &&
         preferences.putUChar("media_seek", mediaSeekStepIndex) == 1 &&
         preferences.putUChar("media_set_ver", MEDIA_SETTINGS_VERSION) == 1 &&
         persistThemePreferencesNow();
  }

  portENTER_CRITICAL(&deferredPreferenceMux);
  if (ok || terminalFailure) deferredPreferenceFlags &= ~selected;
  deferredPreferenceNotBefore = millis() + (ok ? 400 : 1000);
  portEXIT_CRITICAL(&deferredPreferenceMux);
  const char *preferenceResult = ok ? "OK" :
      (terminalFailure ? "FAILED-FINAL" : "FAILED");
  Serial.printf("NVS DEFERRED: flag=0x%02lX result=%s elapsed=%lu ms\n",
                (unsigned long)selected, preferenceResult,
                (unsigned long)(millis() - startedAt));
}

// -----------------------------------------------------------------------------
// Exclusive Wi-Fi music-transfer lifecycle
// -----------------------------------------------------------------------------

const char *wifiTransferPhaseName(WifiTransferPhase phase)
{
  switch (phase) {
    case WifiTransferPhase::Normal: return "Normal";
    case WifiTransferPhase::StopMedia: return "StopMedia";
    case WifiTransferPhase::WaitArtwork: return "WaitArtwork";
    case WifiTransferPhase::RestoreRoute: return "RestoreRoute";
    case WifiTransferPhase::FlushPreferences: return "FlushPreferences";
    case WifiTransferPhase::ReleaseNormalAccess: return "ReleaseNormalAccess";
    case WifiTransferPhase::ConfirmWriteAccess: return "ConfirmWriteAccess";
    case WifiTransferPhase::ProbeReadWrite: return "ProbeReadWrite";
    case WifiTransferPhase::StopBle: return "StopBle";
    case WifiTransferPhase::StartNetwork: return "StartNetwork";
    case WifiTransferPhase::Active: return "Active";
    case WifiTransferPhase::StopAcceptance: return "StopAcceptance";
    case WifiTransferPhase::WaitForQuiescent: return "WaitForQuiescent";
    case WifiTransferPhase::SyncTransfer: return "SyncTransfer";
    case WifiTransferPhase::RestoreNormalAccess: return "RestoreNormalAccess";
    case WifiTransferPhase::StopNetwork: return "StopNetwork";
    case WifiTransferPhase::ValidateNormalAccess: return "ValidateNormalAccess";
    case WifiTransferPhase::RestartBle: return "RestartBle";
    case WifiTransferPhase::Complete: return "Complete";
    case WifiTransferPhase::RecoveryError: return "RecoveryError";
    default: return "Unknown";
  }
}

bool wifiTransferExclusive()
{
  return wifiTransferPhase != WifiTransferPhase::Normal;
}

bool wifiTransferExitInProgress()
{
  switch (wifiTransferPhase) {
    case WifiTransferPhase::StopAcceptance:
    case WifiTransferPhase::WaitForQuiescent:
    case WifiTransferPhase::SyncTransfer:
    case WifiTransferPhase::RestoreNormalAccess:
    case WifiTransferPhase::StopNetwork:
    case WifiTransferPhase::ValidateNormalAccess:
    case WifiTransferPhase::RestartBle:
    case WifiTransferPhase::Complete:
    case WifiTransferPhase::RecoveryError:
      return true;
    default:
      return false;
  }
}

bool wifiTransferPhaseTimedOut(uint32_t timeoutMs)
{
  return timeoutMs != 0U &&
         (uint32_t)(millis() - wifiTransferPhaseStartedAt) >= timeoutMs;
}

void setWifiTransferUiText(char *destination, size_t capacity,
                           const char *text)
{
  if (!destination || capacity == 0U) return;
  strlcpy(destination, text ? text : "", capacity);
}

void setWifiTransferPhase(WifiTransferPhase next, const char *status)
{
  const WifiTransferPhase previous = wifiTransferPhase;
  wifiTransferPhase = next;
  wifiTransferPhaseStartedAt = millis();
  wifiTransferPhaseActionIssued = false;
  wifiTransferRetryAt = 0;
  wifiTransferRetryCount = 0;
  if (status) setWifiTransferUiText(
      wifiTransferUiStatus, sizeof(wifiTransferUiStatus), status);
  wifiTransferUiUpdatedAt = 0;
  Serial.printf("WIFI XFER: lifecycle %s -> %s%s%s\n",
                wifiTransferPhaseName(previous),
                wifiTransferPhaseName(next),
                status && status[0] ? " status=" : "",
                status && status[0] ? status : "");
  if (uiView == VIEW_WIFI_TRANSFER_ACTIVE) drawWifiTransferScreen();
}

void markWifiTransferFailure(const char *reason)
{
  const char *safeReason = reason && reason[0]
      ? reason : "Wi-Fi transfer lifecycle failed";
  if (!wifiTransferExitWasRecovery || !wifiTransferUiError[0]) {
    setWifiTransferUiText(wifiTransferUiError,
                          sizeof(wifiTransferUiError), safeReason);
  }
  wifiTransferExitWasRecovery = true;
  setWifiTransferUiText(wifiTransferUiStatus,
                        sizeof(wifiTransferUiStatus),
                        "Recovering safely");
  Serial.printf("WIFI XFER: failure phase=%s reason=%s\n",
                wifiTransferPhaseName(wifiTransferPhase), safeReason);
}

void requestWifiTransferSafeExit(const char *reason)
{
  if (wifiTransferPhase == WifiTransferPhase::Normal ||
      wifiTransferPhase == WifiTransferPhase::Complete) {
    return;
  }
  if (reason && reason[0] && !wifiTransferExitReason[0]) {
    strlcpy(wifiTransferExitReason, reason,
            sizeof(wifiTransferExitReason));
  }
  if (wifiTransferExitInProgress()) return;
  Serial.printf("WIFI XFER: safe exit requested reason=%s recovery=%s\n",
                reason && reason[0] ? reason : "requested",
                wifiTransferExitWasRecovery ? "yes" : "no");
  setWifiTransferPhase(WifiTransferPhase::StopAcceptance,
                       "Finishing transfer safely");
}

void beginWifiTransferRecovery(const char *reason)
{
  markWifiTransferFailure(reason);
  requestWifiTransferSafeExit(reason);
}

void clearWifiTransferCredentials()
{
  memset(wifiTransferUiSsid, 0, sizeof(wifiTransferUiSsid));
  memset(wifiTransferUiPassword, 0, sizeof(wifiTransferUiPassword));
  memset(wifiTransferUiIp, 0, sizeof(wifiTransferUiIp));
}

void resetWifiTransferSessionState()
{
  wifiTransferExitWasRecovery = false;
  wifiTransferNormalAccessReleased = false;
  wifiTransferWriteAccessActive = false;
  wifiTransferNetworkStarted = false;
  wifiTransferPhaseActionIssued = false;
  wifiTransferLastSyncOk = true;
  wifiTransferNormalAccessRestoreOk = true;
  wifiTransferBleRestartOk = true;
  wifiTransferBleShutdownStarted = false;
  wifiTransferFilesystemSyncRequested = false;
  wifiTransferNetworkStopRequested = false;
  wifiTransferArtworkQuietSince = 0;
  wifiTransferRetryAt = 0;
  wifiTransferRetryCount = 0;
  wifiTransferUiRedrawPending = false;
  wifiTransferUiRedrawRetryAt = 0;
  wifiTransferExitReason[0] = '\0';
  wifiTransferUiError[0] = '\0';
  wifiTransferUiProgress[0] = '\0';
  clearWifiTransferCredentials();
  wifiTransferSnapshot = WifiTransferSnapshot{};
}

void requestWifiTransferEntry()
{
  WifiTransferSnapshot snapshot;
  wifiTransferMode.snapshot(snapshot);
  if (wifiTransferPhase != WifiTransferPhase::Normal ||
      snapshot.active || !snapshot.networkStopped) {
    setWifiTransferUiText(wifiTransferUiError,
                          sizeof(wifiTransferUiError),
                          "Transfer service is still busy");
    drawWifiTransferError();
    return;
  }

  // Clear an earlier task-allocation/preflight error workspace only when the
  // controller proves that no task, request or writer can still own it.
  if (!wifiTransferMode.discardPreparedState()) {
    setWifiTransferUiText(wifiTransferUiError,
                          sizeof(wifiTransferUiError),
                          "Transfer cleanup is still active");
    drawWifiTransferError();
    return;
  }

  resetWifiTransferSessionState();
  setWifiTransferUiText(wifiTransferUiStatus,
                        sizeof(wifiTransferUiStatus),
                        "Stopping playback");
  setWifiTransferPhase(WifiTransferPhase::StopMedia,
                       "Stopping playback");
  fadeUiOut();
  drawWifiTransferScreen();
  fadeUiIn();
  Serial.printf(
      "WIFI XFER: entry requested heap=%lu psram=%lu loop_stack_min=%lu\n",
      static_cast<unsigned long>(ESP.getFreeHeap()),
      static_cast<unsigned long>(ESP.getFreePsram()),
      static_cast<unsigned long>(
          uxTaskGetStackHighWaterMark(nullptr)));
}

uint32_t pendingDeferredPreferenceFlags()
{
  uint32_t flags = 0;
  portENTER_CRITICAL(&deferredPreferenceMux);
  flags = deferredPreferenceFlags;
  portEXIT_CRITICAL(&deferredPreferenceMux);
  return flags;
}

void clearStoppedMediaForTransfer()
{
  MediaPlaybackState terminal = MediaPlaybackState::Stopped;
  while (mediaPlayerPoc.takeTerminalEvent(terminal)) {}
  MediaSeekEvent seekEvent;
  while (mediaPlayerPoc.takeSeekEvent(seekEvent)) {}

  mediaTrackTransition = MediaTrackTransitionState{};
  mediaTerminalFinalizePending = false;
  mediaUiDeferredFullRedraw = false;
  mediaPresetRefreshPending = false;
  mediaCurrentPath[0] = '\0';
  mediaQueueCount = 0;
  mediaQueueIndex = -1;
  mediaQueueDirectory[0] = '/';
  mediaQueueDirectory[1] = '\0';
  mediaQueuePageAnchorValid = false;
  mediaQueuePageFirst = MediaBrowserEntry{};
  mediaPlaybackSuspended = false;
  clearMediaRejection();
}

void invalidateMediaBrowserAfterTransfer()
{
  mediaBrowserEntryCount = 0;
  strlcpy(mediaBrowserPath, "/", sizeof(mediaBrowserPath));
  mediaBrowserDepth = 0;
  mediaBrowserTopRow = 0;
  mediaBrowserScanned = false;
  mediaBrowserHasPreviousPage = false;
  mediaBrowserHasNextPage = false;
  mediaBrowserFirstEntryIndex = 0;
  mediaBrowserTotalEntries = 0;
  mediaBrowserSkippedLongPaths = 0;
  mediaBrowserPageAnchorValid = false;
  mediaBrowserPageFirst = MediaBrowserEntry{};
  mediaBrowserPageLast = MediaBrowserEntry{};
  mediaBrowserAnchorScratch = MediaBrowserEntry{};
  resetMediaMarquee();
}

bool syncTransferFilesystemDirectly()
{
  if (!wifiTransferWriteAccessActive ||
      mediaFs.accessMode() != MediaFsAccessMode::TransferReadWrite) {
    return false;
  }

  // This path is used only after the transfer task has stopped unexpectedly.
  // Never turn that recovery into another permanent loopTask stall if an LCD
  // flush or abandoned peripheral operation still owns the shared SPI mutex.
  if (!mediaSharedSpiTryLock(500U)) {
    Serial.println(
        "WIFI XFER: direct filesystem sync deferred; shared SPI busy");
    return false;
  }
  const bool ok = mediaFs.syncTransferDevice();
  mediaSharedSpiUnlock();
  Serial.printf("WIFI XFER: direct filesystem sync result=%s\n",
                ok ? "OK" : "FAIL");
  return ok;
}

void refreshWifiTransferUi(bool force)
{
  const uint32_t now = millis();
  if (!force &&
      (uint32_t)(now - wifiTransferUiUpdatedAt) <
          WIFI_TRANSFER_UI_REFRESH_MS) {
    return;
  }
  wifiTransferUiUpdatedAt = now;
  wifiTransferMode.snapshot(wifiTransferSnapshot);

  if (wifiTransferSnapshot.message[0]) {
    setWifiTransferUiText(wifiTransferUiStatus,
                          sizeof(wifiTransferUiStatus),
                          wifiTransferSnapshot.message);
  }
  if (!wifiTransferUiSsid[0]) {
    wifiTransferMode.copyCredentials(
        wifiTransferUiSsid, sizeof(wifiTransferUiSsid),
        wifiTransferUiPassword, sizeof(wifiTransferUiPassword),
        wifiTransferUiIp, sizeof(wifiTransferUiIp));
  }

  if (wifiTransferSnapshot.writerActive) {
    const uint64_t bytesPerSecond = wifiTransferSnapshot.elapsedMs
        ? (wifiTransferSnapshot.writtenBytes * 1000ULL) /
              wifiTransferSnapshot.elapsedMs
        : 0ULL;
    if (wifiTransferSnapshot.declaredBytes) {
      snprintf(
          wifiTransferUiProgress, sizeof(wifiTransferUiProgress),
          "%llu/%llu KiB  %llu KiB/s",
          static_cast<unsigned long long>(
              wifiTransferSnapshot.writtenBytes / 1024ULL),
          static_cast<unsigned long long>(
              wifiTransferSnapshot.declaredBytes / 1024ULL),
          static_cast<unsigned long long>(bytesPerSecond / 1024ULL));
    } else {
      snprintf(
          wifiTransferUiProgress, sizeof(wifiTransferUiProgress),
          "%llu KiB written  %llu KiB/s",
          static_cast<unsigned long long>(
              wifiTransferSnapshot.writtenBytes / 1024ULL),
          static_cast<unsigned long long>(bytesPerSecond / 1024ULL));
    }
  } else if (wifiTransferSnapshot.freeBytes) {
    snprintf(
        wifiTransferUiProgress, sizeof(wifiTransferUiProgress),
        "%llu MiB free",
        static_cast<unsigned long long>(
            wifiTransferSnapshot.freeBytes / (1024ULL * 1024ULL)));
  } else {
    wifiTransferUiProgress[0] = '\0';
  }

  if (uiView == VIEW_WIFI_TRANSFER_ACTIVE) drawWifiTransferScreen();
}

void finishWifiTransferLifecycle()
{
  const bool failed = wifiTransferExitWasRecovery ||
                      !wifiTransferLastSyncOk ||
                      !wifiTransferNormalAccessRestoreOk ||
                      !wifiTransferBleRestartOk;
  wifiTransferMode.discardPreparedState();
  invalidateMediaBrowserAfterTransfer();
  clearStoppedMediaForTransfer();
  clearWifiTransferCredentials();
  wifiTransferUiProgress[0] = '\0';

  Serial.printf(
      "WIFI XFER: exit complete result=%s reason=%s heap=%lu psram=%lu "
      "loop_stack_min=%lu\n",
      failed ? "FAIL" : "OK",
      wifiTransferExitReason[0] ? wifiTransferExitReason : "completed",
      static_cast<unsigned long>(ESP.getFreeHeap()),
      static_cast<unsigned long>(ESP.getFreePsram()),
      static_cast<unsigned long>(
          uxTaskGetStackHighWaterMark(nullptr)));

  wifiTransferPhase = WifiTransferPhase::Normal;
  wifiTransferPhaseStartedAt = millis();
  wifiTransferPhaseActionIssued = false;
  wifiTransferRetryAt = 0;
  wifiTransferRetryCount = 0;

  if (failed) {
    if (!wifiTransferUiError[0]) {
      setWifiTransferUiText(wifiTransferUiError,
                            sizeof(wifiTransferUiError),
                            "Transfer recovery did not fully complete");
    }
    drawWifiTransferError();
    return;
  }

  showToast("Transfer complete", 1800);
  enterPage(PAGE_MEDIA);
}

void serviceWifiTransferUiRedraw()
{
  if (!wifiTransferUiRedrawPending ||
      uiView != VIEW_WIFI_TRANSFER_ACTIVE) {
    return;
  }
  const uint32_t now = millis();
  if (wifiTransferUiRedrawRetryAt &&
      (long)(now - wifiTransferUiRedrawRetryAt) < 0) {
    return;
  }
  const bool criticalSdTransition =
      wifiTransferPhase == WifiTransferPhase::ReleaseNormalAccess ||
      wifiTransferPhase == WifiTransferPhase::ConfirmWriteAccess ||
      wifiTransferPhase == WifiTransferPhase::RestoreNormalAccess ||
      wifiTransferPhase == WifiTransferPhase::ValidateNormalAccess;
  if (criticalSdTransition) {
    wifiTransferUiRedrawRetryAt = now + 40U;
    return;
  }
  if (flushCanvasTryLocked(20U)) {
    wifiTransferUiRedrawPending = false;
    wifiTransferUiRedrawRetryAt = 0;
  } else {
    wifiTransferUiRedrawRetryAt = now + 40U;
  }
}

bool prepareStorageForControlledRestart(const char *reason)
{
  const bool prepared = mediaPlayerPoc.prepareCardForControllerRestart(1000U);
  Serial.printf("WIFI XFER: restart storage preparation reason=%s result=%s\n",
                reason ? reason : "unspecified",
                prepared ? "OK" : "DEFERRED");
  return prepared;
}

void serviceWifiTransfer()
{
  if (wifiTransferPhase == WifiTransferPhase::Normal) return;

  serviceWifiTransferUiRedraw();
  const uint32_t now = millis();
  switch (wifiTransferPhase) {
    case WifiTransferPhase::StopMedia: {
      if (!wifiTransferPhaseActionIssued) {
        wifiTransferPhaseActionIssued = true;
        cancelMediaTrackTransition();
        cancelMediaArtworkRequest(true);
        mediaPlayerPoc.requestStop();
        Serial.println("WIFI XFER: media shutdown requested");
      }

      const bool cleanupComplete = mediaPlayerPoc.serviceStopCleanup();
      if (cleanupComplete &&
          mediaPlayerPoc.playbackState() == MediaPlaybackState::Stopped &&
          !mediaPlayerPoc.seeking() && !mediaTrackTransitionActive()) {
        clearStoppedMediaForTransfer();
        Serial.println("WIFI XFER: playback/decoder/I2S shutdown complete");
        setWifiTransferPhase(WifiTransferPhase::WaitArtwork,
                             "Waiting for artwork worker");
        break;
      }

      if (wifiTransferPhaseTimedOut(
              WIFI_TRANSFER_MEDIA_STOP_TIMEOUT_MS) &&
          !wifiTransferExitWasRecovery) {
        markWifiTransferFailure("Playback worker did not stop in time");
        // Keep waiting.  A timeout never authorizes an unsafe SD unmount.
      }
      break;
    }

    case WifiTransferPhase::WaitArtwork: {
      serviceMediaArtwork();
      const bool workerBusy = __atomic_load_n(
          &mediaArtworkWorkerBusy, __ATOMIC_ACQUIRE);
      const bool quiet = !workerBusy && !mediaArtworkRequestPending &&
                         !mediaArtworkJobSubmitted;
      if (quiet) {
        if (!wifiTransferArtworkQuietSince) {
          wifiTransferArtworkQuietSince = now;
        } else if ((uint32_t)(now - wifiTransferArtworkQuietSince) >=
                   WIFI_TRANSFER_ARTWORK_QUIET_MS) {
          serviceMediaArtwork();
          Serial.println("WIFI XFER: artwork worker quiescent");
          setWifiTransferPhase(WifiTransferPhase::RestoreRoute,
                               "Restoring DSPi route");
        }
      } else {
        wifiTransferArtworkQuietSince = 0;
      }

      if (wifiTransferPhaseTimedOut(
              WIFI_TRANSFER_ARTWORK_STOP_TIMEOUT_MS) &&
          !wifiTransferExitWasRecovery) {
        markWifiTransferFailure("Artwork worker did not stop in time");
        // Keep waiting for actual acknowledgement before touching the card.
      }
      break;
    }

    case WifiTransferPhase::RestoreRoute: {
      if (wifiTransferPhaseActionIssued) break;
      wifiTransferPhaseActionIssued = true;
      const bool restored = restoreDspiMediaRoute();
      if (!restored) {
        beginWifiTransferRecovery("DSPi route restoration failed");
      } else if (wifiTransferExitWasRecovery) {
        requestWifiTransferSafeExit("entry rollback after media shutdown");
      } else {
        setWifiTransferPhase(WifiTransferPhase::FlushPreferences,
                             "Saving pending settings");
      }
      break;
    }

    case WifiTransferPhase::FlushPreferences: {
      if (!wifiTransferPhaseActionIssued) {
        wifiTransferPhaseActionIssued = true;
        lastUserActivityAt = millis() - 2000U;
        portENTER_CRITICAL(&deferredPreferenceMux);
        deferredPreferenceNotBefore = millis();
        portEXIT_CRITICAL(&deferredPreferenceMux);
      }
      serviceDeferredPreferences();
      if (!pendingDeferredPreferenceFlags()) {
        Serial.println("WIFI XFER: pending preference writes complete");
        setWifiTransferPhase(WifiTransferPhase::ReleaseNormalAccess,
                             "Preparing SD for transfer");
      } else if (wifiTransferPhaseTimedOut(
                     WIFI_TRANSFER_PREFERENCES_TIMEOUT_MS)) {
        beginWifiTransferRecovery("Pending settings could not be saved");
      }
      break;
    }

    case WifiTransferPhase::ReleaseNormalAccess: {
      if (wifiTransferRetryAt && (long)(now - wifiTransferRetryAt) < 0) {
        break;
      }
      wifiTransferPhaseActionIssued = true;

      // SdFat's mount is already capable of reads and writes; NormalReadOnly
      // is the wrapper's ownership policy.  Close the browser handles and hand
      // the same mounted object to transfer mode instead of restarting the
      // shared LCD/SD SPI peripheral.  Hardware logs showed the old
      // end/begin sequence could freeze immediately after browsing an album.
      bool released = true;
      if (mediaPlayerPoc.mounted()) {
        released = mediaPlayerPoc.switchMountedCardAccessMode(
            MediaFsAccessMode::TransferReadWrite, 200U);
      }
      if (!released) {
        wifiTransferPhaseActionIssued = false;
        wifiTransferRetryCount++;
        wifiTransferRetryAt = now + WIFI_TRANSFER_SD_RELEASE_RETRY_MS;
        setWifiTransferUiText(
            wifiTransferUiStatus, sizeof(wifiTransferUiStatus),
            "Waiting for normal SD browser to release");
        refreshWifiTransferUi(false);
        if (wifiTransferPhaseTimedOut(
                WIFI_TRANSFER_SD_RELEASE_TIMEOUT_MS)) {
          beginWifiTransferRecovery("Normal SD access did not release");
        }
        break;
      }

      wifiTransferNormalAccessReleased = true;
      mediaBrowserScanned = false;
      Serial.printf(
          "WIFI XFER: SD normal ownership released in-place retries=%u mode=%s\n",
          (unsigned)wifiTransferRetryCount,
          mediaPlayerPoc.mounted() ? "transfer-rw" : "unmounted");
      setWifiTransferPhase(WifiTransferPhase::ConfirmWriteAccess,
                           "Enabling SD writes");
      break;
    }

    case WifiTransferPhase::ConfirmWriteAccess: {
      if (wifiTransferRetryAt && (long)(now - wifiTransferRetryAt) < 0) {
        break;
      }
      wifiTransferPhaseActionIssued = true;
      if (!mediaPlayerPoc.mountCardForTransfer()) {
        wifiTransferPhaseActionIssued = false;
        wifiTransferRetryCount++;
        wifiTransferRetryAt = now + 500U;
        setWifiTransferUiText(
            wifiTransferUiStatus, sizeof(wifiTransferUiStatus),
            "Retrying SD write access");
        refreshWifiTransferUi(false);
        if (wifiTransferRetryCount >= 6U) {
          beginWifiTransferRecovery("SD transfer read/write access failed");
        }
        break;
      }
      wifiTransferWriteAccessActive = true;
      Serial.printf(
          "WIFI XFER: SD ready transfer-rw fs=%s capacity=%llu reused=%s\n",
          mediaFs.fileSystemName(),
          static_cast<unsigned long long>(mediaFs.cardSize()),
          wifiTransferNormalAccessReleased ? "yes" : "no");
      setWifiTransferPhase(WifiTransferPhase::ProbeReadWrite,
                           "Proving safe SD writes");
      break;
    }

    case WifiTransferPhase::ProbeReadWrite: {
      if (wifiTransferPhaseActionIssued) break;
      wifiTransferPhaseActionIssued = true;
      char errorText[96] = {0};
      if (!wifiTransferMode.preflightStorage(mediaFs, "/", errorText,
                                               sizeof(errorText))) {
        beginWifiTransferRecovery(
            errorText[0] ? errorText : "SD write preflight failed");
        break;
      }
      Serial.println("WIFI XFER: SD write preflight complete");
      setWifiTransferPhase(WifiTransferPhase::StopBle,
                           "Disconnecting BLE remote");
      break;
    }

    case WifiTransferPhase::StopBle: {
      if (!wifiTransferPhaseActionIssued) {
        wifiTransferPhaseActionIssued = true;
        wifiTransferBleShutdownStarted = true;
        beginBleTransferShutdown();
        Serial.println("WIFI XFER: BLE shutdown requested");
      }

      const int8_t result = serviceBleTransferShutdown();
      if (result > 0) {
        Serial.println("WIFI XFER: BLE stopped");
        if (wifiTransferExitWasRecovery) {
          requestWifiTransferSafeExit("entry rollback after BLE shutdown");
        } else {
          setWifiTransferPhase(WifiTransferPhase::StartNetwork,
                               "Starting private Wi-Fi");
        }
      } else if (result < 0) {
        beginWifiTransferRecovery("BLE shutdown failed");
      } else if (wifiTransferPhaseTimedOut(
                     WIFI_TRANSFER_BLE_STOP_TIMEOUT_MS) &&
                 !wifiTransferExitWasRecovery) {
        markWifiTransferFailure("BLE shutdown timed out");
        // Keep polling until ownership is actually released, then roll back.
      }
      break;
    }

    case WifiTransferPhase::StartNetwork: {
      if (!wifiTransferPhaseActionIssued) {
        wifiTransferPhaseActionIssued = true;
        if (!wifiTransferMode.start(mediaFs, "/")) {
          beginWifiTransferRecovery("Wi-Fi transfer task failed to start");
          break;
        }
        wifiTransferNetworkStarted = true;
      }

      wifiTransferMode.snapshot(wifiTransferSnapshot);
      if (wifiTransferSnapshot.state ==
          WifiTransferServiceState::Serving) {
        if (!wifiTransferMode.copyCredentials(
                wifiTransferUiSsid, sizeof(wifiTransferUiSsid),
                wifiTransferUiPassword, sizeof(wifiTransferUiPassword),
                wifiTransferUiIp, sizeof(wifiTransferUiIp))) {
          break;
        }
        Serial.println("WIFI XFER: private AP and browser service ready");
        setWifiTransferPhase(WifiTransferPhase::Active,
                             "Ready for browser connection");
        refreshWifiTransferUi(true);
      } else if (wifiTransferSnapshot.state ==
                 WifiTransferServiceState::Error) {
        beginWifiTransferRecovery(
            wifiTransferSnapshot.message[0]
                ? wifiTransferSnapshot.message
                : "Wi-Fi transfer service failed");
      } else if (wifiTransferSnapshot.state ==
                 WifiTransferServiceState::Stopped) {
        beginWifiTransferRecovery("Wi-Fi transfer task stopped unexpectedly");
      } else if (wifiTransferPhaseTimedOut(
                     WIFI_TRANSFER_NETWORK_START_TIMEOUT_MS)) {
        beginWifiTransferRecovery("Wi-Fi startup timed out");
      }
      break;
    }

    case WifiTransferPhase::Active: {
      wifiTransferMode.snapshot(wifiTransferSnapshot);
      if (wifiTransferSnapshot.finishRequested) {
        requestWifiTransferSafeExit(
            wifiTransferSnapshot.autoExitRequested
                ? "browser idle timeout" : "browser Finish Safely");
        break;
      }
      if (wifiTransferSnapshot.state == WifiTransferServiceState::Error) {
        beginWifiTransferRecovery(
            wifiTransferSnapshot.message[0]
                ? wifiTransferSnapshot.message
                : "Wi-Fi transfer service error");
        break;
      }
      if (wifiTransferSnapshot.state == WifiTransferServiceState::Stopped ||
          wifiTransferSnapshot.networkStopped) {
        beginWifiTransferRecovery("Wi-Fi stopped unexpectedly");
        break;
      }
      refreshWifiTransferUi(false);
      break;
    }

    case WifiTransferPhase::StopAcceptance: {
      if (!wifiTransferPhaseActionIssued) {
        wifiTransferPhaseActionIssued = true;
        if (wifiTransferNetworkStarted) {
          wifiTransferMode.requestQuiesce();
          if (wifiTransferExitWasRecovery) {
            wifiTransferMode.requestAbortWriter();
          }
        }
      }
      setWifiTransferPhase(WifiTransferPhase::WaitForQuiescent,
                           "Waiting for active request");
      break;
    }

    case WifiTransferPhase::WaitForQuiescent: {
      if (!wifiTransferNetworkStarted) {
        setWifiTransferPhase(WifiTransferPhase::SyncTransfer,
                             "Syncing transfer filesystem");
        break;
      }

      wifiTransferMode.snapshot(wifiTransferSnapshot);
      if (wifiTransferSnapshot.accepting) {
        // A startup timeout may have requested quiescence before SoftAP had
        // finished; repeat it after the service publishes Serving.
        wifiTransferMode.requestQuiesce();
      }
      if (wifiTransferExitWasRecovery &&
          wifiTransferSnapshot.writerActive &&
          (!wifiTransferRetryAt || (long)(now - wifiTransferRetryAt) >= 0)) {
        wifiTransferMode.requestAbortWriter();
        wifiTransferRetryAt = now + 750U;
      }

      if (wifiTransferSnapshot.networkStopped) {
        setWifiTransferPhase(WifiTransferPhase::SyncTransfer,
                             "Syncing transfer filesystem");
        break;
      }
      if (wifiTransferSnapshot.state ==
          WifiTransferServiceState::Starting) {
        if (wifiTransferPhaseTimedOut(
                WIFI_TRANSFER_NETWORK_START_TIMEOUT_MS) &&
            !wifiTransferExitWasRecovery) {
          markWifiTransferFailure("Wi-Fi task did not finish startup");
          wifiTransferPhaseStartedAt = now;
        }
        break;
      }
      if (wifiTransferSnapshot.quiescent) {
        Serial.println("WIFI XFER: HTTP service quiescent");
        setWifiTransferPhase(WifiTransferPhase::SyncTransfer,
                             "Syncing transfer filesystem");
        break;
      }

      if (wifiTransferPhaseTimedOut(
              WIFI_TRANSFER_QUIESCE_TIMEOUT_MS)) {
        if (!wifiTransferExitWasRecovery) {
          markWifiTransferFailure("Active upload did not quiesce in time");
        }
        wifiTransferMode.requestAbortWriter();
        wifiTransferPhaseStartedAt = now;
        setWifiTransferUiText(
            wifiTransferUiStatus, sizeof(wifiTransferUiStatus),
            "Waiting for writer to close safely");
        refreshWifiTransferUi(true);
        // Deliberately remain here. Never unmount beneath a request/writer.
      }
      break;
    }

    case WifiTransferPhase::SyncTransfer: {
      if (!wifiTransferWriteAccessActive) {
        wifiTransferMode.discardPreparedState();
        setWifiTransferPhase(WifiTransferPhase::RestoreNormalAccess,
                             "Restoring normal SD access");
        break;
      }

      wifiTransferMode.snapshot(wifiTransferSnapshot);
      const bool taskOwnsController =
          wifiTransferNetworkStarted &&
          !wifiTransferSnapshot.networkStopped;
      if (taskOwnsController) {
        if (!wifiTransferFilesystemSyncRequested) {
          if (wifiTransferMode.requestFilesystemSync()) {
            wifiTransferFilesystemSyncRequested = true;
            wifiTransferPhaseStartedAt = now;
          }
          break;
        }
        wifiTransferMode.snapshot(wifiTransferSnapshot);
        if (wifiTransferSnapshot.filesystemSyncComplete) {
          wifiTransferLastSyncOk =
              wifiTransferSnapshot.filesystemSyncOk;
          if (!wifiTransferLastSyncOk) {
            markWifiTransferFailure("Transfer filesystem sync failed");
          }
          setWifiTransferPhase(WifiTransferPhase::RestoreNormalAccess,
                               "Restoring normal SD access");
        } else if (wifiTransferPhaseTimedOut(
                       WIFI_TRANSFER_SYNC_TIMEOUT_MS)) {
          markWifiTransferFailure("Filesystem sync is still pending");
          wifiTransferPhaseStartedAt = now;
          // Keep waiting. The transfer task remains the filesystem owner.
        }
        break;
      }

      if (!wifiTransferPhaseActionIssued) {
        wifiTransferPhaseActionIssued = true;
        wifiTransferLastSyncOk = syncTransferFilesystemDirectly();
        if (!wifiTransferLastSyncOk) {
          markWifiTransferFailure("Transfer filesystem sync failed");
        }
        wifiTransferMode.discardPreparedState();
        setWifiTransferPhase(WifiTransferPhase::RestoreNormalAccess,
                             "Restoring normal SD access");
      }
      break;
    }

    case WifiTransferPhase::RestoreNormalAccess: {
      // Refresh the snapshot at the ownership boundary.  Reusing the snapshot
      // captured by a previous phase could falsely report an old writer or
      // request state and send the lifecycle back to WaitForQuiescent forever.
      wifiTransferMode.snapshot(wifiTransferSnapshot);
      if (!wifiTransferMode.quiescent() ||
          wifiTransferSnapshot.writerActive ||
          wifiTransferSnapshot.handlingRequest) {
        markWifiTransferFailure("Writer became active during safe exit");
        setWifiTransferPhase(WifiTransferPhase::WaitForQuiescent,
                             "Waiting for writer to close safely");
        break;
      }
      if (wifiTransferRetryAt && (long)(now - wifiTransferRetryAt) < 0) {
        break;
      }

      // Return the same SdFat instance to the read-only browser policy before
      // stopping Wi-Fi.  The HTTP listener is already closed and the writer is
      // quiescent, so no network callback can regain write ownership.
      bool released = true;
      if (mediaPlayerPoc.mounted()) {
        released = mediaPlayerPoc.switchMountedCardAccessMode(
            MediaFsAccessMode::NormalReadOnly, 200U);
      }
      if (!released) {
        wifiTransferRetryCount++;
        wifiTransferRetryAt = now + 500U;
        if (!wifiTransferPhaseTimedOut(
                WIFI_TRANSFER_SD_RELEASE_TIMEOUT_MS)) {
          setWifiTransferUiText(
              wifiTransferUiStatus, sizeof(wifiTransferUiStatus),
              "Returning SD to normal access");
          refreshWifiTransferUi(false);
          break;
        }

        // The in-place hand-back failed after a bounded wait.  The writer is
        // closed and the card is synced, so a physical unmount is a safe
        // fallback and recreates the old, proven ownership boundary without
        // ever unmounting under an HTTP callback.
        if (!wifiTransferExitWasRecovery) {
          markWifiTransferFailure(
              "Normal SD ownership switch timed out; using safe remount");
        }
        if (mediaPlayerPoc.unmountCard(200U)) {
          wifiTransferWriteAccessActive = false;
          wifiTransferNormalAccessReleased = true;
          wifiTransferNormalAccessRestoreOk = false;
          Serial.printf(
              "WIFI XFER: SD transfer ownership physically released retries=%u\n",
              (unsigned)wifiTransferRetryCount);
          setWifiTransferPhase(WifiTransferPhase::StopNetwork,
                               "Stopping HTTP and Wi-Fi");
          break;
        }

        setWifiTransferUiText(
            wifiTransferUiStatus, sizeof(wifiTransferUiStatus),
            "Waiting for safe SD release");
        refreshWifiTransferUi(false);
        if (wifiTransferPhaseTimedOut(
                WIFI_TRANSFER_SD_RECOVERY_RESTART_MS)) {
          // File data and filesystem metadata were already synced and there is
          // no active writer/request.  Restarting is safer than leaving the
          // device permanently wedged in transfer ownership and avoids a user
          // power pull.  Normal boot re-establishes read-only browser policy.
          Serial.println(
              "WIFI XFER: SD release timeout; controlled restart after sync");
          setWifiTransferUiText(
              wifiTransferUiStatus, sizeof(wifiTransferUiStatus),
              "SD busy; restarting safely");
          refreshWifiTransferUi(true);
          prepareStorageForControlledRestart("sd-release-timeout");
          delay(150);
          ESP.restart();
        }
      } else {
        wifiTransferWriteAccessActive = false;
        wifiTransferNormalAccessReleased = !mediaPlayerPoc.mounted();
        wifiTransferNormalAccessRestoreOk = mediaPlayerPoc.mounted();
        Serial.printf(
            "WIFI XFER: SD transfer ownership released normal_ro=%s\n",
            mediaPlayerPoc.mounted() ? "yes" : "no");
        setWifiTransferPhase(WifiTransferPhase::StopNetwork,
                             "Stopping HTTP and Wi-Fi");
      }
      break;
    }

    case WifiTransferPhase::StopNetwork: {
      if (!wifiTransferNetworkStarted) {
        wifiTransferMode.discardPreparedState();
        clearWifiTransferCredentials();
        setWifiTransferPhase(WifiTransferPhase::ValidateNormalAccess,
                             "Checking normal SD access");
        break;
      }

      wifiTransferMode.snapshot(wifiTransferSnapshot);
      if (wifiTransferSnapshot.networkStopped ||
          wifiTransferMode.networkStopped()) {
        wifiTransferMode.discardPreparedState();
        wifiTransferNetworkStarted = false;
        clearWifiTransferCredentials();
        Serial.println("WIFI XFER: HTTP, SoftAP and Wi-Fi stopped");
        setWifiTransferPhase(WifiTransferPhase::ValidateNormalAccess,
                             "Checking normal SD access");
        break;
      }

      if (!wifiTransferNetworkStopRequested &&
          wifiTransferMode.stopNetworkAfterStorageRelease()) {
        wifiTransferNetworkStopRequested = true;
        // Start the radio-shutdown allowance when the task accepts the
        // request.  If acceptance itself wedges, the phase timer still gives
        // us a bounded storage-safe recovery path below.
        wifiTransferPhaseStartedAt = now;
      }
      if (wifiTransferPhaseTimedOut(
              WIFI_TRANSFER_NETWORK_STOP_TIMEOUT_MS)) {
        // At this point the writer is closed, the filesystem is synced, and
        // the card has already returned to normal read-only ownership.  A
        // controlled software restart is therefore a safe last-resort escape
        // from a wedged Arduino Wi-Fi teardown and avoids a manual power pull.
        Serial.println(
            "WIFI XFER: Wi-Fi shutdown timeout; controlled restart to normal mode");
        setWifiTransferUiText(
            wifiTransferUiStatus, sizeof(wifiTransferUiStatus),
            "Wi-Fi stuck; restarting safely");
        refreshWifiTransferUi(true);
        prepareStorageForControlledRestart("network-stop-timeout");
        delay(150);
        ESP.restart();
      }
      break;
    }

    case WifiTransferPhase::ValidateNormalAccess: {
      if (mediaPlayerPoc.mounted() &&
          mediaPlayerPoc.cardAccessMode() ==
              MediaFsAccessMode::NormalReadOnly) {
        wifiTransferNormalAccessReleased = false;
        wifiTransferNormalAccessRestoreOk = true;
        Serial.println("WIFI XFER: SD already ready normal read-only");
        setWifiTransferPhase(WifiTransferPhase::RestartBle,
                             "Preparing safe BLE restart");
        break;
      }
      if (!wifiTransferNormalAccessReleased) {
        setWifiTransferPhase(WifiTransferPhase::RestartBle,
                             "Preparing safe BLE restart");
        break;
      }
      if (wifiTransferRetryAt && (long)(now - wifiTransferRetryAt) < 0) {
        break;
      }

      if (mediaPlayerPoc.mountCard()) {
        wifiTransferNormalAccessReleased = false;
        wifiTransferNormalAccessRestoreOk = true;
        Serial.println("WIFI XFER: SD remounted normal read-only");
        setWifiTransferPhase(WifiTransferPhase::RestartBle,
                             "Preparing safe BLE restart");
      } else if (++wifiTransferRetryCount < 2U) {
        wifiTransferRetryAt = now + 1000U;
        setWifiTransferUiText(
            wifiTransferUiStatus, sizeof(wifiTransferUiStatus),
            "Retrying normal SD mount");
        drawWifiTransferScreen();
      } else {
        wifiTransferNormalAccessRestoreOk = false;
        markWifiTransferFailure("SD read-only remount failed");
        setWifiTransferPhase(WifiTransferPhase::RestartBle,
                             "Preparing safe BLE restart");
      }
      break;
    }

    case WifiTransferPhase::RestartBle: {
      if (!wifiTransferBleShutdownStarted) {
        setWifiTransferPhase(WifiTransferPhase::Complete,
                             "Transfer cleanup complete");
        break;
      }

      // A CPU-only ESP.restart() does not power-cycle the still-powered SD
      // card. Hardware testing showed that the card can remain in a state
      // where the next boot times out during ACMD41 even after SPI cleanup.
      // Preserve the proven v13.2 normal read-only remount and return to the
      // media browser immediately. The local encoder remains usable. A real
      // ten-second power cycle is required only to restore the bonded BLE HID
      // remote; do not trade working storage for an unreliable warm restart.
      if (!wifiTransferPhaseActionIssued) {
        wifiTransferPhaseActionIssued = true;
        wifiTransferBleRestartOk = true;
        Serial.println(
            "WIFI XFER: SD ready; showing eight-second power-off notice for BLE");
        drawWifiTransferPowerOffNotice();
        wifiTransferRetryAt = now + 8000U;
        break;
      }

      if ((long)(now - wifiTransferRetryAt) < 0) break;
      setWifiTransferPhase(WifiTransferPhase::Complete,
                           "Transfer complete - power cycle for BLE");
      break;
    }

    case WifiTransferPhase::Complete:
      finishWifiTransferLifecycle();
      break;

    case WifiTransferPhase::RecoveryError:
      // RecoveryError is a fail-safe holding state. Re-enter the normal cleanup
      // sequence; its later phases refuse to release ownership out of order.
      markWifiTransferFailure("Transfer entered recovery hold");
      setWifiTransferPhase(WifiTransferPhase::StopAcceptance,
                           "Recovering transfer ownership");
      break;

    case WifiTransferPhase::Normal:
    default:
      break;
  }
}


